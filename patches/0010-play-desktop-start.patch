diff --git a/lib/play_desktop_start.dart b/lib/play_desktop_start.dart
new file mode 100644
index 0000000000000000000000000000000000000000..f7085d8a754e30f9b0b6a3def742afeeb101b4fd
--- /dev/null
+++ b/lib/play_desktop_start.dart
@@ -0,0 +1,208 @@
+part of 'main.dart';
+
+class PlayDesktopStart {
+  static const enabled =
+      String.fromEnvironment('DISTRIBUTION_CHANNEL') == 'play';
+  static const _timeout = Duration(seconds: 11);
+  static bool _busy = false;
+
+  static MethodChannel get _channel => BackstageShellBridge.channel;
+
+  static Future<void> startPlayer(String presentation) async {
+    final started = await _channel.invokeMethod<bool>('startPlayDesktop', {
+      'presentation': presentation,
+    });
+    if (started != true) {
+      throw PlatformException(
+        code: 'start_failed',
+        message: 'The desktop could not start.',
+      );
+    }
+  }
+
+  static Future<void> run(
+    BuildContext context,
+    Future<void> Function() start,
+  ) async {
+    if (_busy) return;
+    _busy = true;
+    try {
+      final navigator = Navigator.of(context, rootNavigator: true);
+      final progress = DialogRoute<void>(
+        context: context,
+        barrierDismissible: false,
+        builder: (_) => const PopScope(
+          canPop: false,
+          child: AlertDialog(
+            title: Text('Starting desktop…'),
+            content: LinearProgressIndicator(),
+          ),
+        ),
+      );
+      unawaited(navigator.push(progress));
+      Map<String, Object?> prerequisites;
+      try {
+        final status = await _channel
+            .invokeMapMethod<String, Object?>('desktopStartPrerequisite')
+            .timeout(const Duration(seconds: 3));
+        if (status == null) {
+          throw PlatformException(
+            code: 'start_status',
+            message: 'Desktop prerequisites could not be checked.',
+          );
+        }
+        prerequisites = status;
+        if (status['blocker'] == null) await start().timeout(_timeout);
+      } finally {
+        if (navigator.mounted && progress.isActive)
+          navigator.removeRoute(progress);
+      }
+      if (context.mounted) await _showPrerequisite(context, prerequisites);
+    } on PlatformException catch (error) {
+      if (context.mounted)
+        await _showMessage(
+          context,
+          error.message ?? 'The desktop could not start.',
+        );
+    } on TimeoutException {
+      if (context.mounted) {
+        await _showMessage(
+          context,
+          'The desktop did not finish starting within 10 seconds.',
+        );
+      }
+    } on Exception {
+      if (context.mounted)
+        await _showMessage(context, 'The desktop could not start. Try again.');
+    } finally {
+      _busy = false;
+    }
+  }
+
+  static Future<void> _showPrerequisite(
+    BuildContext context,
+    Map<String, Object?> status,
+  ) async {
+    switch (status['blocker']) {
+      case null:
+        return;
+      case 'MANAGER_MISSING':
+        if (await _confirm(
+              context,
+              'Desktop privilege manager missing',
+              'Install Stellar or Shizuku Plus to start the desktop.',
+              'Get a privilege manager',
+            ) &&
+            context.mounted) {
+          final manager = await showDialog<String>(
+            context: context,
+            builder: (dialog) => SimpleDialog(
+              title: const Text('Choose a privilege manager'),
+              children: [
+                SimpleDialogOption(
+                  onPressed: () => Navigator.pop(dialog, 'stellar'),
+                  child: const Text('Get Stellar'),
+                ),
+                SimpleDialogOption(
+                  onPressed: () => Navigator.pop(dialog, 'shizukuPlus'),
+                  child: const Text('Get Shizuku Plus'),
+                ),
+              ],
+            ),
+          );
+          if (manager != null) {
+            await _channel.invokeMethod<bool>('openDesktopManagerDownload', {
+              'manager': manager,
+            });
+          }
+        }
+      case 'MANAGER_STOPPED':
+        if (await _confirm(
+          context,
+          'Desktop privilege manager stopped',
+          'Start Stellar or Shizuku Plus, then return and tap Start.',
+          'Open privilege manager',
+        )) {
+          await _channel.invokeMethod<bool>('openDesktopManager');
+        }
+      case 'MANAGER_PERMISSION':
+        if (await _confirm(
+          context,
+          'Desktop privilege permission missing',
+          'Allow Backstage in Stellar or Shizuku Plus, then tap Start.',
+          'Request permission',
+        )) {
+          await NativeBridge().requestShizuku();
+        }
+      case 'ACCESSIBILITY_OFF':
+        final strings = AppLocalizations.of(context);
+        final preferences = await SharedPreferences.getInstance();
+        if (!context.mounted) return;
+        const consentKey = 'accessibility_disclosure_accepted_v1';
+        final accepted = preferences.getBool(consentKey) ?? false;
+        final hint = status['restrictedSettingsHint'] == true
+            ? '\n\nIf the switch is greyed out, open Backstage’s App info → ⋮ → Allow restricted settings, then return to Accessibility.'
+            : '';
+        const missing =
+            'The Backstage desktop accessibility service (MirrorService) is off.';
+        if (await _confirm(
+          context,
+          accepted
+              ? 'Desktop accessibility is off'
+              : strings.accessibilityDisclosureTitle,
+          '$missing${accepted ? '' : '\n\n${strings.accessibilityDisclosureBody}'}$hint',
+          accepted
+              ? strings.setupTutorialAccessibilityButton
+              : strings.accessibilityDisclosureAgree,
+        )) {
+          if (!accepted) await preferences.setBool(consentKey, true);
+          await _channel.invokeMethod<bool>('openDesktopAccessibility');
+        }
+      default:
+        throw PlatformException(
+          code: 'start_status',
+          message: 'Desktop prerequisites could not be checked.',
+        );
+    }
+  }
+
+  static Future<bool> _confirm(
+    BuildContext context,
+    String title,
+    String message,
+    String fix,
+  ) async =>
+      await showDialog<bool>(
+        context: context,
+        builder: (dialog) => AlertDialog(
+          title: Text(title),
+          content: SingleChildScrollView(child: Text(message)),
+          actions: [
+            TextButton(
+              onPressed: () => Navigator.pop(dialog, false),
+              child: const Text('Cancel'),
+            ),
+            FilledButton(
+              onPressed: () => Navigator.pop(dialog, true),
+              child: Text(fix),
+            ),
+          ],
+        ),
+      ) ??
+      false;
+
+  static Future<void> _showMessage(BuildContext context, String message) =>
+      showDialog<void>(
+        context: context,
+        builder: (dialog) => AlertDialog(
+          title: const Text('Desktop did not start'),
+          content: Text(message),
+          actions: [
+            TextButton(
+              onPressed: () => Navigator.pop(dialog),
+              child: const Text('OK'),
+            ),
+          ],
+        ),
+      );
+}
diff --git a/test/play_desktop_start_test.dart b/test/play_desktop_start_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..5bd410e89fbb398d6f0c35f816d4f112f00b9616
--- /dev/null
+++ b/test/play_desktop_start_test.dart
@@ -0,0 +1,129 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:free_dextop/l10n/app_localizations.dart';
+import 'package:free_dextop/main.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final messenger =
+      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+  final shell = BackstageShellBridge.channel;
+  late List<MethodCall> calls;
+  late String? blocker;
+  late Future<bool> Function() nativeStart;
+
+  setUp(() {
+    calls = [];
+    blocker = null;
+    nativeStart = () async => true;
+    SharedPreferences.setMockInitialValues({});
+    messenger.setMockMethodCallHandler(shell, (call) async {
+      calls.add(call);
+      return switch (call.method) {
+        'desktopStartPrerequisite' => {
+          'blocker': blocker,
+          'restrictedSettingsHint': true,
+        },
+        'startPlayDesktop' => await nativeStart(),
+        _ => true,
+      };
+    });
+  });
+
+  tearDown(() => messenger.setMockMethodCallHandler(shell, null));
+
+  Future<void> tapStart(WidgetTester tester) async {
+    await tester.pumpWidget(
+      MaterialApp(
+        localizationsDelegates: AppLocalizations.localizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        home: Scaffold(
+          body: Builder(
+            builder: (context) => TextButton(
+              child: const Text('Start'),
+              onPressed: () => PlayDesktopStart.run(
+                context,
+                () => PlayDesktopStart.startPlayer('in_app'),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+    await tester.tap(find.text('Start'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+  }
+
+  testWidgets('missing manager offers both downloads without launching', (
+    tester,
+  ) async {
+    blocker = 'MANAGER_MISSING';
+    await tapStart(tester);
+    expect(find.text('Desktop privilege manager missing'), findsOneWidget);
+    expect(calls.map((call) => call.method), ['desktopStartPrerequisite']);
+    await tester.tap(find.text('Get a privilege manager'));
+    await tester.pumpAndSettle();
+    expect(find.text('Get Shizuku Plus'), findsOneWidget);
+    await tester.tap(find.text('Get Stellar'));
+    await tester.pumpAndSettle();
+    expect(calls.last.method, 'openDesktopManagerDownload');
+    expect(calls.last.arguments, {'manager': 'stellar'});
+  });
+
+  testWidgets('accessibility setup records consent before opening settings', (
+    tester,
+  ) async {
+    blocker = 'ACCESSIBILITY_OFF';
+    await tapStart(tester);
+    await tester.pumpAndSettle();
+    expect(find.text('Accessibility service disclosure'), findsOneWidget);
+    expect(find.textContaining('Allow restricted settings'), findsOneWidget);
+    expect(calls.map((call) => call.method), ['desktopStartPrerequisite']);
+    await tester.tap(find.text('Agree and open settings'));
+    await tester.pumpAndSettle();
+    final preferences = await SharedPreferences.getInstance();
+    expect(preferences.getBool('accessibility_disclosure_accepted_v1'), isTrue);
+    expect(calls.last.method, 'openDesktopAccessibility');
+  });
+
+  testWidgets('native launch failure replaces progress with its message', (
+    tester,
+  ) async {
+    final pending = Completer<bool>();
+    nativeStart = () => pending.future;
+    await tapStart(tester);
+    expect(find.text('Starting desktop…'), findsOneWidget);
+    expect(calls.last.arguments, {'presentation': 'in_app'});
+    pending.completeError(
+      PlatformException(
+        code: 'start_failed',
+        message: 'Display creation failed',
+      ),
+    );
+    await tester.pumpAndSettle();
+    expect(find.text('Starting desktop…'), findsNothing);
+    expect(find.text('Display creation failed'), findsOneWidget);
+    await tester.tap(find.text('OK'));
+    await tester.pumpAndSettle();
+  });
+
+  testWidgets('a missing native launch reply produces a timeout message', (
+    tester,
+  ) async {
+    final pending = Completer<bool>();
+    nativeStart = () => pending.future;
+    await tapStart(tester);
+    await tester.pump(const Duration(seconds: 11));
+    await tester.pumpAndSettle();
+    expect(find.text('Desktop did not start'), findsOneWidget);
+    expect(find.textContaining('within 10 seconds'), findsOneWidget);
+    pending.complete(true);
+    await tester.tap(find.text('OK'));
+    await tester.pumpAndSettle();
+  });
+}

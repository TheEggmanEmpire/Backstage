From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Backstage <backstage@localhost>
Date: Sun, 22 Nov 2026 17:15:00 +0900
Subject: [PATCH] backstage-only-onboarding

Open Home for Backstage onboarding and migrate the desktop completion preference.

---
diff --git a/lib/app_shell.dart b/lib/app_shell.dart
--- a/lib/app_shell.dart
+++ b/lib/app_shell.dart
@@ -9,7 +9,7 @@
 
 class _DextopAppState extends State<DextopApp> {
   var themeMode = ThemeMode.system;
-  bool? setupCompleted;
+  bool startupPreferencesLoaded = false;
   bool? desktopWindow;
 
   /// Shown on an external display (DeX, Dextop's desktop): a window with a title bar
@@ -20,7 +20,7 @@
   void initState() {
     super.initState();
     loadThemeMode();
-    loadSetupState();
+    loadStartupPreferences();
     loadLaunchContext();
   }
 
@@ -36,10 +36,10 @@
     }
   }
 
-  Future<void> loadSetupState() async {
+  Future<void> loadStartupPreferences() async {
     final preferences = await SharedPreferences.getInstance();
-    final completed = preferences.getBool('setup_completed') ?? false;
-    if (!completed) {
+    final desktopSetupCompleted = preferences.getBool('setup_completed') ?? false;
+    if (!desktopSetupCompleted) {
       // Mark the current gesture guide as known as soon as a fresh 1.1.0+
       // installation starts. Updated installations already have setup marked
       // complete, so they remain eligible for the one-time migration guide.
@@ -48,9 +48,12 @@
         true,
       );
       await preferences.setString('last_launched_app_version', '1.1.0');
+      if (await BackstageShellBridge.invoke<bool>('onboardingDone') == true) {
+        await preferences.setBool('setup_completed', true);
+      }
     }
     if (mounted) {
-      setState(() => setupCompleted = completed);
+      setState(() => startupPreferencesLoaded = true);
     }
   }
 
@@ -94,12 +97,8 @@
         linuxMaterialUiLocalizations,
       ],
       supportedLocales: AppLocalizations.supportedLocales,
-      home: setupCompleted == null || desktopWindow == null
+      home: !startupPreferencesLoaded || desktopWindow == null
           ? const Scaffold(body: Center(child: CircularProgressIndicator()))
-          : setupCompleted == false
-          ? DextopSetupPage(
-              onCompleted: () => setState(() => setupCompleted = true),
-            )
           : HomeScreen(
               themeMode: themeMode,
               onThemeModeChanged: setThemeMode,
diff --git a/lib/main.dart b/lib/main.dart

diff --git a/test/backstage_shell_test.dart b/test/backstage_shell_test.dart
--- a/test/backstage_shell_test.dart
+++ b/test/backstage_shell_test.dart
@@ -2,6 +2,7 @@
 import 'package:flutter/services.dart';
 import 'package:flutter_test/flutter_test.dart';
 import 'package:free_dextop/main.dart';
+import 'package:free_dextop/setup_page.dart';
 import 'package:shared_preferences/shared_preferences.dart';
 
 // Backstage (patch 0005-backstage-shell): the Agent destination and the live desktop player on Home.
@@ -85,6 +86,8 @@
             'height': 1080,
           });
           return true;
+        case 'onboardingDone':
+          return shellState['onboardingDone'];
         case 'homeShown':
           return null;
         case 'playerAttach':
@@ -132,6 +135,31 @@
       tester.widget<NavigationBar>(find.byType(NavigationBar)).selectedIndex,
       3,
     );
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('fresh installs use Backstage setup from Home', (tester) async {
+    SharedPreferences.setMockInitialValues({});
+    shellState['onboardingDone'] = false;
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(find.byType(DextopSetupPage), findsNothing);
+    expect(find.text('Finish Backstage setup'), findsOneWidget);
+    final preferences = await SharedPreferences.getInstance();
+    expect(preferences.getBool('setup_completed'), isNot(true));
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('completed Backstage setup migrates the desktop preference', (
+    tester,
+  ) async {
+    SharedPreferences.setMockInitialValues({});
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(find.byType(DextopSetupPage), findsNothing);
+    expect(find.text('Finish Backstage setup'), findsNothing);
+    final preferences = await SharedPreferences.getInstance();
+    expect(preferences.getBool('setup_completed'), isTrue);
     await tester.pumpWidget(const SizedBox());
   });
 

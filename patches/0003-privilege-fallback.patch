@@ -0,0 +1,42 @@
+package moe.n4tsu.dextop.privilege
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class BackstagePrivilegeFallbackTest {
+    private fun decide(active: Boolean = true, included: Boolean = true, external: Boolean, paired: Boolean) =
+        BackstagePrivilegeFallback.useEmbedded(active, included, external) { paired }
+
+    @Test fun stellarDefaultsAreBackstageOnly() {
+        assertEquals("stellar", BackstagePrivilegeFallback.defaultKind(active = true))
+        assertEquals("shizuku", BackstagePrivilegeFallback.defaultKind(active = false))
+        assertTrue(BackstagePrivilegeFallback.providerPriority("stellar", true) <
+            BackstagePrivilegeFallback.providerPriority("shizuku", true))
+        assertTrue(BackstagePrivilegeFallback.providerPriority("shizuku", false) <
+            BackstagePrivilegeFallback.providerPriority("stellar", false))
+    }
+
+    @Test fun storedPairingServesWhileStellarOrShizukuIsUnusable() {
+        // After a reboot Stellar/Shizuku is stopped (or this app is not granted): the stored embedded pairing is the fallback.
+        assertTrue(decide(external = false, paired = true))
+    }
+
+    @Test fun usableExternalProviderAlwaysWins() {
+        assertFalse(decide(external = true, paired = true))
+    }
+
+    @Test fun nothingChangesWithoutAPairingOrInUpstreamBuilds() {
+        assertFalse(decide(external = false, paired = false))
+        assertFalse(decide(active = false, external = false, paired = true))
+        assertFalse(decide(included = false, external = false, paired = true))
+    }
+
+    @Test fun thePairingIsOnlyReadWhenItMatters() {
+        var reads = 0
+        BackstagePrivilegeFallback.useEmbedded(active = true, included = true, externalUsable = true) { reads++; true }
+        BackstagePrivilegeFallback.useEmbedded(active = false, included = true, externalUsable = false) { reads++; true }
+        assertTrue(reads == 0)
+    }
+}

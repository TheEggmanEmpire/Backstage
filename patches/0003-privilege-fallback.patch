+package moe.n4tsu.dextop.privilege
+
+import android.content.Context
+import android.content.pm.PackageManager
+import rikka.shizuku.Shizuku
+
+/**
+ * Backstage (patch 0003-privilege-fallback): Stellar first, then Shizuku, the embedded wireless-ADB runtime as the fallback.
+ *
+ * Upstream turns the embedded runtime off for good as soon as an external provider (Shizuku, Stellar) is selected
+ * (MainActivity.shouldUseEmbeddedRuntime, re-evaluated in every onCreate/onResume). After a reboot a non-root provider
+ * stays stopped until the user starts it again, so a background desktop start had no privilege at all although a
+ * stored pairing of the embedded runtime existed. With [active] (set by the Backstage glue), the embedded runtime is
+ * used while the external provider is not usable (binder dead, or this app not granted) and a pairing is stored;
+ * the external provider takes over again as soon as it is usable. Inert in upstream builds ([active] false).
+ */
+object BackstagePrivilegeFallback {
+    @Volatile @JvmStatic var active = false
+
+    /** Keep upstream defaults while inactive; saved choices are resolved before this default in MainActivity. */
+    fun defaultKind(active: Boolean = this.active): String = if (active) "stellar" else "shizuku"
+
+    fun providerPriority(kind: String, active: Boolean = this.active): Int =
+        if ((kind == "stellar") == active) 0 else 1
+
+    /** Pure decision (unit-tested). */
+    fun useEmbedded(active: Boolean, included: Boolean, externalUsable: Boolean, storedPairing: () -> Boolean): Boolean =
+        active && included && !externalUsable && storedPairing()
+
+    /** Stellar (Shizuku compatibility layer enabled), or Shizuku is running and this app holds its permission. */
+    fun externalUsable(): Boolean = runCatching {
+        Shizuku.pingBinder() && !Shizuku.isPreV11() && Shizuku.checkSelfPermission() == PackageManager.PERMISSION_GRANTED
+    }.getOrDefault(false)
+
+    /** Hook in MainActivity.shouldUseEmbeddedRuntime: true = use the embedded runtime although a provider is selected. */
+    fun useEmbedded(context: Context): Boolean = useEmbedded(
+        active,
+        DistributionPrivilegeBootstrap.included,
+        externalUsable = active && externalUsable(),
+    ) { runCatching { DistributionPrivilegeBootstrap.hasStoredPairing(context) }.getOrDefault(false) }
+}

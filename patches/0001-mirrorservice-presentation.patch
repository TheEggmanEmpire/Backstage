@@ -0,0 +1,239 @@
+package moe.n4tsu.dextop
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+import moe.n4tsu.dextop.BackstagePresentation.FULL
+import moe.n4tsu.dextop.BackstagePresentation.HIDDEN
+import moe.n4tsu.dextop.BackstagePresentation.IN_APP
+import moe.n4tsu.dextop.BackstagePresentation.MINI
+import moe.n4tsu.dextop.BackstagePresentationPolicy.MiniButtonAction.OpenChat
+import moe.n4tsu.dextop.BackstagePresentationPolicy.MiniButtonAction.Present
+import moe.n4tsu.dextop.BackstagePresentationPolicy.MiniButtonAction.Stop
+import moe.n4tsu.dextop.BackstagePresentationPolicy.Recovery
+import moe.n4tsu.dextop.BackstagePresentationPolicy.SetterTarget
+
+class BackstagePresentationPolicyTest {
+    @Test fun inAppIsHostlessAndShowsThePlayerOnlyWhenOneExists() {
+        assertTrue(BackstagePresentationPolicy.hostless(IN_APP))
+        assertTrue(BackstagePresentationPolicy.hostless(HIDDEN))
+        assertFalse(BackstagePresentationPolicy.hostless(MINI))
+        assertFalse(BackstagePresentationPolicy.hostless(FULL))
+        assertTrue(BackstagePresentationPolicy.bindsPlayer(IN_APP, playerAvailable = true))
+        // No player on screen (AI tab, settings, texture released): parked on the sink, still capturable.
+        assertFalse(BackstagePresentationPolicy.bindsPlayer(IN_APP, playerAvailable = false))
+        assertFalse(BackstagePresentationPolicy.bindsPlayer(HIDDEN, playerAvailable = true))
+        assertEquals(SetterTarget.NONE, BackstagePresentationPolicy.setterTarget(IN_APP))
+        // Nothing draws over the phone: allowed while locked; MINI/FULL wait for the unlock.
+        assertTrue(BackstagePresentationPolicy.allowedWhileLocked(IN_APP))
+        assertFalse(BackstagePresentationPolicy.allowedWhileLocked(MINI))
+        // The keyboard may show inside the in-app picture (only HIDDEN hides it).
+        assertEquals(null, BackstagePresentationPolicy.imePolicyOverride(IN_APP))
+        // A failed change out of or into IN_APP is recovered like HIDDEN.
+        assertEquals(Recovery.FINISH_HIDDEN, BackstagePresentationPolicy.recovery(MINI, IN_APP, IN_APP, miniLeftovers = true))
+        assertEquals(Recovery.PARK_HIDDEN, BackstagePresentationPolicy.recovery(IN_APP, MINI, MINI, miniLeftovers = true))
+        assertEquals(Recovery.NONE, BackstagePresentationPolicy.recovery(MINI, MINI, IN_APP, miniLeftovers = true))
+    }
+
+    @Test fun windowSettersNeverTouchTheMiniTile() {
+        // Keep-awake on the tile would keep the phone awake forever; the HUD would draw inside the tile.
+        assertEquals(SetterTarget.ROOT, BackstagePresentationPolicy.setterTarget(FULL))
+        assertEquals(SetterTarget.FULL_PARAMS, BackstagePresentationPolicy.setterTarget(MINI))
+        assertEquals(SetterTarget.NONE, BackstagePresentationPolicy.setterTarget(HIDDEN))
+    }
+
+    @Test fun failedChangesNeverLeaveAHalfAppliedState() {
+        // FULL -> MINI threw after the switch: the full-screen host with released phone control goes back to FULL.
+        assertEquals(Recovery.FORCE_FULL, BackstagePresentationPolicy.recovery(FULL, MINI, MINI, miniLeftovers = true))
+        // MINI -> FULL threw inside leaveMini, before or after the state switch.
+        assertEquals(Recovery.FORCE_FULL, BackstagePresentationPolicy.recovery(MINI, MINI, FULL, miniLeftovers = true))
+        assertEquals(Recovery.FORCE_FULL, BackstagePresentationPolicy.recovery(MINI, FULL, FULL, miniLeftovers = true))
+        // The display already moved to the sink: HIDDEN is finished, never a host showing a frozen frame.
+        assertEquals(Recovery.FINISH_HIDDEN, BackstagePresentationPolicy.recovery(FULL, HIDDEN, HIDDEN, miniLeftovers = false))
+        assertEquals(Recovery.FINISH_HIDDEN, BackstagePresentationPolicy.recovery(MINI, HIDDEN, HIDDEN, miniLeftovers = true))
+        // Coming back from HIDDEN failed after addWindow(): park the display again.
+        assertEquals(Recovery.PARK_HIDDEN, BackstagePresentationPolicy.recovery(HIDDEN, MINI, MINI, miniLeftovers = true))
+        assertEquals(Recovery.PARK_HIDDEN, BackstagePresentationPolicy.recovery(HIDDEN, FULL, FULL, miniLeftovers = false))
+        // The sink rebind itself is refused: nothing changed, the tile or FULL stays as it is.
+        assertEquals(Recovery.NONE, BackstagePresentationPolicy.recovery(MINI, MINI, HIDDEN, miniLeftovers = true))
+        assertEquals(Recovery.NONE, BackstagePresentationPolicy.recovery(FULL, FULL, HIDDEN, miniLeftovers = false))
+    }
+
+    @Test fun eachButtonOfTheMiniRowDoesItsJob() {
+        // The headphones button ("Play in background") sends the desktop to the background: HIDDEN keeps the display
+        // (and its apps) running on the sink.
+        assertEquals(Present(HIDDEN), BackstagePresentationPolicy.miniButtonAction(BackstageUi.ICON_BACKGROUND))
+        // Chat opens the app's chat panel and leaves the presentation alone.
+        assertEquals(OpenChat, BackstagePresentationPolicy.miniButtonAction(BackstageUi.ICON_CHAT))
+        // Open Backstage runs the app's handler (the app, the desktop in the background) and changes nothing here.
+        assertEquals(BackstagePresentationPolicy.MiniButtonAction.OpenApp, BackstagePresentationPolicy.miniButtonAction(BackstageUi.ICON_APP))
+        assertEquals(Present(FULL), BackstagePresentationPolicy.miniButtonAction(BackstageUi.ICON_EXPAND))
+        // Only close ends the session.
+        assertEquals(Stop, BackstagePresentationPolicy.miniButtonAction(BackstageUi.ICON_STOP))
+        assertEquals(5, setOf(BackstageUi.ICON_EXPAND, BackstageUi.ICON_STOP, BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_CHAT, BackstageUi.ICON_APP).size)
+        assertTrue(BackstageUi.BUTTON_DP >= 40, "touch target of the row buttons")
+        assertTrue(BackstageUi.BUTTON_DISC_DP <= BackstageUi.BUTTON_DP)
+        assertTrue(BackstageUi.BUTTON_GLYPH_DP < BackstageUi.BUTTON_DISC_DP)
+    }
+
+    @Test fun closeStopsOnTheFirstTap() {
+        // no arming step; the close button maps straight to Stop.
+        assertEquals(BackstagePresentationPolicy.MiniButtonAction.Stop, BackstagePresentationPolicy.miniButtonAction(BackstageUi.ICON_STOP))
+    }
+
+    @Test fun theRowShowsChatOnlyWithAChatPanel() {
+        assertEquals(
+            listOf(BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_CHAT, BackstageUi.ICON_EXPAND, BackstageUi.ICON_STOP),
+            BackstagePresentationPolicy.miniButtons(chatAvailable = true),
+        )
+        assertEquals(
+            listOf(BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_EXPAND, BackstageUi.ICON_STOP),
+            BackstagePresentationPolicy.miniButtons(chatAvailable = false),
+        )
+        val five = BackstagePresentationPolicy.miniButtons(chatAvailable = true, appAvailable = true)
+        assertEquals(
+            listOf(BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_CHAT, BackstageUi.ICON_APP, BackstageUi.ICON_EXPAND, BackstageUi.ICON_STOP),
+            five,
+        )
+    }
+
+    @Test fun smallTilesDropFullScreenThenChatThenTheAppNeverCloseOrHeadphones() {
+        val five = BackstagePresentationPolicy.miniButtons(chatAvailable = true, appAvailable = true)
+        val fit = BackstagePresentationPolicy::fitButtons
+        assertEquals(five, fit(five, 5))
+        assertEquals(listOf(BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_CHAT, BackstageUi.ICON_APP, BackstageUi.ICON_STOP), fit(five, 4))
+        assertEquals(listOf(BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_APP, BackstageUi.ICON_STOP), fit(five, 3))
+        assertEquals(listOf(BackstageUi.ICON_BACKGROUND, BackstageUi.ICON_STOP), fit(five, 2))
+        // One slot: close (it stops everything), never a lone headphones button.
+        assertEquals(listOf(BackstageUi.ICON_STOP), fit(five, 1))
+        assertEquals(listOf(BackstageUi.ICON_STOP), fit(five, 0))
+        // Without the optional buttons nothing else changes.
+        val three = BackstagePresentationPolicy.miniButtons(chatAvailable = false)
+        assertEquals(three - BackstageUi.ICON_EXPAND, fit(three, 2))
+    }
+
+    @Test fun resolutionChangesWhileMiniReapplyTheTile() {
+        assertTrue(BackstagePresentationPolicy.relayoutMini(MINI, 1920 to 1080, 2560, 1440))
+        assertFalse(BackstagePresentationPolicy.relayoutMini(MINI, 1920 to 1080, 1920, 1080))
+        assertFalse(BackstagePresentationPolicy.relayoutMini(FULL, 1920 to 1080, 2560, 1440))
+        assertFalse(BackstagePresentationPolicy.relayoutMini(MINI, null, 2560, 1440))
+    }
+
+    @Test fun aKeyguardWithoutScreenOffHidesTheTile() {
+        assertTrue(BackstagePresentationPolicy.hideForKeyguard(MINI, keyguardLocked = true))
+        assertFalse(BackstagePresentationPolicy.hideForKeyguard(MINI, keyguardLocked = false))
+        assertFalse(BackstagePresentationPolicy.hideForKeyguard(HIDDEN, keyguardLocked = true))
+    }
+
+    @Test fun onlyABackstageForcedDirectDisplayFallsBackToTheOverlay() {
+        assertTrue(BackstagePresentationPolicy.fallBackToOverlay(alreadyFailed = false, backstageForcedDirect = true, upstreamWantsDirect = false))
+        // Upstream chose the direct display itself (Plasma v2 / Dextop Book): keep upstream's failure path.
+        assertFalse(BackstagePresentationPolicy.fallBackToOverlay(alreadyFailed = false, backstageForcedDirect = true, upstreamWantsDirect = true))
+        // At most once per session; never when Backstage did not force it.
+        assertFalse(BackstagePresentationPolicy.fallBackToOverlay(alreadyFailed = true, backstageForcedDirect = true, upstreamWantsDirect = false))
+        assertFalse(BackstagePresentationPolicy.fallBackToOverlay(alreadyFailed = false, backstageForcedDirect = false, upstreamWantsDirect = false))
+    }
+
+    @Test fun aWakeInsideTheLockGracePeriodRestoresWithoutUserPresent() {
+        val (poll, one) = BackstagePresentationPolicy.unlockStep(locked = false, secureKeyguard = true, unlockedPolls = 0)
+        assertEquals(BackstagePresentationPolicy.UnlockStep.POLL, poll)
+        // Secure lock screen, but the keyguard never showed (woken within "lock after timeout"): two unlocked reads restore.
+        assertEquals(BackstagePresentationPolicy.UnlockStep.RESTORE,
+            BackstagePresentationPolicy.unlockStep(locked = false, secureKeyguard = true, unlockedPolls = one).first)
+        // A secure keyguard seen locked waits for a confirmed unlock (USER_PRESENT), never a poll.
+        assertEquals(BackstagePresentationPolicy.UnlockStep.AWAIT_USER_PRESENT,
+            BackstagePresentationPolicy.unlockStep(locked = true, secureKeyguard = true, unlockedPolls = 1).first)
+        // A swipe keyguard keeps polling and starts counting again.
+        assertEquals(BackstagePresentationPolicy.UnlockStep.POLL to 0,
+            BackstagePresentationPolicy.unlockStep(locked = true, secureKeyguard = false, unlockedPolls = 1))
+    }
+
+    @Test fun onlyAnAlwaysUnlockedDesktopInItsOwnGroupRunsWhileLocked() {
+        val flags = BackstageDisplayFlags
+        assertTrue(flags.runsWhileLocked(flags.OWN_FOCUS or flags.OWN_DISPLAY_GROUP or flags.ALWAYS_UNLOCKED or 0x40))
+        assertFalse(flags.runsWhileLocked(flags.OWN_FOCUS or 0x40))                   // default "focus" profile
+        assertFalse(flags.runsWhileLocked(flags.ALWAYS_UNLOCKED))                     // still sleeps with the phone
+        assertFalse(flags.runsWhileLocked(flags.OWN_DISPLAY_GROUP))                   // still keyguarded
+        assertFalse(flags.runsWhileLocked(0))
+    }
+
+    @Test fun onlyFlagsTheDisplayReallyCarriesCountForLockedMode() {
+        val f = BackstageDisplayFlags
+        val rich = f.OWN_FOCUS or f.OWN_DISPLAY_GROUP or f.ALWAYS_UNLOCKED
+        val applied = f.DISPLAY_TRUSTED or f.DISPLAY_OWN_DISPLAY_GROUP or f.DISPLAY_ALWAYS_UNLOCKED or f.DISPLAY_OWN_FOCUS
+        assertEquals(rich, f.effective(rich, applied))
+        assertTrue(f.runsWhileLocked(f.effective(rich, applied)))
+        // Accepted, but the display has no own group / no unlock (silently dropped): not a locked-mode desktop.
+        assertFalse(f.runsWhileLocked(f.effective(rich, applied and f.DISPLAY_ALWAYS_UNLOCKED.inv())))
+        assertFalse(f.runsWhileLocked(f.effective(rich, applied and f.DISPLAY_OWN_DISPLAY_GROUP.inv())))
+        // Never adds a flag the rung did not ask for.
+        assertEquals(f.OWN_FOCUS, f.effective(f.OWN_FOCUS, applied))
+        // Upstream bits of a rung are not Backstage flags.
+        assertEquals(f.OWN_DISPLAY_GROUP or f.ALWAYS_UNLOCKED, f.backstageBits(0x40 or 0x8 or f.OWN_DISPLAY_GROUP or f.ALWAYS_UNLOCKED))
+    }
+
+    @Test fun lockedModeFallbackNamesWhyTheDesktopSleepsWithThePhone() {
+        val f = BackstageDisplayFlags
+        val both = f.OWN_DISPLAY_GROUP or f.ALWAYS_UNLOCKED
+        assertEquals(null, f.lockedModeFallback(f.FOCUS, 35, direct = true, f.OWN_FOCUS, f.OWN_FOCUS, null))
+        assertEquals(null, f.lockedModeFallback(f.RICH, 35, direct = true, both, both, null))
+        assertTrue(f.lockedModeFallback(f.RICH, 32, direct = true, 0, 0, null)!!.contains("Android 13"))
+        assertTrue(f.lockedModeFallback(f.RICH, 35, direct = false, 0, 0, null)!!.contains("overlay"))
+        assertEquals("the platform refused an always-unlocked desktop: Requires ADD_ALWAYS_UNLOCKED_DISPLAY",
+            f.lockedModeFallback(f.RICH, 35, direct = true, f.OWN_FOCUS, f.OWN_FOCUS, "Requires ADD_ALWAYS_UNLOCKED_DISPLAY"))
+        assertTrue(f.lockedModeFallback(f.RICH, 35, direct = true, both, f.OWN_DISPLAY_GROUP, null)!!.contains("without"))
+    }
+
+    @Test fun thePhoneScreenIsTheDefaultDisplayStateNotInteractive() {
+        // Display.STATE_ON / STATE_VR / STATE_ON_SUSPEND are on; OFF, DOZE, DOZE_SUSPEND, UNKNOWN are off.
+        listOf(2, 5, 6).forEach { assertTrue(BackstagePresentationPolicy.phoneScreenOn(it)) }
+        listOf(0, 1, 3, 4).forEach { assertFalse(BackstagePresentationPolicy.phoneScreenOn(it)) }
+    }
+
+    @Test fun aBackgroundStartMovesBackOnlyThePhonesFrontTask() {
+        assertEquals(42, BackstagePresentationPolicy.migratedPhoneTask(42, listOf(7, 42)))
+        assertEquals(null, BackstagePresentationPolicy.migratedPhoneTask(42, listOf(7)))
+        assertEquals(null, BackstagePresentationPolicy.migratedPhoneTask(null, listOf(42)))
+    }
+
+    @Test fun aHiddenDesktopKeepsItsKeyboardHiddenAcrossUpstreamReconfiguration() {
+        // configureDisplay() (attach, live resize) resets the policy to LOCAL: HIDDEN re-imposes HIDE .
+        assertEquals(BackstagePresentationPolicy.IME_POLICY_HIDE, BackstagePresentationPolicy.imePolicyOverride(HIDDEN))
+        // MINI and FULL keep upstream's own value (LOCAL, or the phone for a headless Android Auto desktop).
+        assertEquals(null, BackstagePresentationPolicy.imePolicyOverride(MINI))
+        assertEquals(null, BackstagePresentationPolicy.imePolicyOverride(FULL))
+        assertEquals(2, BackstagePresentationPolicy.IME_POLICY_HIDE)  // WindowManager.DISPLAY_IME_POLICY_HIDE
+        assertEquals(0, BackstagePresentationPolicy.IME_POLICY_LOCAL) // WindowManager.DISPLAY_IME_POLICY_LOCAL
+    }
+
+    @Test fun onlyAQuietDesktopNeverTakesThePhonesFocus() {
+        val flags = BackstageDisplayFlags
+        assertEquals(flags.FOCUS_QUIET, flags.focusMode(flags.OWN_FOCUS or flags.STEAL_TOP_FOCUS_DISABLED or 0x40))
+        assertEquals(flags.FOCUS_OWN, flags.focusMode(flags.OWN_FOCUS or flags.OWN_DISPLAY_GROUP))
+        assertEquals(flags.FOCUS_SHARED, flags.focusMode(0x40))
+        // STEAL_TOP_FOCUS_DISABLED means nothing without OWN_FOCUS.
+        assertEquals(flags.FOCUS_SHARED, flags.focusMode(flags.STEAL_TOP_FOCUS_DISABLED))
+    }
+    @Test fun aMissingThrowingOrEmptyDevicePolicyKeepsTheOriginalLadder() {
+        val f = BackstageDisplayFlags
+        val bases = intArrayOf(1099, 11)
+        val extras = intArrayOf(f.OWN_FOCUS)
+        val original = intArrayOf(1099 or f.OWN_FOCUS, 1099, 11)
+        assertEquals(original.toList(), f.creationLadder(bases, extras, null).toList())
+        assertEquals(original.toList(), f.creationLadder(bases, extras) { _, _ -> error("unavailable") }.toList())
+        assertEquals(original.toList(), f.creationLadder(bases, extras) { _, _ -> intArrayOf() }.toList())
+        assertEquals(original.toList(), f.creationLadder(bases, extras) { _, _ -> IntArray(33) }.toList())
+        assertEquals(original.toList(), f.creationLadder(bases, extras) { b, _ -> b[0] = 0; error("mutated") }.toList())
+        assertEquals(listOf(11), f.creationLadder(bases, extras) { _, _ -> intArrayOf(11) }.toList())
+        assertEquals(emptyList<Int>(), f.creationLadder(intArrayOf(), extras, null).toList())
+    }
+
+    @Test fun silentlyDroppedFocusCannotBeReportedAsQuiet() {
+        val f = BackstageDisplayFlags
+        val requested = f.OWN_FOCUS or f.STEAL_TOP_FOCUS_DISABLED
+        assertEquals(f.FOCUS_SHARED, f.focusMode(f.effective(requested, f.DISPLAY_TRUSTED)))
+        assertEquals(f.FOCUS_OWN, f.focusMode(f.effective(requested, f.DISPLAY_TRUSTED or f.DISPLAY_OWN_FOCUS)))
+    }
+
+}

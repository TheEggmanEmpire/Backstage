+    /** H10: FULL <-> MINI <-> HIDDEN without recreating the display; tasks stay where they are. */
+    private fun backstageApplyPresentation(next: BackstagePresentation, reason: String): Boolean {
+        val current = backstagePresentation
+        if (next == current) return backstageSessionActive()
+        backstagePresentationBlocker()?.let { blocker ->
+            OperationLog.w(this, "Backstage", "presentation ${current.name} -> ${next.name} refused: $blocker reason=$reason", null)
+            return false
+        }
+        val applied = runCatching {
+            val hostless = BackstagePresentationPolicy.hostless(current)
+            when (next) {
+                BackstagePresentation.MINI -> if (hostless) backstageShowHostWindow(next) else backstageEnterMini()
+                BackstagePresentation.FULL -> if (hostless) backstageShowHostWindow(next) else backstageLeaveMini()
+                BackstagePresentation.HIDDEN, BackstagePresentation.IN_APP ->
+                    if (hostless) backstageSwitchHostless(next) else backstageEnterHidden(next)
+            }
+        }.onFailure {
+            OperationLog.e(this, "Backstage", "presentation ${current.name} -> ${next.name} failed reason=$reason", it)
+            Log.e(logTag, "Backstage presentation change failed", it)
+            backstageRecover(current, next)
+        }.getOrDefault(false)
+        if (applied) {
+            OperationLog.i(this, "Backstage", "presentation ${current.name} -> ${next.name} display=$targetDisplayId reason=$reason")
+        }
+        backstageNotifyListeners()
+        return applied
+    }

+    /** C3-C8 + C12: hand the phone back while the desktop keeps running. */
+    private fun backstageReleasePhoneControl() {
+        stopHostDisplayMonitor()
+        hostReconfigurationGeneration += 1
+        MainActivity.setSessionSystemBarsHidden(false)
+        applyNavigationDisabled(Display.DEFAULT_DISPLAY, false, navigationToken, "phone")
+        releasePhoneRotation()
+        MainActivity.restoreOrientation()
+        stopVirtualMouse()
+        stopRawMouseReader()
+        runCatching { physicalInputRouter.restore() }
+            .onFailure { OperationLog.w(this, "Backstage", "physical input restore failed", it) }
+        runCatching {
+            val others = AndroidAutoMirrorActivity.autoOverlayDisplayIds() + coverDisplayController.ownedDisplayIds()
+            if (others.isEmpty()) DisplayEnvironmentSettings(this).restoreTopology()
+            else DisplayEnvironmentSettings(this).activateTopologyForOverlays(others)
+        }.onFailure { OperationLog.w(this, "Backstage", "topology release failed", it) }
+    }

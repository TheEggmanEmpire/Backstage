+    private fun backstageNotifyListeners() {
+        val sessionDisplay = backstageSessionDisplayId()
+        val name = backstagePresentationName()
+        val key = "$sessionDisplay:$targetWidth:$targetHeight:$density:$name"
+        if (key == backstageLastNotified) return
+        backstageLastNotified = key

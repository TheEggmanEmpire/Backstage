+    private fun backstageForceFull() {
+        if (backstageFullParams != null && runCatching { backstageLeaveMini() }.getOrDefault(false)) return
+        backstageMiniChrome?.let { chrome ->
+            runCatching {
+                chrome.abandonGesture()
+                (chrome.parent as? android.view.ViewGroup)?.removeView(chrome)
+            }
+        }
+        backstageMiniChrome = null
+        backstageMiniLayoutSize = null
+        backstageMiniHome = null
+        backstageMiniObstacles = BackstageMiniObstacles.NONE
+        backstageFullParams?.let { full ->
+            rootWindowParams = full
+            root?.let { frame -> runCatching { windowManager?.updateViewLayout(frame, full) } }
+        }
+        backstageFullParams = null
+        backstagePresentation = BackstagePresentation.FULL
+        backstageTakePhoneControl()
+    }

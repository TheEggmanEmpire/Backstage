+    /** Upstream's lock-screen suspend removes the desktop: say why when the user asked it to keep running. */
+    private fun backstageRecordSuspendOnLock(blocker: String) {
+        if (Backstage.displayFlagsProfile(this) != BackstageDisplayFlags.RICH) return
+        Backstage.recordLockedModeFallback("the desktop was suspended when the phone locked ($blocker)")
+    }
+
+    /** Secure lock screens restore only on ACTION_USER_PRESENT (a confirmed unlock), never on a poll. */
+    private fun backstageSecureKeyguard(): Boolean =
+        runCatching { getSystemService(KeyguardManager::class.java).isDeviceSecure }.getOrDefault(true)
+
+    /** H6: a Backstage desktop survives screen-off: HIDDEN while locked, previous presentation after unlock. */
+    private fun backstageHandleScreenLifecycle(action: String?): Boolean {
+        if (!backstageSessionActive() || suspendedForLockScreen) {
+            if (action == Intent.ACTION_SCREEN_OFF && active && !suspendedForLockScreen && backstageEnabled()) {
+                backstageRecordSuspendOnLock(backstagePresentationBlocker() ?: "no_direct_display")
+            }
+            return false
+        }
+        when (action) {
+            Intent.ACTION_SCREEN_OFF -> {
+                backstageUnlockGeneration += 1
+                val previous = backstagePresentation
+                if (previous != BackstagePresentation.HIDDEN) {
+                    // Refused (e.g. laptop deck): fall back to upstream's lock-screen suspend, never leave a
+                    // host window over the keyguard.
+                    if (!backstageApplyPresentation(BackstagePresentation.HIDDEN, "screen_off")) {
+                        backstageRecordSuspendOnLock(backstagePresentationBlocker() ?: "presentation_refused")
+                        return false
+                    }
+                    backstageLockRestore = previous
+                }
+            }
+            Intent.ACTION_SCREEN_ON -> backstageAwaitUnlock(++backstageUnlockGeneration, 0)
+            Intent.ACTION_USER_PRESENT -> backstageRestoreAfterUnlock("user_present")
+        }
+        return true
+    }
+
+    /**
+     * After SCREEN_ON (or a request deferred while locked): restore once the phone reads interactive and unlocked twice
+     * in a row (>= 400 ms stable), whether or not the lock screen is secure. Woken inside the "lock after timeout"
+     * grace period the keyguard never showed, so no USER_PRESENT will ever come. Once a secure keyguard is seen locked,
+     * only a confirmed unlock (ACTION_USER_PRESENT) restores. The 1 s keyguard watch in MINI covers a late keyguard.
+     */
+    private fun backstageAwaitUnlock(generation: Int, attempt: Int, unlockedPolls: Int = 0) {
+        if (generation != backstageUnlockGeneration || backstageLockRestore == null || !active) return
+        val (step, polls) = BackstagePresentationPolicy.unlockStep(backstagePhoneLocked(), backstageSecureKeyguard(), unlockedPolls)
+        when (step) {
+            BackstagePresentationPolicy.UnlockStep.RESTORE -> backstageRestoreAfterUnlock("keyguard_unlocked")
+            BackstagePresentationPolicy.UnlockStep.AWAIT_USER_PRESENT -> Unit
+            BackstagePresentationPolicy.UnlockStep.POLL ->
+                if (attempt < 300) postMainDelayed(400L) { backstageAwaitUnlock(generation, attempt + 1, polls) }
+        }
+    }
+
+    private fun backstageRestoreAfterUnlock(reason: String) {
+        val target = backstageLockRestore ?: return
+        if (backstagePhoneLocked()) return
+        backstageLockRestore = null
+        backstageUnlockGeneration += 1
+        backstageApplyPresentation(target, reason)
+    }

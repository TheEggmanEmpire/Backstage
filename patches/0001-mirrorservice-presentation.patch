+    /** Returning from HIDDEN re-adds the host with addWindow(); never start(), which would create a new display. */
+    private fun backstageShowHostWindow(target: BackstagePresentation): Boolean {
+        if (windowManager == null) return false
+        backstagePresentation = target
+        runCatching { addWindow() }.onFailure { error ->
+            runCatching { detachHostWindow() }
+            backstagePresentation = BackstagePresentation.HIDDEN
+            throw error
+        }
+        backstageSetImePolicy(hidden = false)
+        if (target == BackstagePresentation.MINI) {
+            backstageApplyMiniWindow(
+                root ?: error("host window missing"),
+                surfaceView ?: error("host surface missing"),
+                laptopContent ?: error("host content missing"),
+            )
+        } else {
+            backstageTakePhoneControl()
+        }
+        // surfaceCreated -> reattachExistingDisplay -> attachMirror binds the host; the sink closes after that.
+        return true
+    }

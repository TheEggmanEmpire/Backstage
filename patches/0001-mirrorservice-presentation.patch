+    private fun backstagePhoneLocked(): Boolean {
+        val keyguard = runCatching { getSystemService(KeyguardManager::class.java) }.getOrNull()
+        val locked = runCatching { keyguard?.isKeyguardLocked == true || keyguard?.isDeviceLocked == true }.getOrDefault(true)
+        return !backstagePhoneScreenOn() || locked
+    }

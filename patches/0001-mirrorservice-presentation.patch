+                surface,
+                clip = Rect(crop.offsetX, crop.offsetY, crop.offsetX + tile.width, crop.offsetY + tile.height),
+                radius = min(tile.width, tile.height) / 2f,
+            )
+        } else {
+            params.width = FrameLayout.LayoutParams.MATCH_PARENT
+            params.height = FrameLayout.LayoutParams.MATCH_PARENT
+            params.leftMargin = 0
+            params.topMargin = dp(BackstageUi.GRIP_DP)

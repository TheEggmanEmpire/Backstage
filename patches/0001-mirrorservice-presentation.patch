+        if (mirrorDisplayId >= 0) startVirtualMouse()
+        val display = getSystemService(DisplayManager::class.java).getDisplay(targetDisplayId)
+        if (display != null && (physicalExternalDisplayConnected || routePhysicalMice)) {
+            runCatching { physicalInputRouter.routeConnectedDevices(display, routePhysicalMice, routePhysicalKeyboardToDextop) }
+                .onFailure { OperationLog.w(this, "Backstage", "input routing restore failed", it) }
+        }
+        scheduleTopologyReapplyAfterReconnect()
+        updateVirtualCursorVisibility()
+    }

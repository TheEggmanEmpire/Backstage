+    /**
+     * the MINI tile forwards the user's touches while the phone is in use, so they are sent on one ordered
+     * background lane (InputDispatcher waits for each injection result; the main thread must not). The event is
+     * copied; the result is assumed accepted (rejections are logged by the lane). FULL keeps upstream's synchronous send,
+     * except while MINI events are still queued: nothing may overtake them.
+     */
+    private fun backstageSendDirectTouch(event: MotionEvent): Boolean {
+        val displayId = targetDisplayId
+        val lane = BackstageOrderedLane.miniInput
+        if (backstagePresentation != BackstagePresentation.MINI && lane.idle()) return inputDispatcher.send(event, displayId)
+        val copy = MotionEvent.obtain(event)
+        val posted = lane.post({ Log.w(logTag, "mini touch forwarding failed", it) }) {
+            try {
+                backstageMiniDispatcher.send(copy, displayId)
+            } finally {
+                copy.recycle()
+            }
+        }
+        if (!posted) copy.recycle()
+        return posted
+    }
+
+    /** Used on the lane only: its observer must not touch the main thread's diagnostics state. */
+    private val backstageMiniDispatcher by lazy {
+        InputDispatcher(privilegedAccess) { event, displayId, accepted, failure ->
+            if (!accepted) {
+                OperationLog.w(
+                    this, "InputDispatch",
+                    "mini tile: injectInputEvent rejected displayId=$displayId action=${(event as? MotionEvent)?.actionMasked}",
+                    failure,
+                )
+            }
+        }
+    }

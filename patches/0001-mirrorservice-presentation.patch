+        if (!rebind) return
+        val inApp = backstagePresentation == BackstagePresentation.IN_APP
+        runCatching {
+            val surface = if (inApp) backstageHostlessTarget() else backstageEnsureSink().surface.also { backstagePlayerBound = false }

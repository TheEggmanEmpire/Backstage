+    private fun backstageLayoutMiniContent(tile: BackstageMiniGeometry.Tile) {
+        val content = laptopContent ?: return
+        val surface = surfaceView ?: return
+        val params = content.layoutParams as? FrameLayout.LayoutParams ?: return
+        if (backstageMiniCircle()) {
+            val crop = BackstageMiniGeometry.centerCrop(tile.width, tile.height, targetWidth, targetHeight)
+            params.width = crop.contentWidth
+            params.height = crop.contentHeight
+            params.leftMargin = -crop.offsetX
+            params.topMargin = -crop.offsetY
+            content.layoutParams = params

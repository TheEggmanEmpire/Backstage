+            frame.post {
+                if (root !== frame || backstageDetached()) return@post
+                val exclusion = if (targetWidth >= targetHeight) {
+                    listOf(Rect(0, 0, dp(120).coerceAtMost(frame.width / 3), frame.height))
+                } else {
+                    listOf(Rect(0, 0, frame.width, dp(120).coerceAtMost(frame.height / 3)))
+                }
+                frame.systemGestureExclusionRects = exclusion
+                surfaceView?.systemGestureExclusionRects = exclusion
+            }
+        }
+        backstageTakePhoneControl()
+        return true
+    }

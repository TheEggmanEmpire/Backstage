+        override fun onDraw(canvas: Canvas) {
+            super.onDraw(canvas)
+            val w = width.toFloat()
+            if (circle) {
+                val radius = min(width, height) / 2f
+                canvas.drawCircle(width / 2f, height / 2f, radius - ringPaint.strokeWidth / 2f, ringPaint)
+                return
+            }
+            canvas.drawRect(0f, 0f, w, grip.toFloat(), gripPaint)
+            // Square off the content's rounded top corners so the phone never shows through under the grip.
+            val r = dp(BackstageUi.CORNER_DP).toFloat()
+            val corner = Path().apply {
+                moveTo(0f, grip.toFloat()); lineTo(r, grip.toFloat())
+                arcTo(RectF(0f, grip.toFloat(), 2 * r, grip + 2 * r), 270f, -90f, false); close()
+                moveTo(w, grip.toFloat()); lineTo(w - r, grip.toFloat())
+                arcTo(RectF(w - 2 * r, grip.toFloat(), w, grip + 2 * r), 270f, 90f, false); close()
+            }
+            canvas.drawPath(corner, gripPaint)
+            val pillW = dp(36).toFloat()
+            val pillH = dp(4).toFloat()
+            val top = (grip - pillH) / 2f
+            canvas.drawRoundRect(RectF((w - pillW) / 2f, top, (w + pillW) / 2f, top + pillH), pillH, pillH, pillPaint)
+            // Resize handle glyph: two diagonal strokes in the top corner facing the screen centre.
+            val inset = dp(7).toFloat()
+            val size = grip - 2 * inset
+            val x0 = if (handleOnLeft) inset else w - inset - size
+            if (handleOnLeft) {
+                canvas.drawLine(x0, inset + size, x0 + size, inset, linePaint)
+                canvas.drawLine(x0, inset + size * 0.45f, x0 + size * 0.45f, inset, linePaint)
+            } else {
+                canvas.drawLine(x0, inset, x0 + size, inset + size, linePaint)
+                canvas.drawLine(x0 + size * 0.55f, inset, x0 + size, inset + size * 0.45f, linePaint)
+            }
+        }
+
+        private fun inHandle(x: Float, y: Float): Boolean =
+            !circle && y < grip + dp(6) && if (handleOnLeft) x < handleSize else x > width - handleSize

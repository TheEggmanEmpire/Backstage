+        oldLeft: Int, oldTop: Int, oldRight: Int, oldBottom: Int,
+    ) {
+        if (right - left != oldRight - oldLeft || bottom - top != oldBottom - oldTop) applyRegion()
+    }
+
+    /** API 34+: a 0x0 view (not laid out yet) keeps the whole window touchable until its first layout. */
+    private fun applyRegion() {
+        if (android.os.Build.VERSION.SDK_INT < 34) return
+        val region = oval(view.width, view.height) ?: return
+        runCatching { view.rootSurfaceControl?.setTouchableRegion(region) }
+            .onFailure { android.util.Log.w(TAG, "touchable region unavailable", it) }
+    }
+
+    private fun addInsetsListener() {
+        runCatching {
+            val type = Class.forName("android.view.ViewTreeObserver\$OnComputeInternalInsetsListener")
+            val listener = java.lang.reflect.Proxy.newProxyInstance(
+                BackstageCircleTouchRegion::class.java.classLoader, arrayOf(type)
+            ) { proxy, method, args ->
+                when (method.name) {
+                    "onComputeInternalInsets" -> {
+                        args?.getOrNull(0)?.let(::computeInsets)
+                        null
+                    }
+                    "equals" -> proxy === args?.getOrNull(0)
+                    "hashCode" -> System.identityHashCode(proxy)
+                    "toString" -> "BackstageCircleTouchRegion"
+                    else -> null
+                }
+            }
+            val tree = view.viewTreeObserver
+            android.view.ViewTreeObserver::class.java.getMethod("addOnComputeInternalInsetsListener", type)
+                .invoke(tree, listener)
+            observer = tree
+            insetsListener = listener
+            view.requestLayout()
+        }.onFailure { android.util.Log.w(TAG, "internal insets listener unavailable", it) }
+    }
+
+    /**
+     * Added before the view is attached, the listener sits on the view's floating observer, which attaching merges
+     * into the window's observer and kills: remove it from the window's current observer as well.
+     */
+    private fun removeInsetsListener() {
+        val listener = insetsListener ?: return
+        val stored = observer
+        observer = null
+        insetsListener = null
+        runCatching {
+            val type = Class.forName("android.view.ViewTreeObserver\$OnComputeInternalInsetsListener")
+            val remove = android.view.ViewTreeObserver::class.java.getMethod("removeOnComputeInternalInsetsListener", type)
+            listOfNotNull(stored, view.viewTreeObserver).distinct().filter { it.isAlive }.forEach { remove.invoke(it, listener) }
+        }
+    }
+
+    /** Runs on every traversal of the window (API 33): the region follows the tile's size by itself. */
+    private fun computeInsets(info: Any) {
+        // A listener that could not be removed leaves the whole window touchable (the insets are reset before).
+        if (!installed) return
+        val region = oval(view.width, view.height) ?: return
+        runCatching {
+            info.javaClass.getMethod("setTouchableInsets", Int::class.javaPrimitiveType)
+                .invoke(info, TOUCHABLE_INSETS_REGION)
+            (info.javaClass.getField("touchableRegion").get(info) as android.graphics.Region).set(region)
+        }
+    }
+
+    private fun oval(width: Int, height: Int): android.graphics.Region? {
+        if (width <= 0 || height <= 0) return null
+        val bounds = android.graphics.Region(0, 0, width, height)
+        return android.graphics.Region().apply {
+            setPath(
+                android.graphics.Path().apply {
+                    addOval(android.graphics.RectF(0f, 0f, width.toFloat(), height.toFloat()), android.graphics.Path.Direction.CW)
+                },
+                bounds,
+            )
+        }
+    }
+
+    private companion object {
+        const val TAG = "BackstageMini"
+        /** ViewTreeObserver.InternalInsetsInfo.TOUCHABLE_INSETS_REGION */
+        const val TOUCHABLE_INSETS_REGION = 3
+    }
+}
+
+/** Pure mini-window geometry (no Android types; unit-tested in BackstageMiniGeometryTest). */
+internal object BackstageMiniGeometry {
+    const val DEFAULT_WIDTH_FRACTION = 0.45f
+
+    data class Area(val left: Int, val top: Int, val right: Int, val bottom: Int) {
+        val width: Int get() = (right - left).coerceAtLeast(1)
+        val height: Int get() = (bottom - top).coerceAtLeast(1)
+    }
+
+    data class Tile(val x: Int, val y: Int, val width: Int, val height: Int)
+
+    data class Spec(
+        val desktopWidth: Int,
+        val desktopHeight: Int,
+        val chromeHeight: Int,
+        val margin: Int,
+        val minWidth: Int,
+        val snapDistance: Int,
+    )
+
+    /** Content height at the desktop aspect (16:9 when the desktop size is unknown). */
+    fun contentHeight(width: Int, spec: Spec): Int =
+        if (spec.desktopWidth <= 0 || spec.desktopHeight <= 0) (width * 9f / 16f).roundToInt()
+        else (width.toDouble() * spec.desktopHeight / spec.desktopWidth).roundToInt()
+
+    fun tileHeight(width: Int, spec: Spec): Int = contentHeight(width, spec) + spec.chromeHeight
+
+    fun clampWidth(width: Int, area: Area, spec: Spec): Int {
+        val usableWidth = (area.width - 2 * spec.margin).coerceAtLeast(1)
+        val usableHeight = (area.height - 2 * spec.margin - spec.chromeHeight).coerceAtLeast(1)
+        val maxByHeight = if (spec.desktopWidth > 0 && spec.desktopHeight > 0) {
+            (usableHeight.toLong() * spec.desktopWidth / spec.desktopHeight).toInt()
+        } else {
+            usableHeight * 16 / 9
+        }
+        val maximum = min(usableWidth, maxByHeight).coerceAtLeast(1)
+        return width.coerceIn(spec.minWidth.coerceIn(1, maximum), maximum)
+    }
+
+    fun clampPosition(tile: Tile, area: Area, margin: Int): Tile {
+        val minX = area.left + margin
+        val maxX = area.right - margin - tile.width
+        val minY = area.top + margin
+        val maxY = area.bottom - margin - tile.height
+        val x = if (maxX < minX) area.left + (area.width - tile.width) / 2 else tile.x.coerceIn(minX, maxX)
+        val y = if (maxY < minY) area.top + (area.height - tile.height) / 2 else tile.y.coerceIn(minY, maxY)
+        return tile.copy(x = x, y = y)
+    }
+
+    /** Horizontal snap to the nearer side; vertical snap to the top/bottom edge when close to it. */
+    fun snap(tile: Tile, area: Area, spec: Spec): Tile {
+        val centerX = tile.x + tile.width / 2
+        val x = if (centerX < area.left + area.width / 2) area.left + spec.margin else area.right - spec.margin - tile.width
+        val top = area.top + spec.margin
+        val bottom = area.bottom - spec.margin - tile.height
+        val y = when {
+            tile.y - top < spec.snapDistance -> top
+            bottom - tile.y < spec.snapDistance -> bottom
+            else -> tile.y
+        }
+        return clampPosition(tile.copy(x = x, y = y), area, spec.margin)
+    }
+
+    fun defaultTile(area: Area, spec: Spec): Tile {
+        val width = clampWidth((min(area.width, area.height) * DEFAULT_WIDTH_FRACTION).roundToInt(), area, spec)
+        val height = tileHeight(width, spec)
+        return clampPosition(
+            Tile(area.right - spec.margin - width, area.bottom - spec.margin - height, width, height),
+            area, spec.margin
+        )
+    }
+
+    fun resizeCentered(centerX: Int, centerY: Int, requestedWidth: Int, area: Area, spec: Spec): Tile {
+        val width = clampWidth(requestedWidth, area, spec)
+        val height = tileHeight(width, spec)
+        return clampPosition(Tile(centerX - width / 2, centerY - height / 2, width, height), area, spec.margin)
+    }
+
+    /** Resize from a top corner: the opposite bottom corner ([anchorX], [anchorBottom]) stays put. */
+    fun resizeAnchored(anchorX: Int, anchorBottom: Int, anchorOnRight: Boolean, requestedWidth: Int, area: Area, spec: Spec): Tile {
+        val width = clampWidth(requestedWidth, area, spec)
+        val height = tileHeight(width, spec)
+        val x = if (anchorOnRight) anchorX - width else anchorX
+        return clampPosition(Tile(x, anchorBottom - height, width, height), area, spec.margin)
+    }
+
+    data class Crop(val contentWidth: Int, val contentHeight: Int, val offsetX: Int, val offsetY: Int)
+
+    /** Centre crop of a [desktopWidth]x[desktopHeight] desktop into a [viewWidth]x[viewHeight] viewport (cover). */
+    fun centerCrop(viewWidth: Int, viewHeight: Int, desktopWidth: Int, desktopHeight: Int): Crop {
+        val vw = viewWidth.coerceAtLeast(1)
+        val vh = viewHeight.coerceAtLeast(1)
+        if (desktopWidth <= 0 || desktopHeight <= 0) return Crop(vw, vh, 0, 0)
+        val scale = max(vw.toDouble() / desktopWidth, vh.toDouble() / desktopHeight)
+        val cw = max(vw, (desktopWidth * scale).roundToInt())
+        val ch = max(vh, (desktopHeight * scale).roundToInt())
+        return Crop(cw, ch, (cw - vw) / 2, (ch - vh) / 2)
+    }
+
+    /** (centre x fraction, centre y fraction, width / short side) — survives rotation and resolution changes. */
+    fun persistable(tile: Tile, area: Area): Triple<Float, Float, Float> = Triple(
+        ((tile.x + tile.width / 2f - area.left) / area.width).coerceIn(0f, 1f),
+        ((tile.y + tile.height / 2f - area.top) / area.height).coerceIn(0f, 1f),
+        (tile.width.toFloat() / min(area.width, area.height)).coerceIn(0.05f, 2f),
+    )
+
+    fun restore(centerXFraction: Float, centerYFraction: Float, widthFraction: Float, area: Area, spec: Spec): Tile {
+        val fx = if (centerXFraction.isFinite()) centerXFraction.coerceIn(0f, 1f) else 1f
+        val fy = if (centerYFraction.isFinite()) centerYFraction.coerceIn(0f, 1f) else 1f
+        val fw = if (widthFraction.isFinite() && widthFraction > 0f) widthFraction else DEFAULT_WIDTH_FRACTION
+        val tile = resizeCentered(
+            area.left + (fx * area.width).roundToInt(),
+            area.top + (fy * area.height).roundToInt(),
+            (fw * min(area.width, area.height)).roundToInt(),
+            area, spec
+        )
+        return snap(tile, area, spec)
+    }
+
+    /**
+     * Where the tile shows while the phone keyboard covers the screen from [obstacleTop] down: unchanged when it is
+     * clear of it, otherwise just above it (like picture-in-picture), keeping its horizontal centre and shrinking only
+     * when the space above is too small. Null when not even the smallest tile fits above the keyboard: hide it then.
+     */
+    fun avoidBottom(tile: Tile, area: Area, spec: Spec, obstacleTop: Int): Tile? {
+        if (tile.y + tile.height <= obstacleTop) return tile
+        val bottom = min(area.bottom, obstacleTop)
+        if (bottom - area.top < tileHeight(spec.minWidth.coerceAtLeast(1), spec) + 2 * spec.margin) return null
+        val free = Area(area.left, area.top, area.right, bottom)
+        val width = clampWidth(tile.width, free, spec)
+        val height = tileHeight(width, spec)
+        val centerX = tile.x + tile.width / 2
+        return clampPosition(Tile(centerX - width / 2, bottom - spec.margin - height, width, height), free, spec.margin)
+    }
+
+    /** ([x], [y]) in view pixels lies inside the oval inscribed in a [width]x[height] view (the circle tile's bubble). */
+    fun inOval(x: Float, y: Float, width: Int, height: Int): Boolean {
+        if (width <= 0 || height <= 0) return false
+        val rx = width / 2.0
+        val ry = height / 2.0
+        val dx = (x - rx) / rx
+        val dy = (y - ry) / ry
+        return dx * dx + dy * dy <= 1.0
+    }
+
+    /** A rectangle in tile (view) pixels. */
+    data class Box(val left: Int, val top: Int, val right: Int, val bottom: Int) {
+        val width: Int get() = right - left
+        val height: Int get() = bottom - top
+        fun contains(x: Float, y: Float): Boolean = x >= left && x < right && y >= top && y < bottom
+        fun intersects(other: Box): Boolean =
+            left < other.right && other.left < right && top < other.bottom && other.top < bottom
+        fun grownBy(by: Int): Box = Box(left - by, top - by, right + by, bottom + by)
+    }
+
+    /**
+     * The always-visible button row of a [width]x[height] tile: [count] square touch targets of [size] in reading order
+     * (headphones "Play in background", chat, open Backstage, full screen, close), placed like mini-player controls
+     * along the bottom.
+     *
+     * Rounded tile: one row in the bottom corner facing the screen centre ([towardLeft], the side the resize handle
+     * faces), [inset] from the edges and [gap] apart, never on the grip (above [top]). Circle tile: an arc along the
+     * bottom of the bubble, centred, each target's disc inside the bubble [inset] from the rim (its corners belong to
+     * the phone), neighbouring targets never overlapping, all below [top] (the caption at the top of the bubble).
+     *
+     * Fallback when the tile is too small for all of them (the minimum tile sizes are chosen so five always fit): fewer
+     * slots are laid out (the slots at the end are null) until the rest fits; at least the first one is always placed,
+     * clamped into the tile. Which buttons get the slots: BackstagePresentationPolicy.fitButtons.
+     */
+    fun buttonRow(
+        width: Int,
+        height: Int,
+        circle: Boolean,
+        towardLeft: Boolean,
+        count: Int,
+        size: Int,
+        gap: Int,
+        inset: Int,
+        top: Int,
+    ): List<Box?> {
+        if (count <= 0) return emptyList()
+        val w = width.coerceAtLeast(1)
+        val h = height.coerceAtLeast(1)
+        val s = size.coerceAtLeast(1)
+        for (n in count downTo 1) {
+            val boxes = if (circle) arcRow(w, h, n, s, gap, inset, top) else cornerRow(w, h, towardLeft, n, s, gap, inset, top)
+            if (boxes != null) return boxes + List(count - n) { null }
+        }
+        // Not even one button fits: the first one, clamped into the tile (never laid out like that in practice).
+        val c = s.coerceAtMost(min(w, h))
+        val left = if (circle) (w - c) / 2 else if (towardLeft) 0 else w - c
+        return listOf<Box?>(Box(left, h - c, left + c, h)) + List(count - 1) { null }
+    }
+
+    private fun cornerRow(w: Int, h: Int, towardLeft: Boolean, n: Int, s: Int, gap: Int, inset: Int, top: Int): List<Box>? {
+        val rowWidth = n * s + (n - 1) * gap
+        if (rowWidth + 2 * inset > w || h - inset - s < top) return null
+        val left = if (towardLeft) inset else w - inset - rowWidth
+        val bottom = h - inset
+        return List(n) { i -> Box(left + i * (s + gap), bottom - s, left + i * (s + gap) + s, bottom) }
+    }
+
+    /**
+     * Centres on a circle of radius r - inset - s/2 around the bubble centre, symmetric about straight down, spread by
+     * the smallest angle at which no two targets (plus [gap]) overlap. Null when the outer ones would rise above [top].
+     */
+    private fun arcRow(w: Int, h: Int, n: Int, s: Int, gap: Int, inset: Int, top: Int): List<Box>? {
+        val d = min(w, h)
+        val r = d / 2.0
+        val cx = w / 2.0
+        val cy = h / 2.0
+        val ring = r - inset - s / 2.0
+        if (ring < 0) return null
+        var stepTenths = 0
+        while (stepTenths <= 1_800) {
+            val step = Math.toRadians(stepTenths / 10.0)
+            val boxes = List(n) { i ->
+                val angle = (i - (n - 1) / 2.0) * step
+                val x = (cx + ring * kotlin.math.sin(angle) - s / 2.0).roundToInt()
+                val y = (cy + ring * kotlin.math.cos(angle) - s / 2.0).roundToInt()
+                Box(x, y, x + s, y + s)
+            }
+            if (boxes.indices.all { i -> (i + 1 until n).all { j -> !boxes[i].grownBy(gap).intersects(boxes[j]) } }) {
+                return boxes.takeIf { row ->
+                    row.all { it.top >= top && it.left >= 0 && it.right <= w && it.bottom <= h } &&
+                        row.all { discInside(it, cx, cy, r - inset) }
+                }
+            }
+            stepTenths += if (n == 1) 1_801 else 5
+        }
+        return null
+    }
+
+    /** The target's inscribed disc lies within [radius] of ([cx], [cy]) (one pixel of rounding allowed). */
+    fun discInside(box: Box, cx: Double, cy: Double, radius: Double): Boolean {
+        val bx = (box.left + box.right) / 2.0
+        val by = (box.top + box.bottom) / 2.0
+        return kotlin.math.hypot(bx - cx, by - cy) + min(box.width, box.height) / 2.0 <= radius + 1.0
+    }
+}
+
+/**
+ * What covers the phone screen where the MINI tile floats, from the phone display's accessibility windows. The tile is
+ * an accessibility overlay, which sits above the keyboard, the notification shade and system dialogs: it moves out of
+ * the keyboard's way and hides (invisible, touches pass through) while system UI covers the screen.
+ */
+internal object BackstageMiniObstacles {
+    /** One accessibility window on the phone display: AccessibilityWindowInfo type and bounds in screen pixels. */
+    data class Window(val type: Int, val left: Int, val top: Int, val right: Int, val bottom: Int)
+
+    /** [imeTop]: top edge of the phone keyboard, null without one; [systemUi]: shade, quick settings, power menu... */
+    data class State(val imeTop: Int?, val systemUi: Boolean)
+
+    val NONE = State(null, false)
+
+    /**
+     * [panelTop]: top edge (screen pixels) of Backstage's own chat panel at the bottom of the phone screen, opened from
+     * the tile's chat button; the tile keeps clear of it like of the keyboard (it is an ordinary app window, so it
+     * cannot be told apart from other apps' windows here: the app reports it through Backstage.setMiniPanelTop).
+     */
+    fun from(windows: List<Window>, screenHeight: Int, panelTop: Int? = null): State {
+        val visible = windows.filter { it.right > it.left && it.bottom > it.top }
+        val imeTop = (visible.filter { it.type == AccessibilityWindowInfo.TYPE_INPUT_METHOD }.map { it.top } + listOfNotNull(panelTop))
+            .minOrNull()
+        // The status and navigation bars are thin system windows; the expanded shade, quick settings, the power menu
+        // and system dialogs are tall ones.
+        val systemUi = visible.any {
+            it.type == AccessibilityWindowInfo.TYPE_SYSTEM && (it.bottom - it.top) * 3 >= screenHeight.coerceAtLeast(1)
+        }
+        return State(imeTop, systemUi)
+    }
+}
+
+/** Pure decisions of the presentation state machine (no Android types; unit-tested in BackstagePresentationPolicyTest). */
+internal object BackstagePresentationPolicy {
+    enum class SetterTarget { ROOT, FULL_PARAMS, NONE }
+    enum class Recovery { NONE, FINISH_HIDDEN, PARK_HIDDEN, FORCE_FULL }
+
+    /** Upstream window setters (keep-awake, brightness, HUD): the FULL window, never the MINI tile; none in HIDDEN. */
+    fun setterTarget(presentation: BackstagePresentation): SetterTarget = when (presentation) {
+        BackstagePresentation.FULL -> SetterTarget.ROOT
+        BackstagePresentation.MINI -> SetterTarget.FULL_PARAMS
+        BackstagePresentation.HIDDEN, BackstagePresentation.IN_APP -> SetterTarget.NONE
+    }
+
+    /** No host window: the display renders into the background sink (HIDDEN) or the app's player (IN_APP). */
+    fun hostless(presentation: BackstagePresentation): Boolean =
+        presentation == BackstagePresentation.HIDDEN || presentation == BackstagePresentation.IN_APP
+
+    /** IN_APP shows the desktop in the app's player when the app handed one over; every other hostless case parks. */
+    fun bindsPlayer(presentation: BackstagePresentation, playerAvailable: Boolean): Boolean =
+        presentation == BackstagePresentation.IN_APP && playerAvailable
+
+    /** Changes that draw nothing over the phone are applied while it is locked; MINI/FULL wait for the unlock. */
+    fun allowedWhileLocked(target: BackstagePresentation): Boolean = hostless(target)
+
+    /**
+     * After a change [previous] -> [target] threw, with [current] the state it left behind and [miniLeftovers]
+     * (stored FULL params or the tile chrome still attached): finish a started HIDDEN, park again when coming
+     * from HIDDEN, keep a refused HIDDEN request (nothing changed before the sink rebind), otherwise FULL.
+     */
+    fun recovery(
+        previous: BackstagePresentation,
+        current: BackstagePresentation,
+        target: BackstagePresentation,
+        miniLeftovers: Boolean,
+    ): Recovery = when {
+        hostless(current) -> Recovery.FINISH_HIDDEN
+        hostless(previous) -> Recovery.PARK_HIDDEN
+        hostless(target) && current == previous -> Recovery.NONE
+        current == BackstagePresentation.FULL && !miniLeftovers -> Recovery.NONE
+        else -> Recovery.FORCE_FULL
+    }
+
+    /** A live resolution change while MINI re-applies the tile (buffer size, aspect, circle crop). */
+    fun relayoutMini(presentation: BackstagePresentation, laidOut: Pair<Int, Int>?, width: Int, height: Int): Boolean =
+        presentation == BackstagePresentation.MINI && laidOut != null && laidOut != (width to height)
+
+    /** What a button of the mini window's always-visible row does. */
+    sealed interface MiniButtonAction {
+        data class Present(val target: BackstagePresentation) : MiniButtonAction
+        /** Opens the Backstage app's chat panel at the bottom of the phone screen; the tile stays as it is. */
+        data object OpenChat : MiniButtonAction
+        /** Opens the Backstage app (Home) and sends the desktop to the background (the Backstage glue's handler). */
+        data object OpenApp : MiniButtonAction
+        /** Stops the agent and ends the desktop session (on the first tap). */
+        data object Stop : MiniButtonAction
+    }
+
+    /**
+     * Headphones ("Play in background") -> HIDDEN (the display moves to the background sink, the desktop and its apps
+     * keep running, the Backstage app shows its "Desktop running in background" notification); chat -> the chat panel;
+     * full screen -> FULL; close -> stops the agent and ends the session at once.
+     */
+    fun miniButtonAction(icon: Int): MiniButtonAction = when (icon) {
+        BackstageUi.ICON_BACKGROUND -> MiniButtonAction.Present(BackstagePresentation.HIDDEN)
+        BackstageUi.ICON_CHAT -> MiniButtonAction.OpenChat
+        BackstageUi.ICON_APP -> MiniButtonAction.OpenApp
+        BackstageUi.ICON_EXPAND -> MiniButtonAction.Present(BackstagePresentation.FULL)
+        else -> MiniButtonAction.Stop
+    }
+
+    /**
+     * The always-visible row in reading order: headphones, chat (only when the Backstage app registered its chat panel),
+     * open Backstage (only with the app's handler), full screen, close. When the tile is too small, [fitButtons] decides
+     * which of them stay.
+     */
+    fun miniButtons(chatAvailable: Boolean, appAvailable: Boolean = false): List<Int> = listOfNotNull(
+        BackstageUi.ICON_BACKGROUND,
+        BackstageUi.ICON_CHAT.takeIf { chatAvailable },
+        BackstageUi.ICON_APP.takeIf { appAvailable },
+        BackstageUi.ICON_EXPAND,
+        BackstageUi.ICON_STOP,
+    )
+
+    /**
+     * Which buttons stay when only [slots] fit (reading order kept): full screen goes first (the popup's caption and a
+     * double tap remain), then chat, then open Backstage (the app reaches both); close and headphones always stay, close
+     * last of all.
+     */
+    val MINI_DROP_ORDER = listOf(BackstageUi.ICON_EXPAND, BackstageUi.ICON_CHAT, BackstageUi.ICON_APP, BackstageUi.ICON_BACKGROUND)
+
+    fun fitButtons(buttons: List<Int>, slots: Int): List<Int> {
+        var kept = buttons
+        for (drop in MINI_DROP_ORDER) {
+            if (kept.size <= slots.coerceAtLeast(1)) break
+            kept = kept - drop
+        }
+        return kept.take(slots.coerceAtLeast(1))
+    }
+
+    /**
+     * The phone's own screen from the default display's state (Display.STATE_ON = 2, STATE_VR = 5, STATE_ON_SUSPEND = 6
+     * count as on; OFF, DOZE and DOZE_SUSPEND as off). PowerManager.isInteractive() cannot tell: it stays true while any
+     * display group is awake, e.g. a desktop with its own display group, and then no ACTION_SCREEN_OFF is broadcast.
+     */
+    fun phoneScreenOn(defaultDisplayState: Int): Boolean =
+        defaultDisplayState == 2 || defaultDisplayState == 5 || defaultDisplayState == 6
+
+    /** A keyguard that appears while MINI shows (no SCREEN_OFF, e.g. Lockdown) sends the desktop to HIDDEN. */
+    fun hideForKeyguard(presentation: BackstagePresentation, keyguardLocked: Boolean): Boolean =
+        presentation == BackstagePresentation.MINI && keyguardLocked
+
+    /** A refused direct display falls back to the overlay display once, only when Backstage (not upstream) forced it. */
+    fun fallBackToOverlay(alreadyFailed: Boolean, backstageForcedDirect: Boolean, upstreamWantsDirect: Boolean): Boolean =
+        !alreadyFailed && backstageForcedDirect && !upstreamWantsDirect
+
+    enum class UnlockStep { RESTORE, AWAIT_USER_PRESENT, POLL }
+
+    /**
+     * One unlock poll: a secure keyguard seen locked waits for USER_PRESENT; otherwise two consecutive unlocked
+     * reads restore (also on secure devices woken inside the lock-after-timeout grace period, which never send
+     * USER_PRESENT). Returns the step and the new count of consecutive unlocked reads.
+     */
+    fun unlockStep(locked: Boolean, secureKeyguard: Boolean, unlockedPolls: Int): Pair<UnlockStep, Int> = when {
+        locked && secureKeyguard -> UnlockStep.AWAIT_USER_PRESENT to 0
+        locked -> UnlockStep.POLL to 0
+        unlockedPolls + 1 >= 2 -> UnlockStep.RESTORE to unlockedPolls + 1
+        else -> UnlockStep.POLL to unlockedPolls + 1
+    }
+
+    /**
+     * One UI may move the phone's front task onto a newly created desktop display. A background (MINI/HIDDEN) start
+     * never brings Dextop's own activity back to the phone (upstream's ensurePhoneControlOnDefaultDisplay); it moves
+     * back only the user's task, when it is the phone's front task at the start and lives on the desktop.
+     */
+    fun migratedPhoneTask(phoneFrontAtStart: Int?, desktopTaskIds: List<Int>): Int? =
+        phoneFrontAtStart?.takeIf { it in desktopTaskIds }
+
+    /** WindowManager DISPLAY_IME_POLICY_LOCAL / DISPLAY_IME_POLICY_HIDE. */
+    const val IME_POLICY_LOCAL = 0
+    const val IME_POLICY_HIDE = 2
+
+    /**
+     * IME policy Backstage imposes on the desktop display, or null to keep upstream's (LOCAL, or FALLBACK_DISPLAY for a
+     * headless Android Auto desktop). HIDDEN never shows a keyboard over the frames and accessibility tree the agent
+     * reads. Re-applied after every upstream configureDisplay(), which resets the policy (e.g. a live resize, ).
+     */
+    fun imePolicyOverride(presentation: BackstagePresentation): Int? =
+        if (presentation == BackstagePresentation.HIDDEN) IME_POLICY_HIDE else null
+}
+
+/** H9 flag ladder for the Backstage desktop (VirtualDisplay flag values from AOSP DisplayManager). */
+internal object BackstageDisplayFlags {
+    const val OWN_DISPLAY_GROUP = 1 shl 11     // API 31; needs ADD_TRUSTED_DISPLAY (shell has it)
+    const val ALWAYS_UNLOCKED = 1 shl 12       // API 33; needs ADD_ALWAYS_UNLOCKED_DISPLAY
+    const val OWN_FOCUS = 1 shl 14             // API 34; ignored by DMS without FLAG_TRUSTED
+    const val STEAL_TOP_FOCUS_DISABLED = 1 shl 16 // API 34; only with OWN_FOCUS + TRUSTED
+    const val RICH = "rich"
+    const val FOCUS = "focus"
+    const val NONE = "none"
+
+    /**
+     * The desktop keeps running (own display group: it does not sleep with the phone) and stays unlocked (no keyguard
+     * on it) while the phone is locked, only when the display is accepted with both flags (profile "rich").
+     */
+    fun runsWhileLocked(acceptedFlags: Int): Boolean =
+        (acceptedFlags and (OWN_DISPLAY_GROUP or ALWAYS_UNLOCKED)) == (OWN_DISPLAY_GROUP or ALWAYS_UNLOCKED)
+
+    // android.view.Display flag bits (@hide in Display.java; values from AOSP): what the platform really applied.
+    const val DISPLAY_TRUSTED = 1 shl 7
+    const val DISPLAY_OWN_DISPLAY_GROUP = 1 shl 8
+    const val DISPLAY_ALWAYS_UNLOCKED = 1 shl 9
+    const val DISPLAY_OWN_FOCUS = 1 shl 11
+    const val DISPLAY_STEAL_TOP_FOCUS_DISABLED = 1 shl 12
+
+    /**
+     * The Backstage flags of the accepted rung [acceptedFlags] that the created display really carries ([displayFlags] =
+     * Display.getFlags()). The platform drops some silently: ALWAYS_UNLOCKED without an own display group
+     * (VirtualDisplayAdapter), OWN_FOCUS without TRUSTED, and vendor builds may strip more. Only these count.
+     */
+    fun effective(acceptedFlags: Int, displayFlags: Int): Int {
+        var result = acceptedFlags
+        if (displayFlags and DISPLAY_OWN_DISPLAY_GROUP == 0) result = result and OWN_DISPLAY_GROUP.inv()
+        if (displayFlags and DISPLAY_ALWAYS_UNLOCKED == 0) result = result and ALWAYS_UNLOCKED.inv()
+        if (displayFlags and DISPLAY_OWN_FOCUS == 0) result = result and OWN_FOCUS.inv()
+        if (displayFlags and DISPLAY_STEAL_TOP_FOCUS_DISABLED == 0) result = result and STEAL_TOP_FOCUS_DISABLED.inv()
+        return result
+    }
+
+    /** The Backstage flags a rung asked for (the upstream bits of the rung are left out). */
+    fun backstageBits(flags: Int): Int = flags and (OWN_DISPLAY_GROUP or ALWAYS_UNLOCKED or OWN_FOCUS or STEAL_TOP_FOCUS_DISABLED)
+
+    /**
+     * Why a desktop created with [profile] does not keep running while the phone is locked, or null when it does (or is
+     * not asked to). [direct]: the owned direct display is used (the overlay fallback has no flags at all);
+     * [rejection]: the platform's message for the richest refused rung that asked for both flags.
+     */
+    fun lockedModeFallback(
+        profile: String?,
+        sdk: Int,
+        direct: Boolean,
+        acceptedFlags: Int,
+        effectiveFlags: Int,
+        rejection: String?,
+    ): String? = when {
+        profile != RICH -> null
+        sdk < 33 -> "Android ${sdk} cannot keep a desktop unlocked (needs Android 13)"
+        !direct -> "the desktop runs as an overlay display, which sleeps and locks with the phone"
+        !runsWhileLocked(acceptedFlags) ->
+            "the platform refused an always-unlocked desktop" + (rejection?.let { ": $it" } ?: "")
+        !runsWhileLocked(effectiveFlags) -> "the platform created the desktop without its own display group or unlock"
+        else -> null
+    }
+
+    /**
+     * Rungs OR-ed into openOwned's richest rung, richest first; the upstream ladder always follows.
+     * Default "focus": per-display focus only. "rich" (opt-in) adds OWN_DISPLAY_GROUP|ALWAYS_UNLOCKED, which keeps
+     * the desktop unlocked and awake while the phone is locked (a keyguard bypass for the desktop: consent only).
+     * [background] sessions (started for the agent in MINI/HIDDEN) first try the same rungs with
+     * STEAL_TOP_FOCUS_DISABLED, so touches/launches on the desktop never move the phone's top focus or IME.
+     */
+    fun ladder(profile: String?, sdk: Int, background: Boolean = false): IntArray {
+        val base = when (profile ?: FOCUS) {
+            NONE -> return IntArray(0)
+            RICH -> buildList {
+                if (sdk >= 34) add(OWN_FOCUS or OWN_DISPLAY_GROUP or ALWAYS_UNLOCKED)
+                if (sdk >= 33) add(OWN_DISPLAY_GROUP or ALWAYS_UNLOCKED)
+                if (sdk >= 34) add(OWN_FOCUS)
+            }
+            else -> if (sdk >= 34) listOf(OWN_FOCUS) else emptyList()
+        }
+        if (!background || sdk < 34) return base.toIntArray()
+        val quiet = base.filter { it and OWN_FOCUS != 0 }.map { it or STEAL_TOP_FOCUS_DISABLED }
+        return (quiet + base).toIntArray()
+    }
+
+    /** A failed/missing policy must never prevent desktop creation or mutate the original fallback rungs. */
+    fun creationLadder(bases: IntArray, extras: IntArray, policy: ((IntArray, IntArray) -> IntArray)?): IntArray {
+        if (bases.isEmpty()) return bases
+        val original = (extras.map { bases[0] or it } + bases.toList()).toIntArray()
+        return runCatching { policy?.invoke(bases.copyOf(), extras.copyOf()) }.getOrNull()
+            ?.takeIf { it.size in 1..32 } ?: original
+    }
+
+    const val FOCUS_QUIET = "quiet"
+    const val FOCUS_OWN = "own"
+    const val FOCUS_SHARED = "shared"
+
+    /**
+     * How the desktop's focus relates to the phone's, from the accepted flags. "quiet": own focus, and touches/launches
+     * on the desktop never take the phone's top focus (the phone app keeps its keyboard). "own": own focus, but a touch
+     * or launch makes the desktop the top-focused display. "shared" (Android 13, or profile "none"): key events reach the
+     * desktop only while it is the top-focused display. Best effort: the platform may ignore OWN_FOCUS silently.
+     */
+    fun focusMode(acceptedFlags: Int): String = when {
+        acceptedFlags and OWN_FOCUS == 0 -> FOCUS_SHARED
+        acceptedFlags and STEAL_TOP_FOCUS_DISABLED != 0 -> FOCUS_QUIET
+        else -> FOCUS_OWN
+    }
+}
+
+/** "Locked mode" facts of the running desktop for Backstage's diagnostics (MirrorService.Backstage.lockedModeSnapshot). */
+internal data class BackstageLockedModeSnapshot(
+    val sessionActive: Boolean,
+    /** The owned direct display is used (the overlay fallback has no flags). */
+    val direct: Boolean,
+    /** Flag profile read when this desktop is created ("rich" = keep running while locked), null without a session. */
+    val profile: String?,
+    /** Backstage flags of the richest rung asked for, of the rung the platform accepted, and really applied. */
+    val requestedFlags: Int,
+    val acceptedFlags: Int,
+    val effectiveFlags: Int,
+    val runsWhileLocked: Boolean,
+    /** The desktop display is on (its display group is awake); null without a session. */
+    val desktopAwake: Boolean?,
+    /** Last reason the desktop did not (or could not) keep running while locked, and when (wall clock ms). */
+    val fallback: String?,
+    val fallbackAtMs: Long,
+)
+
+/**
+ * Backstage's overlay gives MirrorService's accessibility configuration more event types for the agent
+ * (backstage/overlay/res/xml/mirror_accessibility_service.xml). MirrorService's own handler keeps receiving only the
+ * types upstream's res/xml/mirror_accessibility_service.xml requests (BackstageAccessibilityEventsTest compares them).
+ */
+internal object BackstageAccessibilityEvents {
+    const val UPSTREAM_TYPES = AccessibilityEvent.TYPE_VIEW_CLICKED or AccessibilityEvent.TYPE_VIEW_FOCUSED or
+        AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED or AccessibilityEvent.TYPE_VIEW_TEXT_SELECTION_CHANGED or
+        AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED or AccessibilityEvent.TYPE_WINDOWS_CHANGED
+
+    fun forUpstream(eventType: Int): Boolean = eventType and UPSTREAM_TYPES != 0
+}
+
+internal object BackstageUi {
+    const val PREFS = "backstage_presentation"
+    const val START_PRESENTATION_DELAY_MS = 300L
+    const val SINK_CLOSE_DELAY_MS = 500L
+    const val GRIP_DP = 22
+    const val CORNER_DP = 12
+    const val MARGIN_DP = 12
+    /** Smallest rounded tile: the five-button row (5 x 40 dp targets, gaps and insets) fits. */
+    const val MIN_WIDTH_DP = 220
+    /** Smallest bubble that still fits the five-button arc below the caption (BackstageMiniGeometry.buttonRow). */
+    const val MIN_CIRCLE_DP = 160
+    const val SNAP_DP = 48
+    const val KEYGUARD_POLL_MS = 1_000L
+    /** Coalesces window-change bursts before the keyboard/system-UI check of the MINI tile. */
+    const val OBSTACLE_PROBE_MS = 120L
+    /** After a background start: when to look for a phone task One UI moved onto the new desktop display. */
+    val MIGRATION_CHECKS_MS = longArrayOf(500L, 1_500L)
+    /** Buttons of the always-visible row (BackstagePresentationPolicy.miniButtonAction). */
+    const val ICON_EXPAND = 0
+    const val ICON_STOP = 2
+    /** The headphones button ("Play in background"): HIDDEN, the desktop and its apps keep running. */
+    const val ICON_BACKGROUND = 3
+    /** Opens the Backstage app's chat panel (the tile stays). */
+    const val ICON_CHAT = 4
+    /** Opens the Backstage app with the desktop in the background. */
+    const val ICON_APP = 5
+    /** Touch target of each row button (>= 40 dp); the visible disc and glyph are smaller. */
+    const val BUTTON_DP = 40
+    const val BUTTON_DISC_DP = 30
+    const val BUTTON_GLYPH_DP = 18
+    const val BUTTON_INSET_DP = 4
+    const val BUTTON_GAP_DP = 2
+    /** Circle: the caption's band at the top of the bubble; the arc stays below it. */
+    const val CIRCLE_CAPTION_DP = 44
+    const val MODE_NONE = 0
+    const val MODE_GRIP = 2
+    const val MODE_RESIZE = 3
+    const val MODE_FORWARD = 4
+    const val MODE_PINCH = 5
+    const val MODE_BUTTON = 7
+}

+// Backstage (patch 0001-mirrorservice-presentation): the service-independent half of the FULL / MINI / HIDDEN
+// presentation. Pure decisions and geometry (unit-tested in BackstageMiniGeometryTest and
+// BackstagePresentationPolicyTest), the VirtualDisplay flag ladder, the background frame sink and the mini window's
+// constants. The state machine that needs MirrorService's private state stays in MirrorService (region "Backstage
+// presentation" right after the class header).
+
+/**
+ * IN_APP: the desktop plays inside the Backstage app (a Flutter texture on Home); like HIDDEN there is no host window,
+ * but the display renders into the app's player Surface while one exists (parked on the background sink otherwise).
+ */
+internal enum class BackstagePresentation { FULL, MINI, HIDDEN, IN_APP }
+
+/** Background frame sink: owned display output on a HandlerThread, the latest Image kept for capture. */
+internal class BackstageFrameSink(val width: Int, val height: Int) {
+    private val thread = android.os.HandlerThread("Backstage-desktop-frames").apply { start() }
+    private val reader = android.media.ImageReader.newInstance(width, height, PixelFormat.RGBA_8888, 3)
+    private val lock = Any()
+    private var latest: android.media.Image? = null
+    @Volatile var closed = false
+        private set
+    val surface: Surface get() = reader.surface
+
+    init {
+        reader.setOnImageAvailableListener({ source ->
+            val image = runCatching { source.acquireLatestImage() }.getOrNull() ?: return@setOnImageAvailableListener
+            synchronized(lock) {
+                if (closed) {
+                    image.close()
+                } else {
+                    latest?.close()
+                    latest = image
+                }
+            }
+        }, Handler(thread.looper))
+    }
+
+    fun copy(): android.graphics.Bitmap? = synchronized(lock) {
+        val image = latest ?: return null
+        runCatching {
+            val plane = image.planes[0]
+            val pixelStride = plane.pixelStride
+            val rowPadding = plane.rowStride - pixelStride * image.width
+            val padded = android.graphics.Bitmap.createBitmap(
+                image.width + rowPadding / pixelStride,
+                image.height,
+                android.graphics.Bitmap.Config.ARGB_8888,
+            )
+            padded.copyPixelsFromBuffer(plane.buffer.duplicate().apply { rewind() })
+            if (rowPadding == 0) padded else android.graphics.Bitmap.createBitmap(padded, 0, 0, image.width, image.height)
+                .also { padded.recycle() }
+        }.getOrNull()
+    }
+
+    fun close() {
+        synchronized(lock) {
+            if (closed) return
+            closed = true
+            latest?.close()
+            latest = null
+        }
+        runCatching { reader.close() }
+        thread.quitSafely()
+    }
+}

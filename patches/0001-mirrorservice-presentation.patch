+        override fun dispatchTouchEvent(event: MotionEvent): Boolean {
+            if (event.actionMasked == MotionEvent.ACTION_DOWN) {
+                dragged = false
+                mode = when {
+                    // The corners outside the bubble belong to the phone (touchable region); never drag or toggle there.
+                    circle && !BackstageMiniGeometry.inOval(event.x, event.y, width, height) -> BackstageUi.MODE_NONE
+                    // Always visible, never dragged or forwarded: the row buttons get their own taps.
+                    inRowButton(event.x, event.y) -> BackstageUi.MODE_BUTTON
+                    inHandle(event.x, event.y) -> BackstageUi.MODE_RESIZE
+                    circle || event.y < grip -> BackstageUi.MODE_GRIP
+                    else -> BackstageUi.MODE_FORWARD
+                }
+                downRawX = event.rawX
+                downRawY = event.rawY
+                currentTile()?.let { tile ->
+                    startX = tile.x
+                    startY = tile.y
+                    startWidth = tile.width
+                    // The handle side is fixed for the whole gesture, even if the tile crosses the screen centre.
+                    resizeFromLeft = handleOnLeft
+                    anchorX = if (resizeFromLeft) tile.x + tile.width else tile.x
+                    anchorBottom = tile.y + tile.height
+                    grabOffset = if (resizeFromLeft) event.rawX - tile.x else tile.x + tile.width - event.rawX
+                }
+            }
+            if (circle && mode == BackstageUi.MODE_GRIP &&
+                event.actionMasked == MotionEvent.ACTION_POINTER_DOWN && event.pointerCount == 2
+            ) {
+                // Bubble viewport: a second finger turns the drag into a pinch resize.
+                mode = BackstageUi.MODE_PINCH
+                startPinch(event)
+                return true
+            }
+            when (mode) {
+                // The ImageView handles press state, slop and the click (posted, so it runs after this dispatch).
+                BackstageUi.MODE_BUTTON -> super.dispatchTouchEvent(event)
+                BackstageUi.MODE_GRIP -> onGrip(event)
+                BackstageUi.MODE_RESIZE -> resize(event)
+                BackstageUi.MODE_FORWARD -> forward(event)
+                BackstageUi.MODE_PINCH -> pinch(event)
+            }
+            if (event.actionMasked == MotionEvent.ACTION_UP || event.actionMasked == MotionEvent.ACTION_CANCEL) {
+                val ended = gestureActive()
+                mode = BackstageUi.MODE_NONE
+                // A keyboard or the shade that came up during the gesture is handled.
+                if (ended && backstageMiniChrome === this) backstageShowMiniTile()
+            }
+            return true
+        }
+
+        private fun onGrip(event: MotionEvent) {
+            val dx = event.rawX - downRawX
+            val dy = event.rawY - downRawY
+            when (event.actionMasked) {
+                MotionEvent.ACTION_MOVE -> {
+                    if (!dragged && hypot(dx, dy) < slop) return
+                    dragged = true
+                    val tile = currentTile() ?: return
+                    place(
+                        BackstageMiniGeometry.clampPosition(
+                            tile.copy(x = startX + dx.roundToInt(), y = startY + dy.roundToInt()),
+                            backstageScreenArea(), 0
+                        ),
+                        persist = false
+                    )
+                }
+                MotionEvent.ACTION_UP -> if (dragged) {
+                    currentTile()?.let {
+                        place(BackstageMiniGeometry.snap(it, backstageScreenArea(), backstageMiniSpec()), persist = true, final = true)
+                    }
+                }
+            }
+        }
+
+        private fun resize(event: MotionEvent) {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_MOVE -> {
+                    val requested = if (resizeFromLeft) anchorX - (event.rawX - grabOffset) else event.rawX + grabOffset - anchorX
+                    dragged = true
+                    place(
+                        BackstageMiniGeometry.resizeAnchored(
+                            anchorX, anchorBottom, anchorOnRight = resizeFromLeft, requestedWidth = requested.roundToInt(),
+                            area = backstageScreenArea(), spec = backstageMiniSpec()
+                        ),
+                        persist = false
+                    )
+                }
+                MotionEvent.ACTION_UP -> currentTile()?.let {
+                    place(BackstageMiniGeometry.snap(it, backstageScreenArea(), backstageMiniSpec()), persist = dragged, final = true)
+                }
+            }
+        }
+
+        private fun forward(event: MotionEvent) {
+            if (event.actionMasked == MotionEvent.ACTION_POINTER_DOWN && event.pointerCount == 2) {
+                // Two fingers resize the tile instead of reaching the desktop.
+                if (injectedDirectTouchActive) cancelInjectedDirectTouch()
+                mode = BackstageUi.MODE_PINCH
+                startPinch(event)
+                return
+            }
+            if (event.pointerCount > 1) return
+            val local = MotionEvent.obtain(event)
+            try {
+                local.offsetLocation(0f, -grip.toFloat())
+                injectDirectTouch(local)
+            } finally {
+                local.recycle()
+            }
+        }
+
+        private fun startPinch(event: MotionEvent) {
+            pinchDistance = hypot(event.getRawX(0) - event.getRawX(1), event.getRawY(0) - event.getRawY(1)).coerceAtLeast(1f)
+            val tile = currentTile() ?: return
+            startWidth = tile.width
+            pinchCenterX = tile.x + tile.width / 2
+            pinchCenterY = tile.y + tile.height / 2
+            dragged = false
+        }
+
+        private fun pinch(event: MotionEvent) {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_MOVE -> {
+                    if (event.pointerCount < 2) return
+                    val distance = hypot(event.getRawX(0) - event.getRawX(1), event.getRawY(0) - event.getRawY(1))
+                    dragged = true
+                    place(
+                        BackstageMiniGeometry.resizeCentered(
+                            pinchCenterX, pinchCenterY, (startWidth * distance / pinchDistance).roundToInt(),
+                            backstageScreenArea(), backstageMiniSpec()
+                        ),
+                        persist = false
+                    )
+                }
+                MotionEvent.ACTION_UP -> currentTile()?.let {
+                    place(BackstageMiniGeometry.snap(it, backstageScreenArea(), backstageMiniSpec()), persist = dragged, final = true)
+                }
+            }
+        }
+
+        fun abandonGesture() {
+            if (mode == BackstageUi.MODE_FORWARD && injectedDirectTouchActive) cancelInjectedDirectTouch()
+            mode = BackstageUi.MODE_NONE
+        }
+    }

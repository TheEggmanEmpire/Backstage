+                direct = session && service?.phoneOwnedDisplay != null,
+                profile = if (session) service?.backstageCreatedProfile else null,
+                requestedFlags = if (session) service?.backstageRequestedFlags ?: 0 else 0,
+                acceptedFlags = if (session) service?.phoneOwnedDisplay?.flags?.let(BackstageDisplayFlags::backstageBits) ?: 0 else 0,
+                effectiveFlags = if (session) service?.backstageEffectiveFlags ?: 0 else 0,

index 0000000000000000000000000000000000000000..26b2cc6c1734231404c269ef1bd699bb2860642d
--- /dev/null
+++ b/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstageOrderedLaneTest.kt
@@ -0,0 +1,75 @@
+package moe.n4tsu.dextop
+
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executor
+import java.util.concurrent.RejectedExecutionException
+import java.util.concurrent.TimeUnit
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+/** touches the MINI tile forwards are sent in order, off the main thread. */
+class BackstageOrderedLaneTest {
+    @Test fun tasksRunInPostingOrderAndIdleReportsQueuedWork() {
+        val queued = ArrayDeque<Runnable>()
+        val lane = BackstageOrderedLane(Executor { queued.addLast(it) })
+        val ran = mutableListOf<Int>()
+        assertTrue(lane.idle())
+        repeat(3) { index -> assertTrue(lane.post { ran += index }) }
+        // A FULL send arriving must not overtake the three queued MINI events.
+        assertFalse(lane.idle())
+        queued.removeFirst().run()
+        queued.removeFirst().run()
+        assertFalse(lane.idle())
+        queued.removeFirst().run()
+        assertEquals(listOf(0, 1, 2), ran)
+        assertTrue(lane.idle())
+    }
+
+    @Test fun aFailingTaskIsReportedAndNeverStopsTheLane() {
+        val errors = CopyOnWriteArrayList<Throwable>()
+        val lane = BackstageOrderedLane(Executor { it.run() })
+        assertTrue(lane.post({ errors += it }) { error("binder died") })
+        assertTrue(lane.idle())
+        var ran = false
+        assertTrue(lane.post({ errors += it }) { ran = true })
+        assertTrue(ran)
+        assertEquals(listOf("binder died"), errors.map { it.message })
+    }
+
+    @Test fun aRefusedTaskIsNotCountedAsPending() {
+        val errors = mutableListOf<Throwable>()
+        val lane = BackstageOrderedLane(Executor { throw RejectedExecutionException("shut down") })
+        assertFalse(lane.post({ errors += it }) { error("must not run") })
+        assertTrue(lane.idle())
+        assertEquals(1, errors.size)
+    }
+
+    @Test fun theProcessWideLaneRunsOffTheCallingThreadInOrder() {
+        val lane = BackstageOrderedLane.miniInput
+        val threads = CopyOnWriteArrayList<String>()
+        val order = CopyOnWriteArrayList<Int>()
+        val gate = CountDownLatch(1)
+        val done = CountDownLatch(50)
+        // The first task blocks the lane like a stalled injection: posting never waits for it.
+        assertTrue(lane.post { gate.await(5, TimeUnit.SECONDS) })
+        repeat(50) { index ->
+            assertTrue(lane.post {
+                threads += Thread.currentThread().name
+                order += index
+                done.countDown()
+            })
+        }
+        assertFalse(lane.idle())
+        gate.countDown()
+        assertTrue(done.await(5, TimeUnit.SECONDS))
+        assertEquals((0 until 50).toList(), order.toList())
+        assertEquals(setOf("Backstage-mini-input"), threads.toSet())
+        // idle() turns true once the last task has finished.
+        val deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5)
+        while (!lane.idle() && System.nanoTime() < deadline) Thread.sleep(5)
+        assertTrue(lane.idle())
+    }
+}
diff --git a/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstagePresentationPolicyTest.kt b/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstagePresentationPolicyTest.kt

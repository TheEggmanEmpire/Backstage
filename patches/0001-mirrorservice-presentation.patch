+    private fun backstageRequestPixelCopy(done: (android.graphics.Bitmap?) -> Unit): Boolean {
+        // Only the direct owned display shows the whole desktop 1:1 in the host SurfaceView; extended/external
+        // and overlay sessions show a crop or a letterboxed mirror, so the caller must fall back instead.
+        if (phoneOwnedDisplay == null || phoneRegion != null || externalOutput != null) return false
+        if (backstagePresentation == BackstagePresentation.IN_APP) return backstageCopyPlayer(done)
+        val view = surfaceView ?: return false
+        val surface = view.holder.surface
+        if (!surface.isValid || mirrorDisplayId < 0 || targetWidth <= 0 || targetHeight <= 0) return false
+        val bitmap = android.graphics.Bitmap.createBitmap(targetWidth, targetHeight, android.graphics.Bitmap.Config.ARGB_8888)
+        return runCatching {
+            android.view.PixelCopy.request(view, bitmap, { result ->
+                if (result == android.view.PixelCopy.SUCCESS) done(bitmap) else { bitmap.recycle(); done(null) }
+            }, Handler(mainLooper))
+            true
+        }.getOrElse {
+            bitmap.recycle()
+            false
+        }
+    }
+
+    /** IN_APP: the last frame queued to the app's player (PixelCopy of a Surface reads its last queued buffer). */
+    private fun backstageCopyPlayer(done: (android.graphics.Bitmap?) -> Unit): Boolean {
+        val surface = backstagePlayer()?.takeIf { backstagePlayerBound } ?: return false
+        if (targetWidth <= 0 || targetHeight <= 0) return false
+        val bitmap = android.graphics.Bitmap.createBitmap(targetWidth, targetHeight, android.graphics.Bitmap.Config.ARGB_8888)
+        return runCatching {
+            android.view.PixelCopy.request(surface, bitmap, { result ->
+                if (result == android.view.PixelCopy.SUCCESS) done(bitmap) else { bitmap.recycle(); done(null) }
+            }, Handler(mainLooper))
+            true
+        }.getOrElse {
+            bitmap.recycle()
+            false
+        }
+    }

+    private fun backstageApplyMiniWindow(frame: TouchRoutingFrame, surface: SurfaceView, content: View) {
+        val manager = windowManager ?: error("WindowManager unavailable")
+        // Entering MINI (from FULL, or from HIDDEN after addWindow) vs re-applying it (shape change).
+        val entering = backstageFullParams == null
+        if (entering) backstageFullParams = rootWindowParams
+        val circle = backstageMiniCircle()
+        val home = backstageInitialTile()
+        backstageMiniHome = home
+        // The user may be typing (a background start): the tile never appears over the keyboard.
+        backstageMiniObstacles = backstageReadMiniObstacles()
+        val shown = backstageAvoidObstacles(home)
+        val tile = shown ?: home
+        val params = backstageMiniWindowParams(tile, hidden = shown == null)
+        rootWindowParams = params
+        // Keep the buffer desktop-sized: the compositor scales it into the tile, frames stay sharp for capture.
+        surface.holder.setFixedSize(targetWidth, targetHeight)
+        backstageLayoutMiniContent(tile)
+        if (entering) {
+            performanceHud?.let {
+                backstageHudVisibility = it.visibility
+                it.visibility = View.GONE
+            }
+        }
+        frame.systemGestureExclusionRects = emptyList()
+        surface.systemGestureExclusionRects = emptyList()
+        frame.background = GradientDrawable().apply {
+            setColor(Color.BLACK)
+            if (circle) shape = GradientDrawable.OVAL else cornerRadius = dp(BackstageUi.CORNER_DP).toFloat()
+        }
+        frame.clipToOutline = true
+        // The full-screen cursor window would draw over the phone: park it until FULL returns.
+        cursorView?.let { cursor ->
+            runCatching { manager.removeView(cursor) }
+            backstageParkedCursor = cursor
+        }
+        cursorView = null
+        val chrome = backstageMiniChrome ?: BackstageMiniChrome().also { backstageMiniChrome = it }
+        chrome.applyShape()
+        if (chrome.parent == null) {
+            // Child 0 receives every touch while TouchRoutingFrame.routeTouchesToSurface is set; translationZ
+            // draws it above the desktop content.
+            frame.addView(chrome, 0, FrameLayout.LayoutParams(-1, -1))
+            chrome.translationZ = dp(4).toFloat()
+        }
+        frame.routeTouchesToSurface = true
+        manager.updateViewLayout(frame, params)
+        backstageSetCircleTouch(frame, circle)
+        chrome.onTileMoved()
+        chrome.setStatus(Backstage.miniStatus)
+        // addWindow() posts its own exclusion rects; clear them again after that pass.
+        frame.post {
+            if (backstagePresentation == BackstagePresentation.MINI && root === frame) {
+                frame.systemGestureExclusionRects = emptyList()
+                surface.systemGestureExclusionRects = emptyList()
+            }
+        }
+        backstageMiniLayoutSize = targetWidth to targetHeight
+        backstageWatchKeyguard()
+    }
+
+    private fun backstageLeaveMini(): Boolean {
+        val frame = root ?: return false
+        val manager = windowManager ?: return false
+        val full = backstageFullParams ?: return false
+        backstageMiniChrome?.let { chrome ->
+            chrome.abandonGesture()
+            frame.removeView(chrome)
+        }
+        backstageMiniChrome = null
+        backstageMiniLayoutSize = null
+        backstageMiniHome = null
+        backstageMiniObstacles = BackstageMiniObstacles.NONE
+        (laptopContent?.layoutParams as? FrameLayout.LayoutParams)?.let {
+            it.width = FrameLayout.LayoutParams.MATCH_PARENT
+            it.height = FrameLayout.LayoutParams.MATCH_PARENT
+            it.leftMargin = 0
+            it.topMargin = 0
+            laptopContent?.layoutParams = it
+        }
+        surfaceView?.let { surface ->
+            surface.holder.setSizeFromLayout()
+            backstageSurfaceShape(surface, clip = null, radius = 0f)
+        }
+        frame.clipToOutline = false
+        frame.setBackgroundColor(Color.BLACK)
+        performanceHud?.visibility = backstageHudVisibility
+        full.flags = if (getSharedPreferences(Backstage.FLUTTER_PREFS, MODE_PRIVATE)
+                .getBoolean("flutter.keep_awake_during_session", true)
+        ) full.flags or WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
+        else full.flags and WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON.inv()
+        rootWindowParams = full
+        backstageFullParams = null
+        backstagePresentation = BackstagePresentation.FULL
+        backstageSetCircleTouch(null, circle = false)
+        manager.updateViewLayout(frame, full)
+        backstageParkedCursor?.let { cursor ->
+            runCatching { manager.addView(cursor, backstageCursorWindowParams()) }
+                .onSuccess { cursorView = cursor }
+        }
+        backstageParkedCursor = null

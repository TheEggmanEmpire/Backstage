+    /** HIDDEN <-> IN_APP: only the target Surface and the keyboard policy change. */
+    private fun backstageSwitchHostless(next: BackstagePresentation): Boolean {
+        val owned = phoneOwnedDisplay ?: return false
+        val previous = backstagePresentation
+        backstagePresentation = next
+        val bound = runCatching { owned.resize(backstageHostlessTarget(), targetWidth, targetHeight, density) }.getOrDefault(false)
+        if (!bound) {
+            backstagePresentation = previous
+            runCatching { owned.resize(backstageHostlessTarget(), targetWidth, targetHeight, density) }
+            return false
+        }
+        backstageSetImePolicy(hidden = next == BackstagePresentation.HIDDEN)
+        return true
+    }
+
+    private fun backstageEnterHidden(next: BackstagePresentation = BackstagePresentation.HIDDEN): Boolean {
+        val owned = phoneOwnedDisplay ?: return false
+        val previous = backstagePresentation
+        if (previous == BackstagePresentation.FULL && menu?.visibility == View.VISIBLE) toggleMenu()
+        cancelDesktopTouchStream()
+        // FIRST move the display to the background sink (or the app's player): the host Surface must never be the last
+        // live target.
+        backstagePresentation = next
+        val target = runCatching { backstageHostlessTarget() }.onFailure { backstagePresentation = previous }.getOrThrow()
+        backstagePresentation = previous
+        check(owned.resize(target, targetWidth, targetHeight, density)) {
+            "Unable to move the desktop to the background sink"
+        }
+        // Nothing may fail between the rebind and this line (backstageRecover relies on it).
+        backstagePresentation = next
+        if (previous == BackstagePresentation.FULL) backstageReleasePhoneControl()
+        backstageMiniChrome?.abandonGesture()
+        backstageMiniChrome = null
+        backstageMiniParams = null
+        backstageFullParams = null
+        backstageMiniLayoutSize = null
+        backstageMiniHome = null
+        backstageMiniObstacles = BackstageMiniObstacles.NONE
+        backstageParkedCursor = null
+        backstageSetCircleTouch(null, circle = false)
+        // detachHostWindow removes the SurfaceHolder callback before the views, so surfaceDestroyed cannot run.
+        detachHostWindow()
+        releaseMirror()
+        backstageSetImePolicy(hidden = next == BackstagePresentation.HIDDEN)
+        return true
+    }

+    private fun backstageTakePhoneControl() {
+        applyHostDisplayOrientation(requestedPortrait)
+        forcePhoneRotation(requestedPortrait, force = true)
+        setPhoneNavigationDisabled(true)
+        startHostDisplayMonitor()

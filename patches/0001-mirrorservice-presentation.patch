+++ b/android/app/src/main/kotlin/moe/n4tsu/dextop/MirrorService.kt
@@ -124,6 +124,2049 @@ import org.json.JSONObject
 import org.lsposed.hiddenapibypass.HiddenApiBypass
 
 class MirrorService : AccessibilityService(), SurfaceHolder.Callback {
+    // region Backstage presentation (patch 0001-mirrorservice-presentation) -----------------------------------
+    //
+    // FULL   = upstream behaviour (full-screen accessibility host window, phone navigation/rotation taken).
+    // MINI   = the SAME root window shrunk to a floating tile; same SurfaceView/Surface, so the owned display is
+    //          never rebound. Phone navigation, rotation, uinput pointer, topology and mouse routing are released.
+    // HIDDEN = the owned display renders into a background ImageReader (latest frame kept for screenshots); the
+    //          host window is gone. The sink is bound BEFORE the host goes away; a null Surface is never bound.
+    //
+    // Everything here is inert unless Backstage turns it on (Backstage.directDesktopDefault / the pref
+    // flutter.backstage_direct_desktop): presentation stays FULL and every guard is a no-op.
+
+    @Volatile private var backstagePresentation = BackstagePresentation.FULL
+    /** A platform-managed (DeX) direct display is created decorated for Backstage; see backstagePrepareDirectDisplay. */
+    private var backstageDecorationsForced = false
+    @Volatile private var backstageSink: BackstageFrameSink? = null
+    /** The display renders into the app's player Surface (IN_APP, or until a host Surface replaces it). */
+    @Volatile private var backstagePlayerBound = false
+    private var backstageFullParams: WindowManager.LayoutParams? = null
+    private var backstageMiniParams: WindowManager.LayoutParams? = null
+    private var backstageMiniChrome: BackstageMiniChrome? = null
+    private var backstageParkedCursor: CursorView? = null
+    private var backstageHudVisibility = View.GONE
+    /** Presentation to restore once the phone is unlocked (the desktop is HIDDEN while locked). */
+    private var backstageLockRestore: BackstagePresentation? = null
+    private var backstageUnlockGeneration = 0
+    private var backstageDisplayListenerRegistered = false
+    private var backstageLastNotified: String? = null
+
+    /** Desktop size the MINI tile/buffer is laid out for; a live resolution change re-applies the tile. */
+    private var backstageMiniLayoutSize: Pair<Int, Int>? = null
+    private var backstageKeyguardWatchGeneration = 0
+    /** Direct display creation failed for this session (vendor refused every direct rung): the upstream overlay display is used. */
+    private var backstageDirectFailed = false
+    /** This session is started for background work (MINI/HIDDEN): it never took the phone over. */
+    private var backstageBackgroundSession = false
+    /** The phone's front task when a background session started (moved back if One UI migrates it to the desktop). */
+    @Volatile private var backstagePhoneFrontTask: Int? = null
+    /** Where the user put the MINI tile; the tile shown differs while it avoids the phone keyboard or hides. */
+    private var backstageMiniHome: BackstageMiniGeometry.Tile? = null
+    private var backstageMiniObstacles = BackstageMiniObstacles.NONE
+    private var backstageObstacleProbeQueued = false
+    /** Locked mode (flag profile "rich"): the profile this session is created with, and what the platform applied. */
+    private var backstageCreatedProfile: String? = null
+    private var backstageRequestedFlags = 0
+    private var backstageEffectiveFlags = 0
+    private var backstageRichRejection: String? = null
+    /** Last seen state of the phone's own screen (default display): its off/on transitions, see backstagePhoneScreenOn. */
+    private var backstagePhoneScreenWasOn = true
+    private val backstageTasks by lazy {
+        moe.n4tsu.dextop.plasma.TaskBridge({ name, type -> privilegedAccess.service(name, type) }, logTag)
+    }
+    /** Binder work of the presentation (task moves) never runs on the main thread. */
+    private val backstageWorker by lazy {
+        Executors.newSingleThreadExecutor { task -> Thread(task, "Backstage-presentation").apply { isDaemon = true } }
+    }
+
+    // Registered for every session while a desktop is attached: the agent follows geometry changes even when the
+    // direct display is off. Unregistered on stop, onUnbind and onDestroy.
+    private val backstageDisplayListener = object : DisplayManager.DisplayListener {
+        override fun onDisplayAdded(displayId: Int) = Unit
+        override fun onDisplayRemoved(displayId: Int) = backstageNotifyListeners()
+        override fun onDisplayChanged(displayId: Int) {
+            if (displayId == Display.DEFAULT_DISPLAY) {
+                backstageOnPhoneScreenChanged()
+                return
+            }
+            if (displayId != targetDisplayId) return
+            backstageRelayoutMiniAfterResize()
+            backstageNotifyListeners()
+        }
+    }
+
+    private fun backstageEnabled(): Boolean = Backstage.directDesktopEnabled(this)
+
+    private fun backstageDetached(): Boolean = backstagePresentation != BackstagePresentation.FULL
+
+    /** H1: Backstage sessions always use the direct owned VirtualDisplay, for every window manager. */
+    private fun backstageUseDirectDisplay(): Boolean =
+        !autoOnlySession && !laptopModeActive && backstageEnabled() && !backstageDirectFailed
+
+    /**
+     * H1 fallback: when the direct display Backstage forced fails, the session continues on upstream's overlay
+     * display (no MINI/HIDDEN for it) instead of stopping. Not used when upstream itself chose the direct display.
+     */
+    private fun backstageFallBackToOverlay(error: Throwable): Boolean {
+        // A headless (HIDDEN) start has no host Surface for the overlay display: report the failure instead.
+        if (root == null && BackstagePresentationPolicy.hostless(backstagePresentation)) return false
+        val forced = backstageUseDirectDisplay()
+        val alreadyFailed = backstageDirectFailed
+        backstageDirectFailed = true
+        // With backstageDirectFailed set, useDirectPlasmaDisplay() is upstream's own choice.
+        if (!BackstagePresentationPolicy.fallBackToOverlay(alreadyFailed, forced, useDirectPlasmaDisplay())) return false
+        // The overlay display has no MINI/HIDDEN: a background MINI start continues as an ordinary FULL session.
+        if (backstagePresentation == BackstagePresentation.MINI) {
+            backstageBackgroundSession = false
+            runCatching { backstageForceFull() }
+                .onFailure { OperationLog.w(this, "Backstage", "leaving the mini start for the overlay display failed", it) }
+        }
+        if (backstageDecorationsForced) {
+            showSystemDecorations = false
+            backstageDecorationsForced = false
+        }
+        OperationLog.w(this, "Backstage", "direct desktop display refused; this session uses the overlay display", error)
+        return true
+    }
+
+    /** Upstream setters (keep-awake, brightness) change the FULL window's params, never the MINI tile's. */
+    private fun backstageSetterParams(): WindowManager.LayoutParams? =
+        when (BackstagePresentationPolicy.setterTarget(backstagePresentation)) {
+            BackstagePresentationPolicy.SetterTarget.ROOT -> rootWindowParams
+            BackstagePresentationPolicy.SetterTarget.FULL_PARAMS -> backstageFullParams
+            // The host window is gone; addWindow() rebuilds the params from the preferences when it returns.
+            BackstagePresentationPolicy.SetterTarget.NONE -> null
+        }
+
+    /** setPerformanceHud while MINI: remembered and applied when FULL returns (the tile never shows the HUD). */
+    private fun backstageDeferHud(visibility: Int): Boolean {
+        if (BackstagePresentationPolicy.setterTarget(backstagePresentation) != BackstagePresentationPolicy.SetterTarget.FULL_PARAMS) {
+            return false
+        }
+        backstageHudVisibility = visibility
+        return true
+    }
+
+    private fun backstageRelayoutMiniAfterResize() {
+        if (!BackstagePresentationPolicy.relayoutMini(backstagePresentation, backstageMiniLayoutSize, targetWidth, targetHeight)) return
+        // Buffer size, tile aspect and circle crop all follow the desktop size.
+        backstageApplyMiniShape()
+    }
+
+    /**
+     * A keyguard shown while the screen stays on (power menu "Lockdown", a lock from a device policy) sends no
+     * SCREEN_OFF: while MINI is showing, poll it and go HIDDEN, so the tile never stays above the keyguard.
+     */
+    private fun backstageWatchKeyguard(generation: Int = ++backstageKeyguardWatchGeneration) {
+        postMainDelayed(BackstageUi.KEYGUARD_POLL_MS) {
+            if (generation != backstageKeyguardWatchGeneration || instance !== this ||
+                backstagePresentation != BackstagePresentation.MINI || !backstageSessionActive()
+            ) return@postMainDelayed
+            val locked = runCatching { getSystemService(KeyguardManager::class.java).isKeyguardLocked }.getOrDefault(true)
+            if (BackstagePresentationPolicy.hideForKeyguard(backstagePresentation, locked) &&
+                backstageApplyPresentation(BackstagePresentation.HIDDEN, "keyguard_shown")
+            ) {
+                backstageLockRestore = BackstagePresentation.MINI
+            } else {
+                // Also the fallback for a missed window-change event (keyboard, shade).
+                backstageProbeMiniObstacles()
+                backstageWatchKeyguard(generation)
+            }
+        }
+    }
+
+    /** onAccessibilityEvent hook (windows changed): re-checks the phone keyboard and system UI around the MINI tile. */
+    private fun backstageOnWindowsChanged() {
+        if (backstagePresentation != BackstagePresentation.MINI || backstageObstacleProbeQueued) return
+        backstageObstacleProbeQueued = true
+        postMainDelayed(BackstageUi.OBSTACLE_PROBE_MS) {
+            backstageObstacleProbeQueued = false
+            backstageProbeMiniObstacles()
+        }
+    }
+
+    /** onServiceConnected hook: the app's other user of this service (Backstage's agent) may use it while connected. */
+    private fun backstageAccessibilityConnected() = Backstage.accessibilityConnected(this)
+
+    /**
+     * onAccessibilityEvent hook: every event goes to [Backstage.setAccessibilityClient]'s client first. True for an event
+     * type upstream's configuration does not request (the Backstage overlay adds some): MirrorService's own handling
+     * then skips it, so Dextop sees exactly the events it saw before (BackstageAccessibilityEvents).
+     */
+    private fun backstageOnAccessibilityEvent(event: AccessibilityEvent?): Boolean {
+        if (event == null) return false
+        Backstage.accessibilityClient?.let { client -> runCatching { client.onEvent(this, event) } }
+        return !BackstageAccessibilityEvents.forUpstream(event.eventType)
+    }
+
+    private fun backstageProbeMiniObstacles() {
+        if (backstagePresentation != BackstagePresentation.MINI || instance !== this) return
+        val next = backstageReadMiniObstacles()
+        if (next == backstageMiniObstacles) return
+        backstageMiniObstacles = next
+        backstageShowMiniTile()
+    }
+
+    /** The phone display's keyboard and system UI, from this accessibility service's interactive windows. */
+    private fun backstageReadMiniObstacles(): BackstageMiniObstacles.State {
+        val windows = runCatching { getWindowsOnAllDisplays().get(Display.DEFAULT_DISPLAY).orEmpty() }.getOrDefault(emptyList())
+        val boxes = windows.mapNotNull { window ->
+            runCatching {
+                val bounds = Rect().also(window::getBoundsInScreen)
+                BackstageMiniObstacles.Window(window.type, bounds.left, bounds.top, bounds.right, bounds.bottom)
+            }.getOrNull()
+        }
+        val screenHeight = runCatching { windowManager?.currentWindowMetrics?.bounds?.height() }.getOrNull()
+            ?: resources.displayMetrics.heightPixels
+        return BackstageMiniObstacles.from(boxes, screenHeight, Backstage.miniPanelTop)
+    }
+
+    /**
+     * The tile for the user's [home] placement: out of the phone keyboard's way; null while it is hidden (system UI
+     * over the screen, or no room above the keyboard).
+     */
+    private fun backstageAvoidObstacles(home: BackstageMiniGeometry.Tile): BackstageMiniGeometry.Tile? {
+        val obstacles = backstageMiniObstacles
+        if (obstacles.systemUi) return null
+        val imeTop = obstacles.imeTop ?: return home
+        return BackstageMiniGeometry.avoidBottom(home, backstageScreenArea(), backstageMiniSpec(), imeTop)
+    }
+
+    /**
+     * Lays the MINI window out for [backstageMiniHome] and the current obstacles; never in the middle of a drag (the end
+     * of the gesture lays it out, [duringGesture]).
+     */
+    private fun backstageShowMiniTile(duringGesture: Boolean = false) {
+        if (backstagePresentation != BackstagePresentation.MINI) return
+        val frame = root ?: return
+        val home = backstageMiniHome ?: return
+        if (!duringGesture && backstageMiniChrome?.gestureActive() == true) return
+        val shown = backstageAvoidObstacles(home)
+        val tile = shown ?: home
+        val params = backstageMiniWindowParams(tile, hidden = shown == null)
+        if (backstageMiniCircle()) backstageLayoutMiniContent(tile)
+        runCatching { windowManager?.updateViewLayout(frame, params) }
+            .onFailure { OperationLog.w(this, "Backstage", "mini tile relayout failed", it) }
+        backstageMiniChrome?.onTileMoved()
+    }
+
+    /** Front task of the phone display (top-most visible), or null. Binder call: worker thread only. */
+    private fun backstagePhoneFrontTaskId(): Int? = runCatching {
+        backstageTasks.tasks(Display.DEFAULT_DISPLAY).firstOrNull { it.visible }?.taskId
+    }.getOrNull()
+
+    /** Background start: One UI may have moved the user's front task onto the new display; move only that task back. */
+    private fun backstageReturnMigratedPhoneTask(attachedDisplayId: Int) {
+        if (!backstageBackgroundSession || !active || targetDisplayId != attachedDisplayId) return
+        backstageWorker.execute {
+            runCatching {
+                val desktop = backstageTasks.tasks(attachedDisplayId)
+                val migrated = BackstagePresentationPolicy.migratedPhoneTask(backstagePhoneFrontTask, desktop.map { it.taskId })
+                    ?: return@runCatching
+                val task = desktop.first { it.taskId == migrated }
+                val moved = backstageTasks.moveTaskToDisplay(task, Display.DEFAULT_DISPLAY)
+                OperationLog.i(this, "Backstage", "phone task ${task.packageName} moved back from the desktop: $moved")
+            }.onFailure { OperationLog.w(this, "Backstage", "migrated phone task check failed", it) }
+        }
+    }
+
+    /** onUnbind/onDestroy: no listener may outlive the service; the sink is closed once the service is gone. */
+    private fun backstageReleaseServiceResources(destroyed: Boolean) {
+        Backstage.accessibilityDisconnected(this)
+        backstageKeyguardWatchGeneration += 1
+        if (backstageDisplayListenerRegistered) {
+            runCatching { getSystemService(DisplayManager::class.java).unregisterDisplayListener(backstageDisplayListener) }
+            backstageDisplayListenerRegistered = false
+        }
+        if (destroyed) {
+            backstageSink?.close()
+            backstageSink = null
+        }
+    }
+
+    private fun backstageSessionActive(): Boolean =
+        active && !stopping && !autoOnlySession && phoneOwnedDisplay != null && targetDisplayId >= 0 &&
+            backstageEnabled()
+
+    /**
+     * H2: One UI attaches DeX (taskbar, SecondaryLauncher, freeform) reliably to an owned display only when it is
+     * decorated and switched to freeform before it is published, exactly like the Car Companion desktop
+     * (createDirectAutoDisplay). attachDesktopDisplay withdraws the framework bars after HOME for
+     * platform-managed environments, so only the DeX taskbar remains.
+     */
+    private fun backstagePrepareDirectDisplay() {
+        backstageDecorationsForced = false
+        if (!backstageUseDirectDisplay() || !desktopEnvironment.platformManaged || showSystemDecorations) return
+        showSystemDecorations = true
+        backstageDecorationsForced = true
+    }
+
+    private fun backstageConfigureBeforePublish(displayId: Int) {
+        if (!backstageUseDirectDisplay() || !desktopEnvironment.platformManaged) return
+        desktopModeConfigurator.configureDisplay(displayId, forceFreeform = true)
+    }
+
+    /**
+     * H9: optional VirtualDisplay flags, richest first; openOwned falls back to the plain upstream ladder.
+     * A session Backstage starts for background work (MINI/HIDDEN requested) also asks for
+     * STEAL_TOP_FOCUS_DISABLED, so agent taps/launches on the desktop never take the phone's top focus or IME.
+     */
+    private fun backstageExtraFlagLadder(): IntArray {
+        backstageRequestedFlags = 0
+        backstageEffectiveFlags = 0
+        backstageRichRejection = null
+        if (!backstageUseDirectDisplay()) return IntArray(0)
+        val profile = Backstage.displayFlagsProfile(this)
+        backstageCreatedProfile = profile
+        return BackstageDisplayFlags.ladder(profile, Build.VERSION.SDK_INT,
+            background = backstageBackgroundSession || Backstage.pendingStartIsBackground())
+            .also { ladder -> backstageRequestedFlags = ladder.firstOrNull()?.let(BackstageDisplayFlags::backstageBits) ?: 0 }
+    }
+
+    /** openOwned refused a rung: the richest refusal of an always-unlocked rung is kept for the diagnostics. */
+    private fun backstageOnRungRejected(flags: Int, error: Throwable) {
+        runCatching { Backstage.displayFlagRejected?.invoke(flags, error) }
+        if (backstageRichRejection != null || !BackstageDisplayFlags.runsWhileLocked(flags)) return
+        val cause = generateSequence(error) { it.cause }.firstOrNull { it is SecurityException } ?: error.cause ?: error
+        backstageRichRejection = (cause.message ?: cause.javaClass.simpleName).take(200)
+    }
+
+    /** After the direct display exists: the flags the platform really applied (Display.getFlags), and the verdict. */
+    private fun backstageRecordDisplayFlags(owned: OwnedVirtualDisplay, display: Display) {
+        val accepted = BackstageDisplayFlags.backstageBits(owned.flags)
+        backstageEffectiveFlags = BackstageDisplayFlags.effective(accepted, runCatching { display.flags }.getOrDefault(0))
+        val fallback = BackstageDisplayFlags.lockedModeFallback(
+            backstageCreatedProfile, Build.VERSION.SDK_INT, direct = true, accepted, backstageEffectiveFlags, backstageRichRejection,
+        )
+        OperationLog.i(
+            this, "Backstage",
+            "desktop flags profile=$backstageCreatedProfile requested=0x${backstageRequestedFlags.toString(16)} " +
+                "accepted=0x${accepted.toString(16)} effective=0x${backstageEffectiveFlags.toString(16)} " +
+                "runsWhileLocked=${BackstageDisplayFlags.runsWhileLocked(backstageEffectiveFlags)}" +
+                (fallback?.let { " fallback=$it" } ?: ""),
+        )
+        fallback?.let { Backstage.recordLockedModeFallback(it) }
+    }
+
+    /** The phone's own screen is on (default display state; never PowerManager.isInteractive, see phoneScreenOn). */
+    private fun backstagePhoneScreenOn(): Boolean = runCatching {
+        BackstagePresentationPolicy.phoneScreenOn(
+            getSystemService(DisplayManager::class.java).getDisplay(Display.DEFAULT_DISPLAY).state
+        )
+    }.getOrDefault(true)
+
+    /**
+     * The phone's screen went off or on. While another display group stays awake (a desktop created to keep running
+     * while locked has its own) Android broadcasts neither ACTION_SCREEN_OFF nor ACTION_SCREEN_ON, so the default
+     * display's state drives the same lock handling; with the broadcasts too, the second call is a no-op.
+     */
+    private fun backstageOnPhoneScreenChanged() {
+        val on = backstagePhoneScreenOn()
+        if (on == backstagePhoneScreenWasOn) return
+        backstagePhoneScreenWasOn = on
+        if (!active || autoOnlySession) return
+        backstageHandleScreenLifecycle(if (on) Intent.ACTION_SCREEN_ON else Intent.ACTION_SCREEN_OFF)
+    }
+
+    private fun backstageOnDesktopAttached() {
+        backstagePhoneScreenWasOn = backstagePhoneScreenOn()
+        if (!backstageDisplayListenerRegistered) {
+            runCatching {
+                getSystemService(DisplayManager::class.java)
+                    .registerDisplayListener(backstageDisplayListener, Handler(mainLooper))
+                backstageDisplayListenerRegistered = true
+            }
+        }
+        // A headless (HIDDEN) start: configureDisplay() just set the IME policy to LOCAL; no keyboard on hidden frames.
+        if (backstagePresentation == BackstagePresentation.HIDDEN) backstageSetImePolicy(hidden = true)
+        val pending = Backstage.takePendingStartPresentation()
+        val attachedDisplayId = targetDisplayId
+        if (backstageBackgroundSession) {
+            BackstageUi.MIGRATION_CHECKS_MS.forEach { delay ->
+                postMainDelayed(delay) { backstageReturnMigratedPhoneTask(attachedDisplayId) }
+            }
+        }
+        postMainDelayed(BackstageUi.START_PRESENTATION_DELAY_MS) {
+            if (pending != null && pending != BackstagePresentation.FULL && active && targetDisplayId == attachedDisplayId) {
+                backstageRequestPresentation(pending, "start_request")
+            }
+            backstageBindWaitingPlayer()

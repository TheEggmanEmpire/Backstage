@@ -0,0 +1,364 @@
+package moe.n4tsu.dextop
+
+import kotlin.math.roundToInt
+import kotlin.test.Test
+import kotlin.test.assertContentEquals
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+import moe.n4tsu.dextop.BackstageMiniGeometry.Area
+import moe.n4tsu.dextop.BackstageMiniGeometry.Spec
+import moe.n4tsu.dextop.BackstageMiniGeometry.Tile
+
+class BackstageMiniGeometryTest {
+    // 1080x2400 portrait phone, 80 px status bar, 60 px navigation bar.
+    private val portrait = Area(0, 80, 1080, 2340)
+    private val landscape = Area(80, 0, 2340, 1080)
+    private val spec = Spec(
+        desktopWidth = 1920,
+        desktopHeight = 1080,
+        chromeHeight = 60,
+        margin = 30,
+        minWidth = 400,
+        snapDistance = 120,
+    )
+
+    private fun assertInside(tile: Tile, area: Area, margin: Int = spec.margin) {
+        assertTrue(tile.x >= area.left + margin, "left edge $tile in $area")
+        assertTrue(tile.y >= area.top + margin, "top edge $tile in $area")
+        assertTrue(tile.x + tile.width <= area.right - margin, "right edge $tile in $area")
+        assertTrue(tile.y + tile.height <= area.bottom - margin, "bottom edge $tile in $area")
+    }
+
+    @Test
+    fun tileKeepsTheDesktopAspectBelowTheGrip() {
+        assertEquals(270, BackstageMiniGeometry.contentHeight(480, spec))
+        assertEquals(330, BackstageMiniGeometry.tileHeight(480, spec))
+        assertEquals(270, BackstageMiniGeometry.contentHeight(480, spec.copy(desktopWidth = 0)))
+    }
+
+    @Test
+    fun defaultTileIsBottomRightAtAboutHalfTheScreenWidth() {
+        val tile = BackstageMiniGeometry.defaultTile(portrait, spec)
+        assertEquals(486, tile.width) // 45% of the 1080 px short side
+        assertEquals(1080 - 30 - 486, tile.x)
+        assertEquals(2340 - 30 - tile.height, tile.y)
+        assertInside(tile, portrait)
+    }
+
+    @Test
+    fun widthIsClampedToMinimumAndToTheScreen() {
+        assertEquals(400, BackstageMiniGeometry.clampWidth(10, portrait, spec))
+        assertEquals(1080 - 60, BackstageMiniGeometry.clampWidth(5_000, portrait, spec))
+        // In landscape the height limits the width: (1080 - 60 - 60) * 16 / 9
+        assertEquals(1706, BackstageMiniGeometry.clampWidth(5_000, landscape, spec))
+    }
+
+    @Test
+    fun snapGoesToTheNearerSideAndToCloseEdges() {
+        val leftish = Tile(200, 1000, 480, 330)
+        val snapped = BackstageMiniGeometry.snap(leftish, portrait, spec)
+        assertEquals(30, snapped.x)
+        assertEquals(1000, snapped.y)
+        val nearBottom = Tile(700, 2340 - 330 - 100, 480, 330)
+        val bottom = BackstageMiniGeometry.snap(nearBottom, portrait, spec)
+        assertEquals(1080 - 30 - 480, bottom.x)
+        assertEquals(2340 - 30 - 330, bottom.y)
+        val nearTop = BackstageMiniGeometry.snap(Tile(100, 150, 480, 330), portrait, spec)
+        assertEquals(80 + 30, nearTop.y)
+    }
+
+    @Test
+    fun clampPositionPullsTilesBackOnScreen() {
+        val tile = BackstageMiniGeometry.clampPosition(Tile(-500, 5_000, 480, 330), portrait, 0)
+        assertEquals(0, tile.x)
+        assertEquals(2340 - 330, tile.y)
+    }
+
+    @Test
+    fun anchoredResizeKeepsTheOppositeCorner() {
+        val tile = BackstageMiniGeometry.resizeAnchored(
+            anchorX = 1050, anchorBottom = 2310, anchorOnRight = true, requestedWidth = 700,
+            area = portrait, spec = spec
+        )
+        assertEquals(700, tile.width)
+        assertEquals(1050, tile.x + tile.width)
+        assertEquals(2310, tile.y + tile.height)
+        val left = BackstageMiniGeometry.resizeAnchored(30, 2310, anchorOnRight = false, requestedWidth = 100, area = portrait, spec = spec)
+        assertEquals(400, left.width)
+        assertEquals(30, left.x)
+    }
+
+    @Test
+    fun centeredResizeStaysOnScreen() {
+        val tile = BackstageMiniGeometry.resizeCentered(1000, 2300, 900, portrait, spec)
+        assertEquals(900, tile.width)
+        assertInside(tile, portrait)
+    }
+
+    @Test
+    fun persistedTileSurvivesRotation() {
+        val original = BackstageMiniGeometry.snap(Tile(30, 1200, 600, BackstageMiniGeometry.tileHeight(600, spec)), portrait, spec)
+        val (cx, cy, width) = BackstageMiniGeometry.persistable(original, portrait)
+        val again = BackstageMiniGeometry.restore(cx, cy, width, portrait, spec)
+        assertEquals(original.width, again.width)
+        assertEquals(original.x, again.x)
+        assertTrue(kotlin.math.abs(original.y - again.y) <= 1)
+        val rotated = BackstageMiniGeometry.restore(cx, cy, width, landscape, spec)
+        assertEquals(original.width, rotated.width) // width is relative to the short side
+        assertEquals(landscape.left + spec.margin, rotated.x) // still on the left side
+        assertInside(rotated, landscape)
+    }
+
+    @Test
+    fun restoreToleratesCorruptPreferences() {
+        val tile = BackstageMiniGeometry.restore(Float.NaN, 7f, -1f, portrait, spec)
+        assertInside(tile, portrait)
+        assertEquals(486, tile.width)
+    }
+
+    @Test
+    fun tinyScreensStillProduceAValidTile() {
+        val tiny = Area(0, 0, 300, 200)
+        val tile = BackstageMiniGeometry.defaultTile(tiny, spec)
+        assertTrue(tile.width in 1..300)
+        assertTrue(tile.x >= 0 && tile.y >= 0)
+    }
+
+    @Test
+    fun displayFlagLadderFollowsTheSdk() {
+        val all = BackstageDisplayFlags.OWN_FOCUS or BackstageDisplayFlags.OWN_DISPLAY_GROUP or BackstageDisplayFlags.ALWAYS_UNLOCKED
+        val group = BackstageDisplayFlags.OWN_DISPLAY_GROUP or BackstageDisplayFlags.ALWAYS_UNLOCKED
+        // Default (null) = "focus": no keyguard bypass unless the user opts into "rich".
+        assertContentEquals(intArrayOf(BackstageDisplayFlags.OWN_FOCUS), BackstageDisplayFlags.ladder(null, 36))
+        assertContentEquals(intArrayOf(all, group, BackstageDisplayFlags.OWN_FOCUS), BackstageDisplayFlags.ladder("rich", 36))
+        assertContentEquals(intArrayOf(group), BackstageDisplayFlags.ladder("rich", 33))
+        assertContentEquals(intArrayOf(BackstageDisplayFlags.OWN_FOCUS), BackstageDisplayFlags.ladder("focus", 34))
+        assertContentEquals(intArrayOf(), BackstageDisplayFlags.ladder("focus", 33))
+        assertContentEquals(intArrayOf(), BackstageDisplayFlags.ladder("none", 36))
+        assertEquals(2048, BackstageDisplayFlags.OWN_DISPLAY_GROUP)
+        assertEquals(4096, BackstageDisplayFlags.ALWAYS_UNLOCKED)
+        assertEquals(16384, BackstageDisplayFlags.OWN_FOCUS)
+        assertEquals(65536, BackstageDisplayFlags.STEAL_TOP_FOCUS_DISABLED)
+    }
+
+    @Test
+    fun backgroundSessionsNeverStealTopFocusFirst() {
+        val focus = BackstageDisplayFlags.OWN_FOCUS
+        val quiet = focus or BackstageDisplayFlags.STEAL_TOP_FOCUS_DISABLED
+        assertContentEquals(intArrayOf(quiet, focus), BackstageDisplayFlags.ladder(null, 34, background = true))
+        val rich = BackstageDisplayFlags.ladder("rich", 36, background = true)
+        // Focus safety first: both quiet rungs (rich, focus) before any rung that may steal the phone's focus.
+        assertEquals(5, rich.size)
+        assertTrue(rich.take(2).all { it and BackstageDisplayFlags.STEAL_TOP_FOCUS_DISABLED != 0 })
+        assertTrue(rich.drop(2).none { it and BackstageDisplayFlags.STEAL_TOP_FOCUS_DISABLED != 0 })
+        // SDK 33 has neither OWN_FOCUS nor STEAL_TOP_FOCUS_DISABLED; "none" stays exactly upstream.
+        assertContentEquals(intArrayOf(), BackstageDisplayFlags.ladder("focus", 33, background = true))
+        assertContentEquals(intArrayOf(), BackstageDisplayFlags.ladder("none", 36, background = true))
+    }
+
+    @Test
+    fun circleViewportCentreCropsTheDesktop() {
+        val crop = BackstageMiniGeometry.centerCrop(400, 400, 1920, 1080)
+        assertEquals(400, crop.contentHeight)
+        assertEquals(711, crop.contentWidth) // 1920 * 400 / 1080
+        assertEquals((711 - 400) / 2, crop.offsetX)
+        assertEquals(0, crop.offsetY)
+        val portraitDesktop = BackstageMiniGeometry.centerCrop(300, 300, 1080, 1920)
+        assertEquals(300, portraitDesktop.contentWidth)
+        assertEquals((portraitDesktop.contentHeight - 300) / 2, portraitDesktop.offsetY)
+        assertEquals(BackstageMiniGeometry.Crop(50, 50, 0, 0), BackstageMiniGeometry.centerCrop(50, 50, 0, 0))
+        // A circle tile is square: spec with a 1:1 "desktop" and no grip.
+        val square = Spec(1, 1, 0, 30, 300, 120)
+        val tile = BackstageMiniGeometry.defaultTile(portrait, square)
+        assertEquals(tile.width, tile.height)
+        assertInside(tile, portrait)
+    }
+
+    @Test
+    fun theTileMovesAboveThePhoneKeyboardAndKeepsItsSize() {
+        val home = BackstageMiniGeometry.defaultTile(portrait, spec) // 486x333 at (564, 1977)
+        assertEquals(Tile(564, 1977, 486, 333), home)
+        // Keyboard from y = 1500 down: just above it, same size, same horizontal place (like picture-in-picture).
+        assertEquals(Tile(564, 1500 - 30 - 333, 486, 333), BackstageMiniGeometry.avoidBottom(home, portrait, spec, 1500))
+        // A tile already clear of the keyboard stays where the user put it.
+        val high = Tile(564, 200, 486, 333)
+        assertEquals(high, BackstageMiniGeometry.avoidBottom(high, portrait, spec, 1500))
+    }
+
+    @Test
+    fun theTileShrinksAboveALowKeyboardRoomAndHidesWithoutRoom() {
+        val home = Tile(1500, 560, 800, 510)
+        // Landscape, keyboard from y = 450: (450 - 2 * 30 - 60) px of content height left -> 586 px wide.
+        val shrunk = BackstageMiniGeometry.avoidBottom(home, landscape, spec, 450)
+        assertEquals(Tile(1900 - 293, 30, 586, 390), shrunk)
+        assertInside(shrunk!!, landscape.copy(bottom = 450))
+        // Not even the smallest tile (400 px wide, 285 px tall + margins) fits above y = 300: hidden.
+        assertEquals(null, BackstageMiniGeometry.avoidBottom(home, landscape, spec, 300))
+    }
+
+    @Test
+    fun theCircleTilesCornersAreNotPartOfTheBubble() {
+        // a 300 px circle tile is a square window; its corners show (and belong to) the phone app.
+        assertTrue(BackstageMiniGeometry.inOval(150f, 150f, 300, 300))   // centre
+        assertTrue(BackstageMiniGeometry.inOval(150f, 0f, 300, 300))     // top edge
+        assertTrue(BackstageMiniGeometry.inOval(0f, 150f, 300, 300))     // left edge
+        assertTrue(BackstageMiniGeometry.inOval(300f, 150f, 300, 300))   // right edge
+        assertFalse(BackstageMiniGeometry.inOval(0f, 0f, 300, 300))      // corners
+        assertFalse(BackstageMiniGeometry.inOval(299f, 299f, 300, 300))
+        assertFalse(BackstageMiniGeometry.inOval(10f, 290f, 300, 300))
+        // Just inside / just outside the rim on the diagonal (radius 150: 150 / sqrt(2) = 106.07).
+        assertTrue(BackstageMiniGeometry.inOval(150f + 105f, 150f + 105f, 300, 300))
+        assertFalse(BackstageMiniGeometry.inOval(150f + 107f, 150f + 107f, 300, 300))
+        // About 21 % of the square (1 - pi/4) lies outside the bubble.
+        var outside = 0
+        for (y in 0 until 300) for (x in 0 until 300) if (!BackstageMiniGeometry.inOval(x + 0.5f, y + 0.5f, 300, 300)) outside++
+        assertEquals(0.2146, outside / 90_000.0, 0.005)
+        // A view that is not laid out yet has no bubble.
+        assertFalse(BackstageMiniGeometry.inOval(0f, 0f, 0, 0))
+    }
+
+    // 3x density: 40 dp target = 120 px, 2 dp gap = 6 px, 4 dp inset = 12 px, 22 dp grip = 66 px, 44 dp caption band.
+    private val size = 120
+    private val gap = 6
+    private val inset = 12
+
+    private fun assertApart(boxes: List<BackstageMiniGeometry.Box>, what: String) {
+        for (i in boxes.indices) for (j in i + 1 until boxes.size) {
+            assertFalse(boxes[i].intersects(boxes[j]), "$what: ${boxes[i]} overlaps ${boxes[j]}")
+        }
+    }
+
+    @Test
+    fun theFiveButtonsFormOneRowInTheRoundedTilesBottomCornerFacingTheScreenCentre() {
+        // Smallest rounded tile 220 dp = 660 x (371 + 66 grip), a default one and a large one.
+        for ((w, h) in listOf(660 to 437, 960 to 606, 1000 to 629)) {
+            for (towardLeft in listOf(true, false)) {
+                val row = BackstageMiniGeometry.buttonRow(w, h, circle = false, towardLeft, 5, size, gap, inset, top = 66)
+                assertEquals(5, row.size)
+                val boxes = row.map { assertNotNull(it, "all five fit in $w x $h") }
+                // One row along the bottom, reading order left to right, 40 dp targets, inside the tile, below the grip.
+                boxes.forEach { box ->
+                    assertEquals(size, box.width)
+                    assertEquals(size, box.height)
+                    assertEquals(h - inset, box.bottom)
+                    assertTrue(box.left >= inset && box.right <= w - inset && box.top >= 66, "$box in $w x $h")
+                }
+                boxes.zipWithNext().forEach { (a, b) -> assertEquals(a.right + gap, b.left) }
+                assertApart(boxes, "rounded $w x $h")
+                // The corner facing the screen centre (the resize handle's side), never the edge of the screen.
+                if (towardLeft) assertEquals(inset, boxes.first().left) else assertEquals(w - inset, boxes.last().right)
+            }
+        }
+    }
+
+    @Test
+    fun theButtonArcLiesInsideTheCircleBubbleBelowTheCaption() {
+        // Smallest circle (160 dp at 3x = 480 px) up to a large one; caption band 44 dp = 132 px at the top.
+        for (d in listOf(480, 540, 600, 900)) {
+            val row = BackstageMiniGeometry.buttonRow(d, d, circle = true, towardLeft = true, 5, size, gap, inset, top = 132)
+            val boxes = row.map { assertNotNull(it, "all five fit in circle $d") }
+            assertApart(boxes, "circle $d")
+            boxes.forEach { box ->
+                assertEquals(size, box.width)
+                // The target's disc (>= 40 dp) inside the bubble, inset from the rim; its corners may belong to the phone.
+                assertTrue(BackstageMiniGeometry.discInside(box, d / 2.0, d / 2.0, d / 2.0 - inset), "$box in circle $d")
+                assertTrue(BackstageMiniGeometry.inOval((box.left + box.right) / 2f, (box.top + box.bottom) / 2f, d, d))
+                assertTrue(box.top >= 132, "below the caption: $box in $d")
+            }
+            // Symmetric about the vertical centre line, left to right, the middle ones lowest (a smile along the rim).
+            assertEquals(d - boxes[4].right, boxes[0].left, "symmetric in $d")
+            assertTrue(boxes.zipWithNext().all { (a, b) -> a.left < b.left })
+            assertTrue(boxes[1].top > boxes[0].top && boxes[2].top > boxes[1].top && boxes[3].top > boxes[4].top)
+            assertTrue(boxes[2].top > d / 2, "middle button below the centre: ${boxes[2]} in $d")
+        }
+        // The side does not matter for the circle.
+        assertEquals(
+            BackstageMiniGeometry.buttonRow(480, 480, circle = true, towardLeft = true, 5, size, gap, inset, top = 132),
+            BackstageMiniGeometry.buttonRow(480, 480, circle = true, towardLeft = false, 5, size, gap, inset, top = 132),
+        )
+    }
+
+    @Test
+    fun tooSmallTilesLayOutFewerSlots() {
+        // Below the minimum circle (120 dp = 360 px) the arc would rise into the caption: fewer slots are laid out (the
+        // ones at the end are null); BackstagePresentationPolicy.fitButtons decides which buttons get them.
+        val small = BackstageMiniGeometry.buttonRow(360, 360, circle = true, towardLeft = true, 4, size, gap, inset, top = 132)
+        assertEquals(4, small.size)
+        assertNotNull(small[0])
+        assertNull(small[3], "the last slot goes first: $small")
+        val shown = small.filterNotNull()
+        assertTrue(shown.size in 1..3)
+        assertApart(shown, "small circle")
+        shown.forEach { assertTrue(BackstageMiniGeometry.discInside(it, 180.0, 180.0, 180.0 - inset)) }
+        // A rounded tile narrower than the row (never laid out like that: 220 dp minimum) keeps what fits.
+        val narrow = BackstageMiniGeometry.buttonRow(400, 300, circle = false, towardLeft = false, 4, size, gap, inset, top = 66)
+        assertEquals(listOf(true, true, true, false), narrow.map { it != null })
+        assertApart(narrow.filterNotNull(), "narrow rounded")
+        // Three buttons (no chat panel registered) fit everywhere four do.
+        assertTrue(BackstageMiniGeometry.buttonRow(420, 420, circle = true, towardLeft = true, 3, size, gap, inset, top = 132).all { it != null })
+        // Not even one fits: the first one, clamped into the view, nothing else.
+        val tiny = BackstageMiniGeometry.buttonRow(80, 60, circle = false, towardLeft = false, 4, size, gap, inset, top = 66)
+        val first = assertNotNull(tiny[0])
+        assertTrue(first.left >= 0 && first.top >= 0 && first.right <= 80 && first.bottom <= 60)
+        assertEquals(listOf(null, null, null), tiny.drop(1))
+        assertEquals(emptyList(), BackstageMiniGeometry.buttonRow(540, 370, false, true, 0, size, gap, inset, 66))
+    }
+
+    @Test
+    fun theSmallestTilesOfTheRealSpecFitAllFiveButtons() {
+        // dp sizes of BackstageUi at common densities: the rounded minimum width and the circle minimum diameter.
+        for (density in listOf(2.0, 2.625, 3.0, 3.5, 4.0)) {
+            fun px(dp: Int) = (dp * density).roundToInt()
+            val s = px(BackstageUi.BUTTON_DP)
+            val g = px(BackstageUi.BUTTON_GAP_DP)
+            val i = px(BackstageUi.BUTTON_INSET_DP)
+            val rounded = BackstageMiniGeometry.buttonRow(
+                px(BackstageUi.MIN_WIDTH_DP), px(101) + px(BackstageUi.GRIP_DP), circle = false, towardLeft = true,
+                count = 5, size = s, gap = g, inset = i, top = px(BackstageUi.GRIP_DP),
+            )
+            assertTrue(rounded.all { it != null }, "rounded minimum at $density: $rounded")
+            val d = px(BackstageUi.MIN_CIRCLE_DP)
+            val circle = BackstageMiniGeometry.buttonRow(
+                d, d, circle = true, towardLeft = true, count = 5, size = s, gap = g, inset = i, top = px(BackstageUi.CIRCLE_CAPTION_DP),
+            )
+            assertTrue(circle.all { it != null }, "circle minimum at $density: $circle")
+            assertTrue(s >= px(40), "touch target >= 40 dp")
+        }
+    }
+
+    @Test
+    fun theChatPanelCountsLikeTheKeyboard() {
+        val input = android.view.accessibility.AccessibilityWindowInfo.TYPE_INPUT_METHOD
+        // Panel alone: the tile keeps clear of its top edge.
+        assertEquals(BackstageMiniObstacles.State(1700, false), BackstageMiniObstacles.from(emptyList(), 2400, panelTop = 1700))
+        // Panel above the keyboard (it grows with it): the higher edge wins; without the panel only the keyboard.
+        val keyboard = listOf(BackstageMiniObstacles.Window(input, 0, 1500, 1080, 2400))
+        assertEquals(BackstageMiniObstacles.State(1100, false), BackstageMiniObstacles.from(keyboard, 2400, panelTop = 1100))
+        assertEquals(BackstageMiniObstacles.State(1500, false), BackstageMiniObstacles.from(keyboard, 2400, panelTop = null))
+        // The tile then sits above the panel (avoidBottom, like the keyboard).
+        val tile = BackstageMiniGeometry.defaultTile(portrait, spec)
+        val shown = assertNotNull(BackstageMiniGeometry.avoidBottom(tile, portrait, spec, 1100))
+        assertTrue(shown.y + shown.height <= 1100)
+    }
+
+    @Test
+    fun keyboardAndCoveringSystemUiAreReadFromThePhoneWindows() {
+        val input = android.view.accessibility.AccessibilityWindowInfo.TYPE_INPUT_METHOD
+        val system = android.view.accessibility.AccessibilityWindowInfo.TYPE_SYSTEM
+        val app = android.view.accessibility.AccessibilityWindowInfo.TYPE_APPLICATION
+        val bars = listOf(
+            BackstageMiniObstacles.Window(system, 0, 0, 1080, 80),       // status bar
+            BackstageMiniObstacles.Window(system, 0, 2340, 1080, 2400),  // navigation bar
+            BackstageMiniObstacles.Window(app, 0, 0, 1080, 2400),
+        )
+        assertEquals(BackstageMiniObstacles.NONE, BackstageMiniObstacles.from(bars, 2400))
+        val typing = bars + BackstageMiniObstacles.Window(input, 0, 1500, 1080, 2400) +
+            BackstageMiniObstacles.Window(input, 0, 1600, 0, 1600) // empty: ignored
+        assertEquals(BackstageMiniObstacles.State(1500, false), BackstageMiniObstacles.from(typing, 2400))
+        val shade = bars + BackstageMiniObstacles.Window(system, 0, 0, 1080, 2400)
+        assertEquals(BackstageMiniObstacles.State(null, true), BackstageMiniObstacles.from(shade, 2400))
+    }
+}
diff --git a/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstageOrderedLaneTest.kt b/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstageOrderedLaneTest.kt

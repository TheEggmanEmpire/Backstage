+package moe.n4tsu.dextop
+
+import android.view.accessibility.AccessibilityEvent
+import java.io.File
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+/**
+ * Backstage's overlay adds event types to MirrorService's accessibility configuration for its agent; MirrorService's own
+ * handler must keep seeing exactly the types upstream's configuration requests.
+ */
+class BackstageAccessibilityEventsTest {
+    private val names = mapOf(
+        "typeViewClicked" to AccessibilityEvent.TYPE_VIEW_CLICKED,
+        "typeViewLongClicked" to AccessibilityEvent.TYPE_VIEW_LONG_CLICKED,
+        "typeViewSelected" to AccessibilityEvent.TYPE_VIEW_SELECTED,
+        "typeViewFocused" to AccessibilityEvent.TYPE_VIEW_FOCUSED,
+        "typeViewTextChanged" to AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED,
+        "typeWindowStateChanged" to AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED,
+        "typeNotificationStateChanged" to AccessibilityEvent.TYPE_NOTIFICATION_STATE_CHANGED,
+        "typeViewHoverEnter" to AccessibilityEvent.TYPE_VIEW_HOVER_ENTER,
+        "typeViewHoverExit" to AccessibilityEvent.TYPE_VIEW_HOVER_EXIT,
+        "typeWindowContentChanged" to AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED,
+        "typeViewScrolled" to AccessibilityEvent.TYPE_VIEW_SCROLLED,
+        "typeViewTextSelectionChanged" to AccessibilityEvent.TYPE_VIEW_TEXT_SELECTION_CHANGED,
+        "typeAnnouncement" to AccessibilityEvent.TYPE_ANNOUNCEMENT,
+        "typeWindowsChanged" to AccessibilityEvent.TYPE_WINDOWS_CHANGED,
+        "typeAllMask" to -1,
+    )
+
+    @Test fun upstreamTypesMatchUpstreamsConfiguration() {
+        // Unit tests run in the module directory: this is upstream's file, which the Backstage overlay replaces in the APK.
+        val xml = File("src/main/res/xml/mirror_accessibility_service.xml").readText()
+        val declared = Regex("""accessibilityEventTypes="([^"]*)"""").find(xml)!!.groupValues[1]
+        val mask = declared.split('|').map { it.trim() }.fold(0) { acc, name ->
+            acc or (names[name] ?: error("unknown event type $name in upstream's configuration"))
+        }
+        assertEquals(mask, BackstageAccessibilityEvents.UPSTREAM_TYPES,
+            "upstream changed its accessibility event types: update BackstageAccessibilityEvents and the overlay XML")
+    }
+
+    @Test fun onlyTheAgentsExtraTypesBypassMirrorService() {
+        assertTrue(BackstageAccessibilityEvents.forUpstream(AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED))
+        assertTrue(BackstageAccessibilityEvents.forUpstream(AccessibilityEvent.TYPE_WINDOWS_CHANGED))
+        assertTrue(BackstageAccessibilityEvents.forUpstream(AccessibilityEvent.TYPE_VIEW_CLICKED))
+        assertFalse(BackstageAccessibilityEvents.forUpstream(AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED))
+        assertFalse(BackstageAccessibilityEvents.forUpstream(AccessibilityEvent.TYPE_VIEW_SCROLLED))
+        assertFalse(BackstageAccessibilityEvents.forUpstream(AccessibilityEvent.TYPE_NOTIFICATION_STATE_CHANGED))
+    }
+}
diff --git a/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstageMiniGeometryTest.kt b/android/app/src/test/kotlin/moe/n4tsu/dextop/BackstageMiniGeometryTest.kt

+        /** Called after the window moved/resized: handle side faces the screen centre. */
+        fun onTileMoved() {
+            val params = backstageMiniParams ?: return
+            val area = backstageScreenArea()
+            val onLeft = params.x + params.width / 2 > (area.left + area.right) / 2
+            if (onLeft != handleOnLeft) {
+                handleOnLeft = onLeft
+                // The button row follows the handle side.
+                requestLayout()
+            }
+            invalidate()
+        }

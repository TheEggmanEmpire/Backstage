+    private fun backstagePresentationBlocker(): String? = when {
+        !backstageEnabled() -> "backstage_disabled"
+        !active || stopping -> "no_session"
+        autoOnlySession -> "auto_session"
+        phoneOwnedDisplay == null || targetDisplayId < 0 -> "not_direct_display"
+        displayCreationInProgress -> "display_starting"
+        laptopModeActive -> "laptop_mode"
+        externalOutput != null || phoneRegion != null -> "external_output"
+        demoMode || pausedForAndroid -> "unavailable"
+        !BackstagePresentationPolicy.hostless(backstagePresentation) && (root == null || surfaceView == null) -> "no_host_window"
+        else -> null
+    }

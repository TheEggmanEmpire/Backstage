+    /**
+     * [hidden]: system UI (shade, quick settings, a system dialog) covers the screen, or there is no room above the phone
+     * keyboard: the tile is invisible and touches pass through it to the phone (the Surface stays bound).
+     */
+    private fun backstageMiniWindowParams(
+        tile: BackstageMiniGeometry.Tile,
+        hidden: Boolean = false,
+    ): WindowManager.LayoutParams {
+        val params = backstageMiniParams ?: WindowManager.LayoutParams(
+            tile.width,
+            tile.height,
+            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+            // NOT_FOCUSABLE implies NOT_TOUCH_MODAL: touches outside the tile reach the phone.
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
+            PixelFormat.TRANSLUCENT
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+            fitInsetsTypes = 0
+            setFitInsetsIgnoringVisibility(true)
+            title = "Backstage mini desktop"
+        }.also { backstageMiniParams = it }
+        params.width = tile.width
+        params.height = tile.height
+        params.x = tile.x
+        params.y = tile.y
+        params.flags = (params.flags and WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON.inv()) or
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+        params.flags = if (hidden) params.flags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+            else params.flags and WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE.inv()
+        params.alpha = if (hidden) 0f else 1f

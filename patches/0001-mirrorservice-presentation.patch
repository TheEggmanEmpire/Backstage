+        }
+        if (previous != BackstagePresentation.FULL) {
+            OperationLog.i(this, "Backstage", "presentation ${previous.name} reset to FULL reason=$reason")
+        }
+        postMainDelayed(0L) { backstageNotifyListeners() }
+    }

+/**
+ * One ordered background lane . The MINI tile forwards the user's touches while the phone is in use, and
+ * InputDispatcher waits for each injection result (a binder round trip that stalls while the system input dispatcher
+ * waits on the desktop): the main thread posts the events here instead of waiting. [idle] is true when nothing posted
+ * is left, so a later synchronous send can never overtake an earlier queued one. A failing task never stops the lane.
+ */
+internal class BackstageOrderedLane(private val executor: java.util.concurrent.Executor) {
+    private val pending = java.util.concurrent.atomic.AtomicInteger()
+
+    fun idle(): Boolean = pending.get() == 0
+
+    /** Runs [task] after every task posted before it; false (nothing will run) when the executor refused it. */
+    fun post(onError: (Throwable) -> Unit = {}, task: () -> Unit): Boolean {
+        pending.incrementAndGet()
+        return try {
+            executor.execute {
+                try {
+                    task()
+                } catch (error: Throwable) {
+                    runCatching { onError(error) }
+                } finally {
+                    pending.decrementAndGet()
+                }
+            }
+            true
+        } catch (error: java.util.concurrent.RejectedExecutionException) {
+            pending.decrementAndGet()
+            runCatching { onError(error) }
+            false
+        }
+    }
+
+    companion object {
+        /** Process-wide (one daemon thread for every MirrorService instance): touches the MINI tile forwards. */
+        val miniInput: BackstageOrderedLane by lazy {
+            BackstageOrderedLane(
+                java.util.concurrent.Executors.newSingleThreadExecutor { task ->
+                    Thread(task, "Backstage-mini-input").apply { isDaemon = true }
+                }
+            )
+        }
+    }
+}

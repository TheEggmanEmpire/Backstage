+    /** API entry (main thread): defers MINI/FULL while the phone is locked, so nothing draws over the keyguard. */
+    private fun backstageRequestPresentation(target: BackstagePresentation, reason: String): Boolean {
+        if (instance !== this) return false
+        if (!BackstagePresentationPolicy.allowedWhileLocked(target) && backstagePhoneLocked()) {
+            if (!backstageSessionActive()) return false
+            val hidden = backstagePresentation == BackstagePresentation.HIDDEN ||
+                backstageApplyPresentation(BackstagePresentation.HIDDEN, "$reason;locked")
+            if (hidden) {
+                backstageLockRestore = target
+                // No SCREEN_ON will follow while the screen is already on (keyguard showing, or a grace-period lock).
+                if (backstagePhoneScreenOn()) {
+                    backstageAwaitUnlock(++backstageUnlockGeneration, 0)

+    private fun backstageEnterMini(): Boolean {
+        val frame = root ?: return false
+        val surface = surfaceView ?: return false
+        val content = laptopContent ?: return false
+        if (menu?.visibility == View.VISIBLE) toggleMenu()
+        cancelDesktopTouchStream()
+        backstagePresentation = BackstagePresentation.MINI
+        backstageReleasePhoneControl()
+        backstageApplyMiniWindow(frame, surface, content)
+        return true
+    }

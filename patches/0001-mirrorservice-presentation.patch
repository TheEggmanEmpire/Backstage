+    /**
+     * A change that failed part-way must not leave a half-applied state (a full-screen host with the phone's
+     * navigation released, or a tile without the phone handed back). From HIDDEN the display is parked again;
+     * otherwise FULL (upstream's own state) is restored; if even that fails, HIDDEN draws nothing over the phone.
+     */
+    private fun backstageRecover(previous: BackstagePresentation, target: BackstagePresentation) {
+        val leftovers = backstageFullParams != null || backstageMiniChrome != null
+        val recovered = runCatching {
+            when (BackstagePresentationPolicy.recovery(previous, backstagePresentation, target, leftovers)) {
+                BackstagePresentationPolicy.Recovery.NONE -> Unit
+                // The display already moved to the sink: finish HIDDEN, never leave a host showing a frozen frame.
+                BackstagePresentationPolicy.Recovery.FINISH_HIDDEN -> {
+                    runCatching { backstageReleasePhoneControl() }
+                    if (root != null) detachHostWindow()
+                    releaseMirror()
+                }
+                BackstagePresentationPolicy.Recovery.PARK_HIDDEN -> {
+                    // Through FULL so that enterHidden also releases whatever the partial change took.
+                    backstagePresentation = BackstagePresentation.FULL
+                    check(backstageEnterHidden())
+                }
+                BackstagePresentationPolicy.Recovery.FORCE_FULL -> backstageForceFull()
+            }
+        }.onFailure { OperationLog.e(this, "Backstage", "presentation recovery from ${previous.name} failed", it) }
+        if (recovered.isFailure && backstagePresentation != BackstagePresentation.HIDDEN) {
+            runCatching { backstageEnterHidden() }
+                .onFailure { OperationLog.e(this, "Backstage", "presentation recovery to HIDDEN failed", it) }
+        }
+        OperationLog.w(this, "Backstage", "presentation recovered to ${backstagePresentation.name} after a failed change", null)
+    }

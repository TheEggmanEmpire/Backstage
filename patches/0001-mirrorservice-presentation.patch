+    private fun backstageResetPresentation(reason: String) {
+        val previous = backstagePresentation
+        backstageCreatedProfile = null
+        backstageRequestedFlags = 0
+        backstageEffectiveFlags = 0
+        backstageRichRejection = null
+        backstagePresentation = BackstagePresentation.FULL
+        backstageLockRestore = null
+        backstageUnlockGeneration += 1
+        backstageDecorationsForced = false
+        backstageDirectFailed = false
+        backstageBackgroundSession = false
+        backstagePlayerBound = false
+        backstageMiniChrome = null
+        backstageMiniParams = null
+        backstageFullParams = null
+        backstageMiniLayoutSize = null
+        backstageMiniHome = null
+        backstageMiniObstacles = BackstageMiniObstacles.NONE
+        backstageKeyguardWatchGeneration += 1
+        // A parked cursor window is already removed from WindowManager when MINI began.
+        backstageParkedCursor = null
+        val sink = backstageSink
+        backstageSink = null
+        // The display may still render into the sink until it is released/rebound by the caller.
+        if (sink != null) postMainDelayed(BackstageUi.SINK_CLOSE_DELAY_MS) { sink.close() }

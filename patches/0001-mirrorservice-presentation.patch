+    /** the circle tile's transparent corners let touches through to the phone (null: not limited). */
+    private var backstageCircleTouch: BackstageCircleTouchRegion? = null
+
+    private fun backstageSetCircleTouch(frame: View?, circle: Boolean) {
+        val current = backstageCircleTouch
+        if (circle && frame != null && current?.view === frame) return
+        current?.remove()
+        backstageCircleTouch = if (circle && frame != null) BackstageCircleTouchRegion(frame).also { it.install() } else null
+    }

@@ -0,0 +1,21 @@
+package moe.n4tsu.dextop
+
+import android.content.Context
+import android.content.Intent
+
+/**
+ * Backstage fork identity: Dextop's own "open Dextop" intents (pairing result, Linux store and
+ * session notifications, app restart). Upstream builds them with getLaunchIntentForPackage(own package), i.e. the
+ * package's launcher activity. A fork whose only launcher icon is another activity (Backstage: its agent; the overlay
+ * removes the LAUNCHER filter of DextopLauncherActivity) would open that activity instead of Dextop's UI, so the intent
+ * names Dextop's launcher trampoline explicitly, with the fields of the package's
+ * launcher intent (MAIN + LAUNCHER, the package, NEW_TASK). Nullable like the call it replaces; preserves upstream ids.
+ */
+internal object DextopLaunchIntent {
+    fun forOwnUi(context: Context): Intent? =
+        Intent(Intent.ACTION_MAIN)
+            .addCategory(Intent.CATEGORY_LAUNCHER)
+            .setPackage(context.packageName)
+            .setClassName(context.packageName, DextopLauncherActivity::class.java.name)
+            .setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+}

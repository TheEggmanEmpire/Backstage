+    /**
+     * Fork builds (non-empty [forkCertificates], comma-separated SHA-256) trust ONLY their own companion packages
+     * signed with their own keys, never the official companions or certificates; otherwise the official identity.
+     */
+    internal fun trustedIdentity(forkPackages: Set<String>, forkCertificates: String): Pair<Set<String>, Set<String>> {

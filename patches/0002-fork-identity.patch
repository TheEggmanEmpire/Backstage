diff --git a/android/app/src/main/kotlin/moe/n4tsu/dextop/privilege/ShellPaths.kt b/android/app/src/main/kotlin/moe/n4tsu/dextop/privilege/ShellPaths.kt
new file mode 100644
index 0000000000000000000000000000000000000000..747760308f82ce2788ec787d2a28449da038ed7e
--- /dev/null
+++ b/android/app/src/main/kotlin/moe/n4tsu/dextop/privilege/ShellPaths.kt
@@ -0,0 +1,17 @@
+package moe.n4tsu.dextop.privilege
+
+/**
+ * Names under the shell-owned /data/local/tmp. Upstream Dextop keeps its historical names;
+ * any other application id (a fork) gets its own prefix so both can be installed side by side
+ * without overwriting each other's extracted libraries, logs or Linux containers.
+ */
+object ShellPaths {
+    private val upstreamPackages = setOf("moe.n4tsu.dextop", "moe.n4tsu.gpdextop")
+
+    /** "dextop" for upstream Dextop, "dextop-<packageName>" for any other application id. */
+    @JvmStatic fun prefix(packageName: String): String =
+        if (packageName in upstreamPackages) "dextop" else "dextop-$packageName"
+
+    /** Shell-side Linux data root of [packageName]: /data/local/tmp/dextop/linux for upstream. */
+    @JvmStatic fun linuxBase(packageName: String): String = "/data/local/tmp/${prefix(packageName)}/linux"
+}
diff --git a/android/app/src/test/kotlin/moe/n4tsu/dextop/CardCompanionForkTrustTest.kt b/android/app/src/test/kotlin/moe/n4tsu/dextop/CardCompanionForkTrustTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..b3d369c29c5ef18be172d85923c43d0a6fe3a4d8
--- /dev/null
+++ b/android/app/src/test/kotlin/moe/n4tsu/dextop/CardCompanionForkTrustTest.kt
@@ -0,0 +1,39 @@
+package moe.n4tsu.dextop
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+/** A fork trusts only its own companions signed with its own keys. */
+class CardCompanionForkTrustTest {
+    private val official = "847833703f59daa31c28705ae694f1ceb11b6d0d4d1e93a5997c01a5303c34c5"
+    private val forkCertificate = "ab12"
+    private val forkPackages = setOf("com.eggman.backstage.cardex", "com.eggman.backstage.cardex.driving")
+
+    @Test fun withoutForkCertificatesTheOfficialIdentityApplies() {
+        val (packages, certificates) = CardCompanionCallerVerifier.trustedIdentity(forkPackages, " , ")
+        assertTrue("moe.n4tsu.dextop.cardex" in packages)
+        assertTrue(official in certificates)
+    }
+
+    @Test fun forkTrustsOnlyItsOwnPackagesAndCertificates() {
+        val (packages, certificates) = CardCompanionCallerVerifier.trustedIdentity(forkPackages + "", " AB12 ")
+        assertEquals(forkPackages, packages)
+        assertEquals(setOf(forkCertificate), certificates)
+        fun trusted(callerPackages: Set<String>, callerCertificate: String) =
+            CardCompanionCallerVerifier.matchesIdentity(callerPackages, setOf(callerCertificate), packages, certificates)
+        assertTrue(trusted(setOf("com.eggman.backstage.cardex"), "AB12"))
+        assertTrue(trusted(setOf("com.eggman.backstage.cardex.driving"), forkCertificate))
+        // Official companion, official certificate, or a fork package signed by somebody else: all refused.
+        assertFalse(trusted(setOf("moe.n4tsu.dextop.cardex"), official))
+        assertFalse(trusted(setOf("moe.n4tsu.dextop.cardex"), forkCertificate))
+        assertFalse(trusted(setOf("com.eggman.backstage.cardex"), official))
+        assertFalse(trusted(setOf("com.eggman.backstage.cardex.fake"), forkCertificate))
+    }
+
+    @Test fun officialMatchIsUnchangedForUpstreamBuilds() {
+        assertTrue(CardCompanionCallerVerifier.matchesOfficialIdentity(setOf("moe.n4tsu.dextop.cardex"), setOf(official)))
+        assertFalse(CardCompanionCallerVerifier.matchesOfficialIdentity(forkPackages, setOf(official)))
+    }
+}

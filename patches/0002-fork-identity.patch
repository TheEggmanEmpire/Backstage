@@ -0,0 +1,27 @@
+package moe.n4tsu.dextop.linux
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+/** Backstage (fork identity): a UserService-hosted service binds the per-package root too. */
+class LinuxServiceHostForkTest {
+    @Test fun shellHostedServicesServeTheirOwnApplicationId() {
+        assertEquals("com.eggman.backstage", LinuxServiceHost.shellHostPackage(2000, null, "com.eggman.backstage"))
+        assertEquals("com.eggman.backstage", LinuxServiceHost.shellHostPackage(0, "com.eggman.backstage", "moe.n4tsu.dextop"))
+        assertEquals("moe.n4tsu.dextop", LinuxServiceHost.shellHostPackage(2000, " ", "moe.n4tsu.dextop"))
+        assertNull(LinuxServiceHost.shellHostPackage(10_123, "com.eggman.backstage", "com.eggman.backstage"))
+    }
+
+    @Test fun bindHostSelectsThePerPackageLinuxRoot() {
+        try {
+            LinuxServiceHost.bindHost("com.eggman.backstage")
+            assertEquals("com.eggman.backstage", LinuxServiceHost.hostPackage)
+            assertEquals(java.io.File("/data/local/tmp/dextop-com.eggman.backstage/linux"), LinuxPaths.base)
+            assertEquals(java.io.File("/data/local/tmp/dextop-com.eggman.backstage/linux/containers"), LinuxPaths.containers)
+        } finally {
+            LinuxServiceHost.bindHost("moe.n4tsu.dextop")
+        }
+        assertEquals(java.io.File("/data/local/tmp/dextop/linux"), LinuxPaths.base)
+    }
+}

+package moe.n4tsu.dextop.privilege
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class ShellPathsTest {
+    @Test fun upstreamKeepsHistoricalNames() {
+        assertEquals("dextop", ShellPaths.prefix("moe.n4tsu.dextop"))
+        assertEquals("dextop", ShellPaths.prefix("moe.n4tsu.gpdextop"))
+        assertEquals("/data/local/tmp/dextop/linux", ShellPaths.linuxBase("moe.n4tsu.dextop"))
+    }
+
+    @Test fun forksGetTheirOwnNames() {
+        assertEquals("dextop-com.eggman.backstage", ShellPaths.prefix("com.eggman.backstage"))
+        assertEquals("/data/local/tmp/dextop-com.eggman.backstage/linux", ShellPaths.linuxBase("com.eggman.backstage"))
+    }
+}

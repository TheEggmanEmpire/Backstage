index 0000000000000000000000000000000000000000..79b326e629086087cb4a000de64f474fba65bd96
--- /dev/null
+++ b/test/backstage_no_google_sdks_test.dart
@@ -0,0 +1,55 @@
+// Backstage (patch no-google-sdks): the app links no Firebase, Google Analytics or Google Play Core SDK.
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:free_dextop/analytics_service.dart';
+
+void main() {
+  test('analytics calls complete without any SDK behind them', () async {
+    await AppAnalytics.initialize();
+    await AppAnalytics.screen('home');
+    await AppAnalytics.event('desktop_start', {'mode': 'mini', 'secure': true});
+  });
+
+  test('no closed-source Google SDK package is a dependency', () {
+    // An upstream update that adds one back must fail here, not ship silently.
+    final pubspec = File('pubspec.yaml').readAsStringSync();
+    final lock = File('pubspec.lock').readAsStringSync();
+    for (final package in [
+      'firebase_core',
+      'firebase_analytics',
+      'firebase_crashlytics',
+      'firebase_messaging',
+      'in_app_update',
+      'in_app_review',
+      'google_mobile_ads',
+    ]) {
+      expect(
+        RegExp('^\\s+$package:', multiLine: true).hasMatch(pubspec),
+        isFalse,
+        reason: '$package in pubspec.yaml',
+      );
+      expect(
+        RegExp('^  $package:', multiLine: true).hasMatch(lock),
+        isFalse,
+        reason: '$package in pubspec.lock',
+      );
+    }
+    expect(lock.contains('_flutterfire_internals'), isFalse);
+  });
+
+  test('the Android build applies no google-services plugin', () {
+    for (final path in [
+      'android/settings.gradle.kts',
+      'android/app/build.gradle.kts',
+    ]) {
+      expect(
+        File(path)
+            .readAsStringSync()
+            .contains('com.google.gms.google-services'),
+        isFalse,
+        reason: path,
+      );
+    }
+  });
+}

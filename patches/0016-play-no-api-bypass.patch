--- /dev/null
+++ b/android/app/src/play/kotlin/moe/n4tsu/dextop/HiddenApi.kt
@@ -0,0 +1,10 @@
+package moe.n4tsu.dextop
+
+/**
+ * The Google Play build ships no API-bypass library: hidden APIs stay subject to the platform's normal policy,
+ * so calls that need one fail and take their existing fallback.
+ */
+object HiddenApi {
+    @Suppress("UNUSED_PARAMETER")
+    fun exempt(vararg prefixes: String): Boolean = false
+}

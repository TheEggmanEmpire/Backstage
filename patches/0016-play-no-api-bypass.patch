--- /dev/null
+++ b/android/app/src/play/kotlin/moe/n4tsu/dextop/privilege/DistributionPrivilegeBootstrap.kt
@@ -0,0 +1,34 @@
+package moe.n4tsu.dextop.privilege
+
+import android.content.Context
+
+/**
+ * The Google Play build has no built-in Wireless debugging pairing: privilege comes from an external
+ * Shizuku-compatible provider (Stellar, Shizuku Plus). A privileged runtime that is already running is still used.
+ */
+object DistributionPrivilegeBootstrap : EmbeddedPrivilegeContract {
+    override val included: Boolean = false
+
+    private const val UNAVAILABLE = "Wireless debugging pairing is not part of this build; use Stellar or Shizuku Plus."
+
+    fun hasStoredPairing(context: Context): Boolean = false
+
+    fun showPairingNotification(context: Context) = Unit
+
+    fun beginPairingDiscovery(context: Context) = Unit
+
+    fun dismissPairingNotification(context: Context) = Unit
+
+    fun cancelPairingDiscovery() = Unit
+
+    fun pairingState(): String = EmbeddedPairingNotification.state
+
+    override suspend fun pair(context: Context, code: String): EmbeddedPrivilegeContract.PairingResult =
+        EmbeddedPrivilegeContract.PairingResult(paired = false, detail = UNAVAILABLE)
+
+    suspend fun canConnect(context: Context): Boolean = false
+
+    override suspend fun connectAndStart(context: Context): EmbeddedPrivilegeContract.StartResult =
+        if (DistributionPrivilegeRuntime.available) EmbeddedPrivilegeContract.StartResult(started = true)
+        else EmbeddedPrivilegeContract.StartResult(started = false, detail = UNAVAILABLE)
+}

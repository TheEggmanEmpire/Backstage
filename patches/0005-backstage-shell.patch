diff --git a/test/backstage_shell_test.dart b/test/backstage_shell_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..ddf339741cd10eaab4abf04fc2959a9425f381d2
--- /dev/null
+++ b/test/backstage_shell_test.dart
@@ -0,0 +1,448 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:free_dextop/main.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+// Backstage (patch 0005-backstage-shell): the Agent destination and the live desktop player on Home.
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  const display = MethodChannel('app.freedextop/display');
+  const shell = MethodChannel('com.eggman.backstage/shell');
+  final messenger =
+      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+  late List<MethodCall> shellCalls;
+  late Map<String, Object?> shellState;
+  String? coldPage;
+  var automaticSucceeds = true;
+  var previewOwned = false;
+
+  setUp(() {
+    shellCalls = [];
+    coldPage = null;
+    automaticSucceeds = true;
+    previewOwned = false;
+    shellState = {
+      'playerAllowed': true,
+      'running': false,
+      'presentation': 'none',
+      'width': 0,
+      'height': 0,
+      'privileged': true,
+      'textureId': null,
+    };
+    SharedPreferences.setMockInitialValues({'setup_completed': true});
+    messenger.setMockMethodCallHandler(display, (call) async {
+      if (call.method == 'status') {
+        return {
+          'active': false,
+          'privileged': true,
+          'shizukuInstalled': true,
+          'shizukuRunning': true,
+          'shizukuGranted': true,
+        };
+      }
+      return null;
+    });
+    messenger.setMockMethodCallHandler(shell, (call) async {
+      shellCalls.add(call);
+      switch (call.method) {
+        case 'takeShellPage':
+          final page = coldPage;
+          coldPage = null;
+          return page;
+        case 'previewShow':
+          if (automaticSucceeds && shellState['presentation'] == 'hidden') {
+            previewOwned = true;
+            shellState = {...shellState, 'presentation': 'in_app'};
+            return true;
+          }
+          return false;
+        case 'previewRestore':
+          if (previewOwned && shellState['presentation'] == 'in_app') {
+            shellState = {...shellState, 'presentation': 'hidden'};
+          }
+          previewOwned = false;
+          return true;
+        case 'present':
+          previewOwned = false;
+          shellState = {
+            ...shellState,
+            'presentation': (call.arguments as Map)['presentation'],
+          };
+          return true;
+        case 'state':
+          return shellState;
+        case 'playerAttach':
+          return {'textureId': 7, 'width': 1920, 'height': 1080};
+      }
+      return true;
+    });
+  });
+
+  tearDown(() {
+    messenger.setMockMethodCallHandler(display, null);
+    messenger.setMockMethodCallHandler(shell, null);
+  });
+
+  Future<void> settle(WidgetTester tester) async {
+    for (var frame = 0; frame < 12; frame++) {
+      await tester.pump(const Duration(milliseconds: 50));
+    }
+  }
+
+  testWidgets('Home is Backstage with an Agent destination second', (
+    tester,
+  ) async {
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(find.text('Backstage'), findsWidgets);
+    final bar = tester.widget<NavigationBar>(find.byType(NavigationBar));
+    expect(bar.destinations.length, 4);
+    expect((bar.destinations[1] as NavigationDestination).label, 'Agent');
+    expect(bar.selectedIndex, 0);
+
+    // Agent opens the agent screen; the page stays Home.
+    await tester.tap(find.text('Agent'));
+    await settle(tester);
+    expect(shellCalls.where((c) => c.method == 'openAgent'), isNotEmpty);
+    expect(
+      tester.widget<NavigationBar>(find.byType(NavigationBar)).selectedIndex,
+      0,
+    );
+
+    // Dextop's own pages keep their order after it: Linux, then Settings.
+    await tester.tap(find.byIcon(Icons.tune_outlined));
+    await settle(tester);
+    expect(
+      tester.widget<NavigationBar>(find.byType(NavigationBar)).selectedIndex,
+      3,
+    );
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('without a desktop Home offers Start (in the app)', (
+    tester,
+  ) async {
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(find.byKey(const ValueKey('backstage-live-player')), findsOneWidget);
+    await tester.tap(find.byKey(const ValueKey('backstage-start-desktop')));
+    await settle(tester);
+    expect(shellCalls.where((c) => c.method == 'start'), isNotEmpty);
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('a running desktop plays in Home and takes touches', (
+    tester,
+  ) async {
+    shellState = {
+      ...shellState,
+      'running': true,
+      'presentation': 'in_app',
+      'width': 1920,
+      'height': 1080,
+    };
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(shellCalls.where((c) => c.method == 'playerAttach'), isNotEmpty);
+    expect(find.byType(Texture), findsOneWidget);
+    for (final label in ['Full screen', 'Pop out', 'Background', 'Stop']) {
+      expect(find.text(label), findsWidgets, reason: label);
+    }
+    await tester.tap(find.byType(Texture));
+    await settle(tester);
+    final touches = shellCalls.where((c) => c.method == 'touch').toList();
+    expect(
+      touches.map((c) => (c.arguments as Map)['action']),
+      containsAllInOrder([0, 2]),
+    );
+    await tester.ensureVisible(find.text('Pop out'));
+    await tester.pump();
+    await tester.tap(find.text('Pop out'));
+    await settle(tester);
+    expect(
+      shellCalls
+          .where((c) => c.method == 'present')
+          .map((c) => (c.arguments as Map)['presentation']),
+      contains('mini'),
+    );
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  test('automatic preview only borrows hidden while visible', () {
+    expect(
+      backstagePreviewAction('hidden', true, false),
+      BackstagePreviewAction.show,
+    );
+    expect(
+      backstagePreviewAction('hidden', false, false),
+      BackstagePreviewAction.none,
+    );
+    expect(
+      backstagePreviewAction('in_app', false, true),
+      BackstagePreviewAction.restore,
+    );
+    expect(
+      backstagePreviewAction('in_app', true, true),
+      BackstagePreviewAction.none,
+    );
+    for (final mode in ['mini', 'full', 'none']) {
+      expect(
+        backstagePreviewAction(mode, true, false),
+        BackstagePreviewAction.none,
+      );
+      expect(
+        backstagePreviewAction(mode, false, true),
+        BackstagePreviewAction.none,
+      );
+    }
+  });
+
+  testWidgets(
+    'incoming shell page selects Linux and Settings without reopening Agent',
+    (tester) async {
+      await tester.pumpWidget(const DextopApp());
+      await settle(tester);
+      for (final entry in {'linux': 2, 'settings': 3, 'home': 0}.entries) {
+        await messenger.handlePlatformMessage(
+          shell.name,
+          const StandardMethodCodec().encodeMethodCall(
+            MethodCall('selectPage', entry.key),
+          ),
+          (_) {},
+        );
+        await settle(tester);
+        expect(
+          tester
+              .widget<NavigationBar>(find.byType(NavigationBar))
+              .selectedIndex,
+          entry.value,
+        );
+      }
+      await messenger.handlePlatformMessage(
+        shell.name,
+        const StandardMethodCodec().encodeMethodCall(
+          const MethodCall('selectPage', 'ai'),
+        ),
+        (_) {},
+      );
+      await settle(tester);
+      expect(
+        tester.widget<NavigationBar>(find.byType(NavigationBar)).selectedIndex,
+        0,
+      );
+      expect(shellCalls.where((c) => c.method == 'openAgent'), isEmpty);
+      await tester.pumpWidget(const SizedBox());
+    },
+  );
+
+  testWidgets('cold page survives until Home subscribes', (tester) async {
+    coldPage = 'settings';
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(
+      tester.widget<NavigationBar>(find.byType(NavigationBar)).selectedIndex,
+      3,
+    );
+    expect(find.text('Agent settings'), findsOneWidget);
+    await tester.tap(find.text('Agent settings'));
+    await settle(tester);
+    expect(
+      (shellCalls.lastWhere((c) => c.method == 'openAgent').arguments
+          as Map)['screen'],
+      'settings',
+    );
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('hidden auto-previews and restores when Linux or Agent opens', (
+    tester,
+  ) async {
+    shellState = {
+      ...shellState,
+      'running': true,
+      'presentation': 'hidden',
+      'width': 1920,
+      'height': 1080,
+    };
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(shellState['presentation'], 'in_app');
+    expect(find.byType(Texture), findsOneWidget);
+    await messenger.handlePlatformMessage(
+      shell.name,
+      const StandardMethodCodec().encodeMethodCall(
+        const MethodCall('selectPage', 'linux'),
+      ),
+      (_) {},
+    );
+    await settle(tester);
+    expect(shellState['presentation'], 'hidden');
+    await messenger.handlePlatformMessage(
+      shell.name,
+      const StandardMethodCodec().encodeMethodCall(
+        const MethodCall('selectPage', 'home'),
+      ),
+      (_) {},
+    );
+    await settle(tester);
+    expect(shellState['presentation'], 'in_app');
+    await tester.tap(find.text('Agent'));
+    await settle(tester);
+    expect(shellState['presentation'], 'hidden');
+    expect(shellCalls.where((c) => c.method == 'present'), isEmpty);
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('auto-preview restores on pause and reappears on return', (
+    tester,
+  ) async {
+    shellState = {
+      ...shellState,
+      'running': true,
+      'presentation': 'hidden',
+      'width': 1920,
+      'height': 1080,
+    };
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    expect(shellState['presentation'], 'in_app');
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
+    await settle(tester);
+    expect(shellState['presentation'], 'hidden');
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await settle(tester);
+    expect(shellState['presentation'], 'in_app');
+    await tester.ensureVisible(find.text('Pop out'));
+    await tester.pump();
+    await tester.tap(find.text('Pop out'));
+    await settle(tester);
+    expect(
+      shellState['presentation'],
+      'mini',
+      reason: shellCalls.map((c) => '${c.method}:${c.arguments}').join(', '),
+    );
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);
+    await settle(tester);
+    expect(
+      shellState['presentation'],
+      'mini',
+      reason: shellCalls.map((c) => '${c.method}:${c.arguments}').join(', '),
+    );
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('failure is debounced and keeps manual button', (tester) async {
+    automaticSucceeds = false;
+    shellState = {
+      ...shellState,
+      'running': true,
+      'presentation': 'hidden',
+      'width': 1920,
+      'height': 1080,
+    };
+    await tester.pumpWidget(const DextopApp());
+    await settle(tester);
+    await tester.pump(const Duration(seconds: 6));
+    await settle(tester);
+    expect(shellCalls.where((c) => c.method == 'previewShow').length, 1);
+    expect(
+      find.text('Running in the background. Show it here'),
+      findsOneWidget,
+    );
+    await tester.tap(find.text('Running in the background. Show it here'));
+    await settle(tester);
+    expect(shellState['presentation'], 'in_app');
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
+    await settle(tester);
+    expect(shellState['presentation'], 'in_app');
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await tester.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('MINI and FULL keep their explicit show button', (tester) async {
+    for (final presentation in ['mini', 'full']) {
+      shellCalls.clear();
+      shellState = {
+        ...shellState,
+        'running': true,
+        'presentation': presentation,
+        'width': 1920,
+        'height': 1080,
+      };
+      await tester.pumpWidget(const DextopApp());
+      await settle(tester);
+      expect(shellCalls.where((c) => c.method == 'previewShow'), isEmpty);
+      expect(find.byType(Texture), findsNothing);
+      expect(
+        find.text(
+          presentation == 'mini'
+              ? 'Playing in the popup. Show it here'
+              : 'Showing full screen. Show it here',
+        ),
+        findsOneWidget,
+      );
+      await tester.pumpWidget(const SizedBox());
+      await tester.pump();
+    }
+  });
+
+  testWidgets(
+    'wide shell keeps the same four destinations and accepts page delivery',
+    (tester) async {
+      tester.view.physicalSize = const Size(1000, 900);
+      tester.view.devicePixelRatio = 1;
+      addTearDown(tester.view.resetPhysicalSize);
+      addTearDown(tester.view.resetDevicePixelRatio);
+      await tester.pumpWidget(const DextopApp());
+      await settle(tester);
+      final rail = tester.widget<NavigationRail>(find.byType(NavigationRail));
+      expect(rail.destinations.map((d) => (d.label as Text).data).toList(), [
+        'Home',
+        'Agent',
+        'Linux',
+        'Settings',
+      ]);
+      await messenger.handlePlatformMessage(
+        shell.name,
+        const StandardMethodCodec().encodeMethodCall(
+          const MethodCall('selectPage', 'settings'),
+        ),
+        (_) {},
+      );
+      await settle(tester);
+      expect(
+        tester
+            .widget<NavigationRail>(find.byType(NavigationRail))
+            .selectedIndex,
+        3,
+      );
+      expect(find.text('Agent settings'), findsOneWidget);
+      await tester.pumpWidget(const SizedBox());
+    },
+  );
+
+  test('player points map to desktop pixels, clamped', () {
+    expect(
+      backstagePlayerToDesktop(
+        const Offset(50, 25),
+        const Size(100, 50),
+        1920,
+        1080,
+      ),
+      const Offset(960, 540),
+    );
+    expect(
+      backstagePlayerToDesktop(
+        const Offset(150, -5),
+        const Size(100, 50),
+        1920,
+        1080,
+      ),
+      const Offset(1919, 0),
+    );
+  });
+}

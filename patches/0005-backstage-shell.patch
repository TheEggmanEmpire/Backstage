diff --git a/lib/backstage_shell.dart b/lib/backstage_shell.dart
new file mode 100644
index 0000000000000000000000000000000000000000..8ca52f7b6e14d753b25e9527f7284b51236a3ce3
--- /dev/null
+++ b/lib/backstage_shell.dart
@@ -0,0 +1,500 @@
+part of 'main.dart';
+
+// Backstage (patch 0005-backstage-shell): the app shell around Dextop's Home.
+//
+// * One launcher icon "Backstage" opens this Home. Its second destination, "Agent", opens Backstage's agent screen
+//   (a native activity in the same task, shown without a transition); Dextop's own page indices stay unchanged.
+// * The live desktop plays at the top of Home: the running desktop renders into a Flutter texture (presentation
+//   IN_APP, see MirrorService.Backstage); touches on it go to the desktop. Full screen / Pop out / Background / Stop.
+//   Without a running desktop the card offers Start (in the app, never a full-screen takeover).
+// Native side: backstage/dextop-glue BackstageShell.kt on the channel below.
+
+const String backstageAppName = 'Backstage';
+const String backstageIconAsset = 'assets/backstage_icon.png';
+
+class BackstageShellBridge {
+  BackstageShellBridge._();
+
+  static const MethodChannel channel = MethodChannel(
+    'com.eggman.backstage/shell',
+  );
+  static final StreamController<void> _changes =
+      StreamController<void>.broadcast();
+  static final StreamController<String> _pages =
+      StreamController<String>.broadcast();
+  static final ValueNotifier<bool> homeVisible = ValueNotifier(false);
+  static bool _listening = false;
+
+  static void _listen() {
+    if (_listening) return;
+    _listening = true;
+    channel.setMethodCallHandler((call) async {
+      if (call.method == 'changed') _changes.add(null);
+      if (call.method == 'selectPage' &&
+          backstageShellPageIndex(call.arguments) != null &&
+          _pages.hasListener) {
+        _pages.add(call.arguments as String);
+        return true;
+      }
+      return false;
+    });
+  }
+
+  static Stream<void> get changes {
+    _listen();
+    return _changes.stream;
+  }
+
+  static Stream<String> get pages {
+    _listen();
+    return _pages.stream;
+  }
+
+  static Future<T?> invoke<T>(String method, [Object? arguments]) async {
+    try {
+      return await channel.invokeMethod<T>(method, arguments);
+    } on MissingPluginException {
+      return null;
+    } on PlatformException {
+      return null;
+    }
+  }
+
+  static Future<void> openAgent({bool settings = false}) =>
+      invoke<bool>('openAgent', {'screen': settings ? 'settings' : null});
+}
+
+/// A strict allow-list: these are the four-item shell indices accepted by backstageNavSelect.
+int? backstageShellPageIndex(Object? page) => switch (page) {
+  'home' => 0,
+  'linux' => 2,
+  'settings' => 3,
+  _ => null,
+};
+
+extension _BackstageShell on _HomeScreenState {
+  void backstageInit() {
+    if (!backstageAiTab) return;
+    BackstageShellBridge.homeVisible.value = page == 0;
+    backstagePageSubscription = BackstageShellBridge.pages.listen((target) {
+      if (mounted) backstageNavSelect(backstageShellPageIndex(target)!);
+    });
+    BackstageShellBridge.invoke<String>('takeShellPage').then((target) {
+      final index = backstageShellPageIndex(target);
+      if (mounted && index != null) backstageNavSelect(index);
+    });
+  }
+
+  void backstagePageSelected(int target) {
+    if (backstageAiTab) BackstageShellBridge.homeVisible.value = target == 0;
+  }
+
+  Widget backstageAiSettingsTile() => ListTile(
+    leading: const Icon(Icons.auto_awesome_outlined),
+    title: const Text('Agent settings'),
+    onTap: () {
+      BackstageShellBridge.homeVisible.value = false;
+      BackstageShellBridge.openAgent(settings: true);
+    },
+  );
+
+  /// The Agent destination exists on the phone UI; Dextop's UI inside the desktop window keeps its own three.
+  bool get backstageAiTab => !widget.desktopWindow;
+
+  /// Navigation index shown for Dextop's [page]: Home, Agent, Linux, Settings.
+  int backstageNavIndex(int page) =>
+      backstageAiTab && page >= 1 ? page + 1 : page;
+
+  void backstageNavSelect(int index) {
+    if (backstageAiTab && index == 1) {
+      BackstageShellBridge.homeVisible.value = false;
+      BackstageShellBridge.openAgent();
+      return;
+    }
+    selectPage(backstageAiTab && index > 1 ? index - 1 : index);
+  }
+
+  List<NavigationRailDestination> backstageRailDestinations() => [
+    if (backstageAiTab)
+      const NavigationRailDestination(
+        icon: Icon(Icons.auto_awesome_outlined),
+        selectedIcon: Icon(Icons.auto_awesome),
+        label: Text('Agent'),
+      ),
+  ];
+
+  List<NavigationDestination> backstageBarDestinations() => [
+    if (backstageAiTab)
+      const NavigationDestination(
+        icon: Icon(Icons.auto_awesome_outlined),
+        selectedIcon: Icon(Icons.auto_awesome),
+        label: 'Agent',
+      ),
+  ];
+
+  /// The live desktop card at the top of Home (phone UI only).
+  List<Widget> backstageHomePlayer() => [
+    if (!widget.desktopWindow) const BackstageLivePlayer(),
+  ];
+}
+
+/// Pure mapping of a point in the player (logical px) to desktop pixels, clamped to the desktop.
+Offset backstagePlayerToDesktop(
+  Offset local,
+  Size box,
+  int desktopWidth,
+  int desktopHeight,
+) {
+  if (box.width <= 0 || box.height <= 0) return Offset.zero;
+  final x = (local.dx / box.width * desktopWidth).clamp(
+    0.0,
+    desktopWidth - 1.0,
+  );
+  final y = (local.dy / box.height * desktopHeight).clamp(
+    0.0,
+    desktopHeight - 1.0,
+  );
+  return Offset(x.toDouble(), y.toDouble());
+}
+
+enum BackstagePreviewAction { none, show, restore }
+
+/// Automatic preview never steals MINI/FULL. The per-visit attempt latch lives in the widget.
+BackstagePreviewAction backstagePreviewAction(
+  String presentation,
+  bool visible,
+  bool autoSwitched,
+) {
+  if (visible && presentation == 'hidden' && !autoSwitched)
+    return BackstagePreviewAction.show;
+  if (!visible && presentation == 'in_app' && autoSwitched)
+    return BackstagePreviewAction.restore;
+  return BackstagePreviewAction.none;
+}
+
+class BackstageLivePlayer extends StatefulWidget {
+  const BackstageLivePlayer({super.key});
+
+  @override
+  State<BackstageLivePlayer> createState() => _BackstageLivePlayerState();
+}
+
+class _BackstageLivePlayerState extends State<BackstageLivePlayer>
+    with WidgetsBindingObserver {
+  static const _touchDown = 0;
+  static const _touchMove = 1;
+  static const _touchUp = 2;
+  static const _touchCancel = 3;
+
+  bool foreground = true;
+  bool attempted = false;
+  bool autoSwitched = false;
+  bool refreshing = false;
+  bool refreshAgain = false;
+  bool previewBusy = false;
+  bool get visible => foreground && BackstageShellBridge.homeVisible.value;
+
+  bool available = false;
+  bool running = false;
+  bool starting = false;
+  bool privileged = false;
+  String presentation = 'none';
+  int width = 0;
+  int height = 0;
+  int? textureId;
+  int? pointer;
+  StreamSubscription<void>? subscription;
+  Timer? poll;
+  Timer? startTimeout;
+
+  @override
+  void initState() {
+    super.initState();
+    foreground =
+        WidgetsBinding.instance.lifecycleState == null ||
+        WidgetsBinding.instance.lifecycleState == AppLifecycleState.resumed;
+    WidgetsBinding.instance.addObserver(this);
+    BackstageShellBridge.homeVisible.addListener(visibilityChanged);
+    subscription = BackstageShellBridge.changes.listen((_) => refresh());
+    poll = Timer.periodic(const Duration(seconds: 2), (_) => refresh());
+    refresh();
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    BackstageShellBridge.homeVisible.removeListener(visibilityChanged);
+    // Native verifies ownership and presentation again, including when a switch is still in flight.
+    BackstageShellBridge.invoke<bool>('previewRestore');
+    subscription?.cancel();
+    poll?.cancel();
+    startTimeout?.cancel();
+    if (textureId != null) BackstageShellBridge.invoke<bool>('playerDetach');
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    foreground = state == AppLifecycleState.resumed;
+    // Agent returns to the same Home state; native pause has already released the previous preview.
+    visibilityChanged();
+  }
+
+  void visibilityChanged() {
+    if (!visible) {
+      attempted = false;
+      BackstageShellBridge.invoke<bool>('previewRestore');
+      autoSwitched = false;
+      if (textureId != null) {
+        BackstageShellBridge.invoke<bool>('playerDetach');
+        textureId = null;
+      }
+    }
+    refresh();
+  }
+
+  Future<void> syncPreview() async {
+    final action = backstagePreviewAction(presentation, visible, autoSwitched);
+    if (previewBusy || action == BackstagePreviewAction.none) return;
+    if (action == BackstagePreviewAction.show && attempted) return;
+    previewBusy = true;
+    if (action == BackstagePreviewAction.show) {
+      attempted = true; // Failure gets a manual button, never another automatic attempt this visit.
+      final ok = await BackstageShellBridge.invoke<bool>('previewShow');
+      autoSwitched = ok == true;
+      if (mounted && ok == true) setState(() => presentation = 'in_app');
+      if (!mounted || !visible) {
+        await BackstageShellBridge.invoke<bool>('previewRestore');
+        autoSwitched = false;
+      }
+    } else {
+      await BackstageShellBridge.invoke<bool>('previewRestore');
+      autoSwitched = false;
+    }
+    if (mounted)
+      setState(() => previewBusy = false);
+    else
+      previewBusy = false;
+  }
+
+  Future<void> refresh() async {
+    if (refreshing) {
+      refreshAgain = true;
+      return;
+    }
+    refreshing = true;
+    try {
+      do {
+        refreshAgain = false;
+        await refreshState();
+      } while (mounted && refreshAgain);
+    } finally {
+      refreshing = false;
+    }
+  }
+
+  Future<void> refreshState() async {
+    final state = await BackstageShellBridge.invoke<Map<Object?, Object?>>(
+      'state',
+    );
+    if (!mounted) return;
+    if (state == null) {
+      if (available) setState(() => available = false);
+      return;
+    }
+    final nowRunning = state['running'] == true;
+    final nowWidth = (state['width'] as num?)?.toInt() ?? 0;
+    final nowHeight = (state['height'] as num?)?.toInt() ?? 0;
+    setState(() {
+      available = state['playerAllowed'] == true;
+      privileged = state['privileged'] == true;
+      running = nowRunning;
+      presentation = state['presentation'] as String? ?? 'none';
+      width = nowWidth;
+      height = nowHeight;
+      if (running) starting = false;
+    });
+    if (!available) return;
+    if (autoSwitched && presentation != 'in_app') autoSwitched = false;
+    if (running) await syncPreview();
+    if (!mounted || !visible) return;
+    if (running && (textureId == null || state['textureId'] == null)) {
+      final player = await BackstageShellBridge.invoke<Map<Object?, Object?>>(
+        'playerAttach',
+      );
+      if (!mounted) return;
+      setState(() => textureId = (player?['textureId'] as num?)?.toInt());
+    } else if (!running && textureId != null) {
+      await BackstageShellBridge.invoke<bool>('playerDetach');
+      if (!mounted) return;
+      setState(() => textureId = null);
+    }
+  }
+
+  Future<void> start() async {
+    setState(() => starting = true);
+    final accepted = await BackstageShellBridge.invoke<bool>('start');
+    if (!mounted) return;
+    if (accepted != true) setState(() => starting = false);
+    startTimeout?.cancel();
+    startTimeout = Timer(const Duration(seconds: 20), () {
+      if (mounted && starting) setState(() => starting = false);
+    });
+  }
+
+  Future<void> present(String target) async {
+    autoSwitched = false;
+    attempted = true;
+    await BackstageShellBridge.invoke<bool>('present', {
+      'presentation': target,
+    });
+    refresh();
+  }
+
+  void touch(int action, Offset local, Size box) {
+    final point = backstagePlayerToDesktop(local, box, width, height);
+    BackstageShellBridge.invoke<bool>('touch', {
+      'action': action,
+      'x': point.dx,
+      'y': point.dy,
+    });
+  }
+
+  Widget picture(ColorScheme colors) {
+    final inApp = presentation == 'in_app' && textureId != null;
+    final aspect = width > 0 && height > 0 ? width / height : 16 / 9;
+    return AspectRatio(
+      aspectRatio: aspect,
+      child: ClipRRect(
+        borderRadius: BorderRadius.circular(16),
+        child: ColoredBox(
+          color: Colors.black,
+          child: inApp
+              ? LayoutBuilder(
+                  builder: (context, constraints) {
+                    final box = constraints.biggest;
+                    return Listener(
+                      behavior: HitTestBehavior.opaque,
+                      onPointerDown: (e) {
+                        if (pointer != null) return;
+                        pointer = e.pointer;
+                        touch(_touchDown, e.localPosition, box);
+                      },
+                      onPointerMove: (e) {
+                        if (e.pointer == pointer)
+                          touch(_touchMove, e.localPosition, box);
+                      },
+                      onPointerUp: (e) {
+                        if (e.pointer != pointer) return;
+                        pointer = null;
+                        touch(_touchUp, e.localPosition, box);
+                      },
+                      onPointerCancel: (e) {
+                        if (e.pointer != pointer) return;
+                        pointer = null;
+                        touch(_touchCancel, e.localPosition, box);
+                      },
+                      child: Texture(textureId: textureId!),
+                    );
+                  },
+                )
+              : presentation == 'hidden' && (!attempted || previewBusy)
+              ? const Center(child: CircularProgressIndicator())
+              : Center(
+                  child: TextButton.icon(
+                    onPressed: () => present('in_app'),
+                    icon: const Icon(Icons.play_circle_outline),
+                    label: Text(switch (presentation) {
+                      'mini' => 'Playing in the popup. Show it here',
+                      'hidden' => 'Running in the background. Show it here',
+                      'full' => 'Showing full screen. Show it here',
+                      _ => 'Show the desktop here',
+                    }),
+                  ),
+                ),
+        ),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!available) return const SizedBox.shrink();
+    final colors = Theme.of(context).colorScheme;
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 16),
+      child: Card(
+        key: const ValueKey('backstage-live-player'),
+        elevation: 0,
+        color: colors.surfaceContainerHigh,
+        child: Padding(
+          padding: const EdgeInsets.all(12),
+          child: running
+              ? Column(
+                  crossAxisAlignment: CrossAxisAlignment.stretch,
+                  children: [
+                    picture(colors),
+                    const SizedBox(height: 8),
+                    Wrap(
+                      alignment: WrapAlignment.center,
+                      spacing: 4,
+                      children: [
+                        TextButton.icon(
+                          onPressed: () => present('full'),
+                          icon: const Icon(Icons.fullscreen),
+                          label: const Text('Full screen'),
+                        ),
+                        TextButton.icon(
+                          onPressed: () => present('mini'),
+                          icon: const Icon(
+                            Icons.picture_in_picture_alt_outlined,
+                          ),
+                          label: const Text('Pop out'),
+                        ),
+                        TextButton.icon(
+                          onPressed: () => present('hidden'),
+                          icon: const Icon(Icons.headphones_outlined),
+                          label: const Text('Background'),
+                        ),
+                        TextButton.icon(
+                          onPressed: () async {
+                            await BackstageShellBridge.invoke<bool>('stop');
+                            refresh();
+                          },
+                          icon: const Icon(Icons.stop_circle_outlined),
+                          label: const Text('Stop'),
+                        ),
+                      ],
+                    ),
+                  ],
+                )
+              : Row(
+                  children: [
+                    Icon(Icons.desktop_windows_outlined, color: colors.primary),
+                    const SizedBox(width: 12),
+                    Expanded(
+                      child: Text(
+                        privileged
+                            ? 'The desktop is not running.'
+                            : 'Finish the setup below to start the desktop.',
+                      ),
+                    ),
+                    FilledButton.icon(
+                      key: const ValueKey('backstage-start-desktop'),
+                      onPressed: starting || !privileged ? null : start,
+                      icon: starting
+                          ? const SizedBox(
+                              width: 18,
+                              height: 18,
+                              child: CircularProgressIndicator(strokeWidth: 2),
+                            )
+                          : const Icon(Icons.play_arrow_rounded),
+                      label: const Text('Start desktop'),
+                    ),
+                  ],
+                ),
+        ),
+      ),
+    );
+  }
+}

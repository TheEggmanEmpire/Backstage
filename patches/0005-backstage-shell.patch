--- /dev/null
+++ b/android/app/src/main/kotlin/moe/n4tsu/dextop/BackstageShellHooks.kt
@@ -0,0 +1,17 @@
+package moe.n4tsu.dextop
+
+import android.app.Activity
+import android.content.Intent
+import io.flutter.embedding.engine.FlutterEngine
+
+/**
+ * Backstage (patch 0006-backstage-shell): where the Backstage glue meets the Flutter engine of Dextop's own activities
+ * (MainActivity and its desktop-window subclass). The glue registers its shell channel and the live desktop player's
+ * texture there; [onEngineCleanup] runs before the engine (and every texture it owns) is destroyed. Inert (null) in
+ * upstream builds.
+ */
+object BackstageShellHooks {
+    @Volatile @JvmStatic var onIntent: ((Activity, Intent) -> Unit)? = null
+    @Volatile @JvmStatic var onEngine: ((Activity, FlutterEngine) -> Unit)? = null
+    @Volatile @JvmStatic var onEngineCleanup: ((Activity, FlutterEngine) -> Unit)? = null
+}
diff --git a/android/app/src/main/kotlin/moe/n4tsu/dextop/MainActivity.kt b/android/app/src/main/kotlin/moe/n4tsu/dextop/MainActivity.kt
index c367d3580ee6e46fe354f4a6ff30783daabe4619..06ac314cfb79d535ef9afcd09c7eaa86f745a01c 100644
--- a/android/app/src/main/kotlin/moe/n4tsu/dextop/MainActivity.kt
+++ b/android/app/src/main/kotlin/moe/n4tsu/dextop/MainActivity.kt
@@ -162,6 +162,7 @@ open class MainActivity : FlutterActivity() {
     override fun onCreate(savedInstanceState: Bundle?) {
         applyDefaultWindowManager()
         super.onCreate(savedInstanceState)
+        BackstageShellHooks.onIntent?.invoke(this, intent)
         // Flutter draws its own focus indicators. Android's legacy theme otherwise
         // outlines the focused, full-screen FlutterView in yellow-green.
         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
@@ -277,6 +278,7 @@ open class MainActivity : FlutterActivity() {
     override fun onNewIntent(intent: Intent) {
         super.onNewIntent(intent)
         setIntent(intent)
+        BackstageShellHooks.onIntent?.invoke(this, intent)
         if (DextopShortcuts.isStartDisplayAction(intent.action)) {
             // A shortcut tapped while the app is already in the foreground gets
             // no lifecycle callback, so forward the action to Flutter directly.
@@ -296,6 +298,7 @@ open class MainActivity : FlutterActivity() {
 
     override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
         super.configureFlutterEngine(flutterEngine)
+        BackstageShellHooks.onEngine?.invoke(this, flutterEngine)
         updatePrivilegeRuntimePolicy()
         Shizuku.addRequestPermissionResultListener(permissionListener)
         Shizuku.addBinderReceivedListenerSticky(binderReceivedListener)
@@ -702,6 +705,7 @@ open class MainActivity : FlutterActivity() {
     }
 
     override fun cleanUpFlutterEngine(flutterEngine: FlutterEngine) {
+        BackstageShellHooks.onEngineCleanup?.invoke(this, flutterEngine)
         Shizuku.removeRequestPermissionResultListener(permissionListener)
         Shizuku.removeBinderReceivedListener(binderReceivedListener)
         Shizuku.removeBinderDeadListener(binderDeadListener)

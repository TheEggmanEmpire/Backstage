<?xml version="1.0" encoding="utf-8"?>
<!-- window theme for the Backstage agent activities (no AppCompat dependency). -->
<resources>
    <style name="Theme.Backstage.Agent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The desktop popup's chat panel (MiniChatActivity): translucent, the phone's current app stays visible behind it. -->
    <style name="Theme.Backstage.MiniChat" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

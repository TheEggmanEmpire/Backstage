<?xml version="1.0" encoding="utf-8"?>
<!-- The Backstage icon ("Layer Peek": the phone in front, the desktop running behind it). Original artwork from
     gen_icon.py geometry; layers are 108 dp vectors, the monochrome layer is the themed-icon glyph. Legacy PNGs in
     mipmap-*dpi carry the same art for tools that cannot render adaptive icons (e.g. the.apk file icon on a PC). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/bs_ic_launcher_bg" />
    <foreground android:drawable="@drawable/bs_ic_launcher_fg" />
    <monochrome android:drawable="@drawable/bs_ic_launcher_mono" />
</adaptive-icon>
